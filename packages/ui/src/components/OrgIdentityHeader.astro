---
// An organization's visual identity, Facebook-style: a wide banner backdrop
// with the circular logo overlapping its bottom edge and the org name beside
// it (specs/concepts/join-page.md). This is THE one presentation of an
// organization: the public join page and the receipt show it to supporters,
// and the back office opens every one of its screens with the very same
// component, so an administrator sees their organization exactly as a
// supporter does without ever opening the public page. Sharing it is what
// makes that true, not an approximation.
//
// The banner stays bounded in height so the page's real content is never
// pushed far down. Either image is simply omitted when the org has none: the
// logo alone sits beside the name, and a name alone stands by itself.
//
// The public pages show the same identity as a STAGE: the banner edge to edge
// with a dark fade at its foot, where the logo and the name stand in white.
// The fade is what lets any photo carry white text. The stage is sized from
// the screen (a near-square on a tall phone, a band on a short or wide one)
// and the page below rises over its foot (PublicShell, --sm-stage-lift). The
// back office keeps the compact row above its work.
interface Props {
  name: string;
  logoUrl?: string | null;
  bannerUrl?: string | null;
  /**
   * Which part of the banner survives the crop to the wide backdrop, as
   * percentages (0-100) chosen by the organization; centered when unset.
   */
  bannerFocus?: { x: number; y: number } | null;
  /**
   * What the name is, structurally. On the public pages it is an identity
   * mark (a paragraph: the page's own headline comes below). In the back
   * office the organization IS the page's subject, so the chrome renders it
   * as the one h1 and the screens inside start at level 2.
   */
  as?: "p" | "h1";
  /** Where the name and logo lead when pressed; nowhere by default. */
  href?: string;
  /**
   * `row` is the compact header (back office). `stage` is the public pages'
   * full-width banner; it needs a banner or a logo, and with no banner the
   * stage is a plain dark ground for the logo.
   */
  layout?: "row" | "stage";
}

const {
  name,
  logoUrl = null,
  bannerUrl = null,
  bannerFocus = null,
  as: Name = "p",
  href,
  layout = "row",
} = Astro.props;
const stage = layout === "stage";
const bannerPosition = `${bannerFocus?.x ?? 50}% ${bannerFocus?.y ?? 50}%`;
---

<header class:list={["identity", { "has-banner": bannerUrl, stage }]}>
  {bannerUrl && (
    <img class="banner" src={bannerUrl} alt="" style={`object-position: ${bannerPosition}`} />
  )}
  {stage && <div class="fade" aria-hidden="true" />}
  {
    href ? (
      <a class="head linked" href={href}>
        {logoUrl && <img class="logo" src={logoUrl} alt="" />}
        <Name class="org-name">{name}</Name>
      </a>
    ) : (
      <div class="head">
        {logoUrl && <img class="logo" src={logoUrl} alt="" />}
        <Name class="org-name">{name}</Name>
      </div>
    )
  }
</header>

<style>
  .identity {
    margin-bottom: 0.5rem;
  }
  .banner {
    display: block;
    width: 100%;
    /* A wide backdrop, not a hero: bounded so the offer stays near the top. */
    aspect-ratio: 12 / 5;
    min-height: 7.5rem;
    max-height: 15rem;
    object-fit: cover;
    border-radius: var(--sm-radius-lg);
  }
  .head {
    display: flex;
    align-items: flex-end;
    gap: 1.1rem;
  }
  /* Linked, the row still reads as the identity mark, not as a link: the name
     underlines on hover, and the ring shows where the keyboard is. */
  .linked {
    color: inherit;
    text-decoration: none;
    border-radius: var(--sm-radius-sm);
  }
  .linked:hover .org-name {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .linked:focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px var(--sm-focus-ring);
  }
  /* The org name is the identity mark beside the logo, not the page headline:
     the h1 is the page's own invitation or confirmation below. Styled like a
     display heading so the identity header keeps its weight. */
  .org-name {
    margin: 0;
    font-family: var(--sm-font-display);
    font-weight: var(--sm-font-display-weight, 600);
    font-variation-settings: var(--sm-font-display-variation, normal);
    letter-spacing: -0.01em;
    line-height: 1.2;
    font-size: 1.75rem;
    /* Long single-word org names can't wrap at spaces; allow shrinking below
       content width with mid-word wrapping as the extreme backstop. */
    min-width: 0;
    overflow-wrap: anywhere;
  }
  /* On narrow screens the whole identity row scales down so a typical
     compound org name still fits on one line beside the logo. */
  @media (max-width: 480px) {
    .logo {
      width: 4.5rem;
      height: 4.5rem;
      padding: 0.35rem;
    }
    .has-banner .logo {
      margin-top: -2.25rem;
    }
    .org-name {
      font-size: 1.3rem;
    }
  }
  /* Logos are always framed in a circle with a subtle outline, so mixed logo
     shapes still read as one consistent identity mark. */
  .logo {
    display: block;
    flex-shrink: 0;
    width: 6.5rem;
    height: 6.5rem;
    object-fit: contain;
    padding: 0.5rem;
    background: var(--sm-surface);
    border-radius: 50%;
    box-shadow:
      0 0 0 1px var(--sm-border),
      var(--sm-shadow-card);
  }
  /* With a banner, the circle overlaps its bottom edge (Facebook-style) with
     the name sitting beside it below the banner. */
  .has-banner .logo {
    margin-top: -3.25rem;
    margin-left: 1rem;
  }

  /* The stage. Its height follows the screen: 85% of the width, at most 40%
     of the height, within 220-460px, so a phone opens on a near-square photo
     and still shows the offer, and a wide screen gets a band. svh where the
     browser knows it: the height with the browser's own bars showing. */
  .identity.stage {
    position: relative;
    margin: 0;
    overflow: hidden;
    height: clamp(13.75rem, min(85vw, 40vh), 28.75rem);
    height: clamp(13.75rem, min(85vw, 40svh), 28.75rem);
    background:
      radial-gradient(
        110% 80% at 25% 10%,
        color-mix(in oklch, var(--sm-ink) 80%, white) 0,
        transparent 65%
      ),
      var(--sm-ink);
  }
  .stage .banner {
    position: absolute;
    inset: 0;
    height: 100%;
    aspect-ratio: auto;
    min-height: 0;
    max-height: none;
    border-radius: 0;
  }
  .stage .fade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgb(10 8 6 / 0) 28%,
      rgb(10 8 6 / 0.35) 58%,
      rgb(10 8 6 / 0.84) 100%
    );
  }
  /* The name row lines up with the reading column below it. */
  .stage .head {
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(var(--sm-stage-lift, 1.75rem) + 1.125rem);
    max-width: 38rem;
    margin-inline: auto;
    padding-inline: 1.25rem;
    align-items: center;
    gap: clamp(0.75rem, 1.4vw, 1.25rem);
  }
  .stage .logo {
    width: clamp(4rem, 7vw, 6.5rem);
    height: clamp(4rem, 7vw, 6.5rem);
    padding: clamp(0.3rem, 0.5vw, 0.5rem);
    margin: 0;
    box-shadow:
      0 0 0 1px var(--sm-border),
      0 6px 18px -6px rgb(0 0 0 / 0.55);
  }
  .stage .org-name {
    color: #fff;
    font-size: clamp(1.3rem, 2.4vw + 0.75rem, 2.25rem);
    line-height: 1.12;
    text-shadow: 0 1px 14px rgb(0 0 0 / 0.45);
  }
  .stage .linked:focus-visible {
    box-shadow: 0 0 0 3px #fff;
  }
</style>
