---
// Prominent inline message. Add variants (e.g. success) here rather than
// styling ad-hoc boxes in screens.
interface Props {
  variant?: "error" | "info" | "success";
}
const { variant = "error" } = Astro.props;
---

<p class:list={["alert", variant]} role="alert">
  <slot />
</p>

<style>
  .alert {
    margin: 0;
    padding: 0.65rem 0.85rem;
    font-size: 0.9rem;
    border-radius: var(--sm-radius-md);
  }
  .error {
    color: var(--sm-danger);
    background: var(--sm-danger-bg);
    border: 1px solid var(--sm-danger-border);
  }
  /* A neutral notice: something to know or to put right. Ink on the cream
     ground, so it is neither the green of "went right" nor the red of an
     error (specs/concepts/brand-palette.md). */
  .info {
    color: var(--sm-ink);
    background: var(--sm-bg);
    border: 1px solid var(--sm-border-strong);
  }
  .success {
    color: var(--sm-success);
    background: var(--sm-success-bg);
    border: 1px solid var(--sm-success-border);
  }
</style>
