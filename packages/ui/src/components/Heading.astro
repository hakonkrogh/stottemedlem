---
// Display heading in the brand serif (Fraunces), same as marketing headings.
// `level` sets the semantic element; the visual size follows it.
interface Props {
  level?: 1 | 2 | 3;
}
const { level = 1 } = Astro.props;
const Tag = `h${level}` as "h1" | "h2" | "h3";
---

<Tag class="heading">
  <slot />
</Tag>

<style>
  .heading {
    margin: 0;
    font-family: var(--sm-font-display);
    font-weight: var(--sm-font-display-weight, 600);
    font-variation-settings: var(--sm-font-display-variation, normal);
    letter-spacing: -0.01em;
    line-height: 1.2;
  }
  h1 {
    font-size: 1.75rem;
  }
  h2 {
    font-size: 1.35rem;
  }
  h3 {
    font-size: 1.1rem;
  }
</style>
