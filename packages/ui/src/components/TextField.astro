---
// Labeled single-line text input with optional inline error. Owns the
// label/input/error wiring (ids, aria) so screens never hand-roll it.
// An optional `action` slot puts a control (typically a button) on the same
// line as the input, vertically centered on the input itself — never on the
// label or the error text.
interface Props {
  label: string;
  name: string;
  /** Steers the on-screen keyboard on a phone; the field is text either way. */
  type?: "text" | "email" | "tel" | "search";
  id?: string;
  value?: string;
  placeholder?: string;
  required?: boolean;
  autofocus?: boolean;
  error?: string | null;
}
const {
  label,
  name,
  type = "text",
  id = name,
  value,
  placeholder,
  required,
  autofocus,
  error,
} = Astro.props;
const errorId = `${id}-error`;
---

<div class="field">
  <label for={id}>{label}</label>
  <div class="control">
    <input
      type={type}
      id={id}
      name={name}
      value={value}
      placeholder={placeholder}
      required={required}
      autofocus={autofocus}
      aria-invalid={error ? "true" : undefined}
      aria-describedby={error ? errorId : undefined}
    />
    <slot name="action" />
  </div>
  {error && <p class="error" id={errorId}>{error}</p>}
</div>

<style>
  .field {
    display: grid;
    gap: 0.4rem;
  }
  label {
    font-size: 0.9rem;
    font-weight: 600;
  }
  .control {
    display: flex;
    align-items: center;
    gap: var(--sm-space-sm);
  }
  .control input {
    flex: 1;
    min-width: 0;
  }
  input {
    width: 100%;
    padding: 0.65rem 0.8rem;
    font: inherit;
    color: var(--sm-ink);
    background: var(--sm-surface);
    border: 1px solid var(--sm-border-strong);
    border-radius: var(--sm-radius-md);
    transition: border-color 120ms ease;
  }
  input::placeholder {
    color: color-mix(in srgb, var(--sm-muted) 60%, transparent);
  }
  input:focus-visible {
    outline: none;
    border-color: var(--sm-accent);
    box-shadow: 0 0 0 3px var(--sm-focus-ring);
  }
  input[aria-invalid="true"] {
    border-color: var(--sm-danger);
  }
  .error {
    margin: 0;
    font-size: 0.85rem;
    color: var(--sm-danger);
  }
</style>
