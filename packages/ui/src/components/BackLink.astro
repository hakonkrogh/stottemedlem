---
// The way back out of a subpage: an arrow and the name of the place it returns
// to. Quiet by design — it is a way out, never a call to action — but always
// the same shape, so it is recognized before it is read.
interface Props {
  href: string;
}
const { href } = Astro.props;
---

<a class="back" href={href}>
  <svg
    class="arrow"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M19 12H5"></path>
    <path d="m11 18-6-6 6-6"></path>
  </svg>
  <span><slot /></span>
</a>

<style>
  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    align-self: start;
    justify-self: start;
    font-size: 0.85rem;
    color: var(--sm-muted);
    text-decoration: none;
    border-radius: var(--sm-radius-sm);
  }
  .back:hover {
    color: var(--sm-ink);
  }
  .back:hover span {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .back:focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px var(--sm-focus-ring);
  }
  .arrow {
    width: 1rem;
    height: 1rem;
    flex: none;
  }
</style>
