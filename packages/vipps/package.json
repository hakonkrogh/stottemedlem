{
  "name": "@stottemedlem/vipps",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "recurring-test": "tsc && node scripts/recurring-test.mjs",
    "tunnel": "bash scripts/tunnel.sh"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "qrcode": "^1.5.4",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
