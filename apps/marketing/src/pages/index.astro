---
// Landing page. Messaging (see specs/): register over støttemedlemmer +
// innkreving av årskontingent som kjerne, kontakt med medlemmene, Vipps som
// betalingsleverandør med enkel inn-/utmelding.
import "@fontsource-variable/fraunces";
import { CANONICAL_ORIGIN } from "@stottemedlem/core";
import { qrCardSvg } from "@stottemedlem/qr";
import HeroBackdrop from "../components/HeroBackdrop.astro";

// A static QR-card preview so prospective organizations see what they get
// before signing up (see specs/use-cases/promote-with-qr-card.md). Generated at
// build time — the card is a self-contained SVG, no client JS. In this demo the
// QR points back at this page; a real organization's card points at its own
// join page.
const previewCardSvg = qrCardSvg({
  joinUrl: CANONICAL_ORIGIN,
  organizationName: "Eksempel Musikkorps",
});
---

<html lang="no">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>støttemedlem — register og årskontingent for støttemedlemmer</title>
    <meta
      name="description"
      content="Register over støttemedlemmene dine og innkreving av årskontingent med Vipps — for korps, kor, lag og foreninger."
    />
  </head>
  <body>
    <HeroBackdrop>
      <header>
        <p class="eyebrow">Kommer snart</p>
        <h1><span class="brand-heart" aria-hidden="true">❤️</span> støttemedlem.no</h1>
        <p class="tagline">Register og årskontingent for støttemedlemmer — med Vipps.</p>
        <p class="intro">
          For korps, kor, lag og foreninger som vil la folk i lokalmiljøet støtte dem — år
          etter år.
        </p>
        <p class="hero-cta"><a href="#innhold">Se hvordan det virker</a></p>
      </header>
      <main id="innhold">
      <section>
        <h2>Ett register over støttemedlemmene</h2>
        <p>
          Full oversikt over hvem som støtter dere: hvem som er aktive, hvem som har betalt, og
          historikken år for år. Registeret oppdaterer seg selv når noen melder seg inn eller
          fornyer.
        </p>
      </section>
      <section>
        <h2>Årskontingent — betalt med Vipps</h2>
        <p>
          Innkrevingen er ikke et valgfritt tillegg, den er kjernen: støttemedlemmene betaler en
          årlig kontingent med Vipps, og betalingen fornyer seg som fast avtale.
        </p>
      </section>
      <section>
        <h2>Hold kontakten med støttespillerne</h2>
        <p>
          Takk medlemmene for støtten, send oppdateringer om det som skjer i organisasjonen, og
          hold dem involvert. De som støtter dere, vil gjerne høre fra dere.
        </p>
      </section>
      <section>
        <h2>Enkelt inn — enkelt ut</h2>
        <p>
          Med Vipps som betalingsleverandør kan medlemmene enkelt melde seg ut når de ikke
          lenger vil være med, og organisasjonen administrerer de faste betalingene uten ekstra
          styr.
        </p>
      </section>
      <section class="perks">
        <h2>Medlemmene får noe å samle på — og vise fram</h2>
        <p class="hearts" aria-hidden="true">❤️ ❤️ ❤️ ❤️ ❤️ ❤️ ❤️ ❤️</p>
        <div class="perk-grid">
          <div>
            <h3>Ett hjerte for hvert år</h3>
            <p>
              Hvert år som støttemedlem gir et nytt hjerte. Åtte års støtte er åtte hjerter —
              lojalitet som synes, år for år.
            </p>
          </div>
          <div>
            <h3>Støttebevis med QR-kode</h3>
            <p>
              Medlemmet kan skrive ut et bevis på støtten sin, med hjertene og en personlig
              QR-kode. Den som skanner koden, melder seg inn — og vervingen krediteres
              medlemmet.
            </p>
          </div>
          <div>
            <h3>Vervetelleren</h3>
            <p>
              Medlemmene ser hvor mange nye støttemedlemmer de selv har vervet. Poeng for år,
              poeng for verving — litt vennskapelig konkurranse har aldri skadet et korps.
            </p>
          </div>
        </div>
        <p class="perks-pitch">
          Medlemmer som blir sett, blir værende — og verver flere. Det er gevinsten for
          organisasjonen.
        </p>
      </section>
      <section class="qr-showcase">
        <div class="qr-copy">
          <h2>Et ferdig QR-kort som verver for dere</h2>
          <p>
            Hver organisasjon får sitt eget QR-kort — klart til å henge på veggen, legge i
            konsertprogrammet eller dele på nett. Publikum skanner koden med mobilen og blir
            støttemedlemmer på stedet, betalt med Vipps.
          </p>
          <p class="qr-note">
            Slik ser kortet ut. Skann gjerne koden — her fører den tilbake hit; for dere peker
            den rett til deres egen innmelding.
          </p>
        </div>
        <figure class="qr-card" set:html={previewCardSvg} aria-label="Eksempel på et QR-kort"></figure>
      </section>
      </main>
      <footer>
        <p class="cta">Kommer snart.</p>
        <p class="contact">
          {/* mailto uses the IDNA/punycode domain — ø in the raw address breaks
              some email clients; "stttemedlem" (three t's) is correct. */}
          Spørsmål? Skriv til <a href="mailto:hei@xn--stttemedlem-hgb.no">hei@støttemedlem.no</a>
        </p>
      </footer>
    </HeroBackdrop>
  </body>
</html>

<style>
  html {
    scroll-behavior: smooth;
  }
  body {
    margin: 0;
    min-height: 100vh;
    font-family:
      system-ui,
      -apple-system,
      sans-serif;
    background: #1a140c;
    color: #1f1a14;
    line-height: 1.6;
  }
  main,
  footer {
    max-width: 44rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  header {
    max-width: 44rem;
    margin: 0 auto;
    padding: 7rem 1.5rem 5.5rem;
    text-align: center;
    color: #fff;
    text-shadow: 0 1px 12px rgb(0 0 0 / 0.35);
  }
  .eyebrow {
    display: inline-block;
    margin: 0 0 1.75rem;
    padding: 0.4rem 1.1rem;
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #f3efe6;
    background: rgb(24 18 10 / 0.55);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border: 1px solid rgb(243 239 230 / 0.35);
    border-radius: 999px;
    text-shadow: none;
  }
  .hero-cta {
    margin: 2.25rem 0 0;
  }
  .hero-cta a {
    display: inline-block;
    padding: 0.85rem 1.9rem;
    background: #3d6b3f;
    color: #ffffff;
    font-weight: 680;
    text-decoration: none;
    border-radius: 999px;
    text-shadow: none;
    box-shadow: 0 6px 20px rgb(0 0 0 / 0.35);
    transition:
      transform 0.15s ease,
      background 0.15s ease;
  }
  .hero-cta a:hover {
    background: #2f5632;
    transform: translateY(-2px);
  }
  h1,
  h2,
  h3 {
    font-family: "Fraunces Variable", Georgia, serif;
    font-variation-settings: "SOFT" 50;
    letter-spacing: -0.01em;
  }
  h1 {
    font-size: clamp(3.25rem, 7vw, 4.75rem);
    font-weight: 620;
    line-height: 1.05;
    text-wrap: balance;
    margin: 0 0 1rem;
  }
  /* The heart is the brand mark; slightly smaller than the wordmark so the
     domain name stays the headline. */
  .brand-heart {
    font-size: 0.72em;
    vertical-align: 0.06em;
  }
  /* The domain-name headline is one unbreakable word — below 40rem the
     3.25rem floor no longer fits, so track the viewport instead. */
  @media (max-width: 40rem) {
    h1 {
      font-size: clamp(1.9rem, 9vw, 3.25rem);
    }
  }
  .tagline {
    font-size: clamp(1.2rem, 2.2vw, 1.45rem);
    font-weight: 600;
    text-wrap: balance;
    max-width: 36rem;
    margin: 0 auto 0.75rem;
  }
  .intro {
    margin: 0 auto;
    max-width: 32rem;
    color: rgb(255 255 255 / 0.82);
  }
  main {
    display: grid;
    gap: 2.5rem;
    padding-top: 3rem;
    padding-bottom: 3rem;
    counter-reset: card;
  }
  @media (min-width: 40rem) {
    main {
      grid-template-columns: 1fr 1fr;
    }
  }
  section {
    /* Cards carry their own light backdrop — text goes back to dark. */
    color: #1f1a14;
    background: rgb(250 247 242 / 0.86);
    -webkit-backdrop-filter: blur(14px) saturate(1.1);
    backdrop-filter: blur(14px) saturate(1.1);
    border: 1px solid rgb(255 255 255 / 0.45);
    border-radius: 1rem;
    padding: 2rem;
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.22);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }
  section:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 40px rgb(0 0 0 / 0.28);
  }
  section:not(.perks):not(.qr-showcase) {
    counter-increment: card;
  }
  section:not(.perks):not(.qr-showcase) h2::before {
    content: "0" counter(card);
    display: block;
    font-size: 0.85rem;
    font-weight: 550;
    letter-spacing: 0.22em;
    color: #3d6b3f;
    margin-bottom: 0.85rem;
  }
  /* No backdrop-filter → translucent tint alone is too weak; go solid. */
  @supports not (backdrop-filter: blur(1px)) {
    section {
      background: #faf7f2;
    }
  }
  h2 {
    font-size: 1.35rem;
    font-weight: 600;
    text-wrap: balance;
    margin: 0 0 0.65rem;
  }
  section p {
    margin: 0;
    color: #4c4338;
  }
  .perks {
    grid-column: 1 / -1;
    background: rgb(243 246 239 / 0.82);
    border-color: rgb(207 220 201 / 0.5);
    text-align: center;
    padding: 3rem 2rem;
  }
  @supports not (backdrop-filter: blur(1px)) {
    .perks {
      background: #f3f6ef;
    }
  }
  .hearts {
    font-size: 1.3rem;
    letter-spacing: 0.2rem;
    margin: 0.25rem 0 1.25rem;
  }
  @media (max-width: 40rem) {
    /* Keep all eight hearts on one line on phones. */
    .hearts {
      font-size: 0.95rem;
      letter-spacing: 0.1rem;
    }
    section {
      padding: 1.5rem;
    }
    .perks {
      padding: 2.5rem 1.5rem;
    }
  }
  .perk-grid {
    display: grid;
    gap: 2rem;
    text-align: left;
  }
  @media (min-width: 40rem) {
    .perk-grid {
      grid-template-columns: 1fr 1fr 1fr;
    }
  }
  h3 {
    font-size: 1.1rem;
    font-weight: 600;
    margin: 0 0 0.35rem;
  }
  .perks-pitch {
    margin-top: 1.5rem;
    font-weight: 600;
    color: #1f1a14;
  }
  .qr-showcase {
    grid-column: 1 / -1;
    display: grid;
    gap: 2.5rem;
    align-items: center;
    padding: 3rem 2rem;
  }
  @media (min-width: 40rem) {
    .qr-showcase {
      grid-template-columns: 1.05fr 0.95fr;
    }
  }
  .qr-copy h2 {
    margin-bottom: 0.85rem;
  }
  .qr-note {
    margin-top: 1rem;
    font-size: 0.95rem;
    color: #6e6353;
  }
  .qr-card {
    margin: 0;
    text-align: center;
  }
  .qr-card :global(svg) {
    width: 100%;
    max-width: 19rem;
    height: auto;
    border-radius: 20px;
    filter: drop-shadow(0 14px 34px rgb(0 0 0 / 0.3));
  }
  @media (max-width: 40rem) {
    .qr-showcase {
      padding: 2rem 1.5rem;
    }
  }
  footer {
    padding-bottom: 3rem;
    text-align: center;
  }
  .cta {
    display: inline-block;
    font-weight: 600;
    color: #f3efe6;
    padding: 0.5rem 1.25rem;
    border-radius: 999px;
    background: rgb(24 18 10 / 0.55);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border: 1px solid rgb(255 255 255 / 0.18);
  }
  .contact {
    margin: 1.25rem 0 0;
    color: rgb(255 255 255 / 0.75);
    text-shadow: 0 1px 8px rgb(0 0 0 / 0.35);
  }
  .contact a {
    color: #f3efe6;
    font-weight: 600;
  }
</style>
