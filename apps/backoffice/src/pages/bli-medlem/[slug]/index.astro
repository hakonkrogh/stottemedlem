---
import {
  formatOrganisasjonsnummer,
  JOIN_REFERRAL_PARAM,
  joinPageTermsPath,
  periodLabel,
} from "@stottemedlem/core";
import { getOrganizationBySlug, listMembershipTiers } from "@stottemedlem/db";
import Alert from "@stottemedlem/ui/components/Alert.astro";
import Button from "@stottemedlem/ui/components/Button.astro";
import Heading from "@stottemedlem/ui/components/Heading.astro";
import Stack from "@stottemedlem/ui/components/Stack.astro";
import Text from "@stottemedlem/ui/components/Text.astro";
import TextLink from "@stottemedlem/ui/components/TextLink.astro";
import MembershipTierCard from "../../../components/MembershipTierCard.astro";
import OrgIdentityHeader from "../../../components/OrgIdentityHeader.astro";
import PublicShell from "../../../layouts/PublicShell.astro";
import { getDb } from "../../../lib/db";
import { periods } from "../../../lib/periods";

// PUBLIC join page (specs/concepts/join-page.md): the page an
// admin registers as the organization's website in the Vipps portal, so it
// must show org name, org.nr, contact info, and the membership offer with its
// price — and link the salgsvilkår. It is also the org's shareable home for
// prospective supporters; the CTA hands off to the join page.
const slug = Astro.params.slug;
const db = getDb();
const org = slug ? await getOrganizationBySlug(db, slug) : null;
if (!org) return new Response("Fant ikke organisasjonen", { status: 404 });
// The organization's membership offer: its active tiers, cheapest first
// (specs/concepts/membership-tier.md). Every organization states its first
// membership at creation, so there is always at least one tier to show —
// zero happens only for organizations predating tiers, which the back office
// prompts to fix.
const tiers = await listMembershipTiers(db, org.id);

// What joining costs today: the rest of the current period, pro-rated
// (specs/concepts/annual-period.md). The page states both numbers, so nobody
// is surprised by either the amount now or the full fee at renewal.
const period = periods.periodFor();
const priceToday = new Map(
  tiers.map((tier) => [tier.id, periods.proratedJoinFeeNok(tier.annualFeeNok, new Date())]),
);

const title = `${org.name} — bli støttemedlem`;
const description = `Bli støttemedlem i ${org.name} og støtt arbeidet med et fast årlig bidrag.`;

// The hero copy invites the visitor to become a supporting member and explains
// the offer in plain words: with one tier it describes that membership and its
// fee, with several it says the visitor chooses between them, and it never
// enumerates options that don't exist. It always restates the product's
// promise: an annual membership that renews year by year, puts you on the
// org's member list, and makes your support count.
const singleTier = tiers.length === 1 ? tiers[0] : undefined;
const feePhrase = singleTier
  ? `en fast årlig kontingent på ${singleTier.annualFeeNok} kr`
  : "en fast årlig kontingent";
const subheadIntro =
  tiers.length > 1
    ? `Dette er støttemedlemssiden til ${org.name}. Her tegner du et støttemedlemskap — velg mellom ${tiers.length} typer medlemskap, hvert med en fast årlig kontingent som går direkte til arbeidet i organisasjonen.`
    : `Dette er støttemedlemssiden til ${org.name}. Her tegner du et støttemedlemskap — ${feePhrase} som går direkte til arbeidet i organisasjonen.`;
const subheadPromise =
  "Medlemskapet fornyes år for år så lenge du vil være med: du står på organisasjonens liste over støttemedlemmer, hører fra dem gjennom året, og støtten din teller for hvert år som går.";

// Set when the join attempt bounced back here (see start.ts). Query strings are
// not part of the page's cache key, so this never gets cached onto anyone else.
const joinError = Astro.url.searchParams.get("feil");
// Someone arrived by scanning a member's card (specs/concepts/member-card.md).
// The referral rides along into the payment so a completed join can be
// credited back to them; an address with a query string is never cached, so
// this is safe to render per visitor.
const referral = Astro.url.searchParams.get(JOIN_REFERRAL_PARAM)?.trim() || null;
---

<PublicShell title={title} description={description}>
  <Stack gap="xl">
    <Stack gap="md">
      <OrgIdentityHeader org={org} />
      {
        joinError && (
          <Alert variant="error">
            {joinError === "ikke-klar"
              ? `${org.name} har ikke fullført oppsettet for betaling ennå. Prøv igjen senere.`
              : joinError === "ukjent-medlemskap"
                ? "Medlemskapet du valgte finnes ikke lenger. Velg et av medlemskapene under."
                : "Vi fikk ikke kontakt med Vipps akkurat nå. Prøv igjen om litt."}
          </Alert>
        )
      }
      <Stack gap="sm">
        <Heading>Bli støttemedlem</Heading>
        <Text variant="lead">{subheadIntro}</Text>
        <Text variant="lead">{subheadPromise}</Text>
      </Stack>
    </Stack>

    {
      tiers.map((tier) => (
        <MembershipTierCard
          name={tier.name}
          annualFeeNok={tier.annualFeeNok}
          description={tier.description}
        >
          {
            priceToday.get(tier.id) !== tier.annualFeeNok && (
              <Text variant="small">
                Du betaler {priceToday.get(tier.id)} kr nå for resten av {periodLabel(period.year)}, deretter{" "}
                {tier.annualFeeNok} kr i året.
              </Text>
            )
          }
          {/* A POST, because choosing a membership creates an agreement with
              Vipps — and because this page is cached, so it can hold no state
              of its own. */}
          <form method="post" action={`/bli-medlem/${org.slug}/start`}>
            <input type="hidden" name="medlemskap" value={tier.key} />
            {referral && <input type="hidden" name={JOIN_REFERRAL_PARAM} value={referral} />}
            <Button type="submit" block>Bli støttemedlem med Vipps</Button>
          </form>
        </MembershipTierCard>
      ))
    }
    <Stack gap="sm">
      {
        tiers.length > 0 && (
          <Text variant="muted">
            Medlemskapet betales med Vipps og fornyes automatisk hvert år til du sier opp. Du får
            varsel i Vipps-appen før hver fornyelse.
          </Text>
        )
      }
      <Text variant="small">
        <TextLink href={joinPageTermsPath(org.slug)}>Salgsvilkår</TextLink>
      </Text>
    </Stack>

    <Stack gap="sm">
      <Heading level={3}>Om organisasjonen</Heading>
      <dl>
        <dt>Navn</dt>
        <dd>{org.name}</dd>
        {
          org.orgnr && (
            <>
              <dt>Organisasjonsnummer</dt>
              <dd>{formatOrganisasjonsnummer(org.orgnr)}</dd>
            </>
          )
        }
        {
          org.contactEmail && (
            <>
              <dt>Kontakt</dt>
              <dd>
                <a href={`mailto:${org.contactEmail}`}>{org.contactEmail}</a>
              </dd>
            </>
          )
        }
      </dl>
    </Stack>
  </Stack>
</PublicShell>

<style>
  dl {
    margin: 0;
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.35rem 1.25rem;
    font-size: 0.95rem;
  }
  dt {
    color: var(--sm-muted);
  }
  dd {
    margin: 0;
    overflow-wrap: anywhere;
  }
  dd a {
    color: inherit;
  }
</style>
