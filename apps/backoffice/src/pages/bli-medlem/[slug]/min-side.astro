---
import { periodLabel } from "@stottemedlem/core";
import {
  closeAgreement,
  findAgreementByManageToken,
  getOrganizationBySlug,
  hasOtherRunningAgreement,
  listMembershipHistory,
} from "@stottemedlem/db";
import Alert from "@stottemedlem/ui/components/Alert.astro";
import Button from "@stottemedlem/ui/components/Button.astro";
import Heading from "@stottemedlem/ui/components/Heading.astro";
import Stack from "@stottemedlem/ui/components/Stack.astro";
import Text from "@stottemedlem/ui/components/Text.astro";
import TextLink from "@stottemedlem/ui/components/TextLink.astro";
import MemberCardFigure from "../../../components/MemberCardFigure.astro";
import PublicShell from "../../../layouts/PublicShell.astro";
import { getDb } from "../../../lib/db";
import { loadMemberCardForMemberId, memberCardUrl } from "../../../lib/memberCard";
import { getVippsForOrg } from "../../../lib/vipps";
import { getWorkOS } from "../../../lib/workos";

// The member's own page — the address Vipps requires every agreement to carry,
// and which must offer actual management rather than an explanation of whom to
// contact (specs/use-cases/renew-annual-membership.md: ending the arrangement
// is never harder than starting it was).
//
// There is no login: the page is opened from the member's Vipps app, and the
// token in the URL is what makes it theirs. An unknown token is simply a 404 —
// it never reveals that some other membership exists.
const slug = Astro.params.slug;
const db = getDb();
const org = slug ? await getOrganizationBySlug(db, slug) : null;
if (!org) return new Response("Fant ikke organisasjonen", { status: 404 });

const token = Astro.url.searchParams.get("n");
const agreement = token ? await findAgreementByManageToken(db, token) : null;
if (!agreement || agreement.orgId !== org.id) {
  return new Response("Fant ikke medlemskapet", { status: 404 });
}

let stopped = agreement.status === "STOPPED" || agreement.status === "EXPIRED";
let stopFailed = false;

if (Astro.request.method === "POST" && !stopped) {
  const vipps = await getVippsForOrg(getWorkOS(), org.workosOrgId);
  try {
    if (!vipps) throw new Error("organisasjonen mangler Vipps-oppsett");
    // Stop it with Vipps first: the member's word only counts once the
    // provider will stop charging. Our record follows.
    await vipps.updateAgreement(
      agreement.vippsAgreementId,
      { status: "STOPPED" },
      crypto.randomUUID(),
    );
    await closeAgreement(db, agreement.vippsAgreementId, "STOPPED");
    stopped = true;
  } catch (error) {
    console.error("could not stop agreement", error);
    stopFailed = true;
  }
}

// What they have paid for stands: stopping ends the renewal, not the year.
const history = agreement.memberId ? await listMembershipHistory(db, agreement.memberId) : [];
const current = history[0];

// "Will I be charged again?" is about this person's money, not about this one
// agreement — and stopping and re-joining leaves them holding both a stopped
// one and a live one. Promising no further payment while another arrangement
// renews would be the one wrong thing this page could say.
const chargedElsewhere =
  stopped && agreement.memberId
    ? await hasOtherRunningAgreement(db, agreement.memberId, agreement.id)
    : false;

// The page is the card, then the paperwork (specs/concepts/member-card.md).
// What the card already says — the hearts collected, the year it is good for —
// is not repeated underneath it: the picture is the statement, and a page that
// explains its own illustration is longer without saying more. There is no
// card before a payment has completed.
const card = agreement.memberId ? await loadMemberCardForMemberId(db, agreement.memberId) : null;
const cardToken = card?.member.cardToken ?? null;
const cardAlt = card
  ? `Medlemsbevis for ${card.member.name?.trim() || "deg"} i ${org.name}, med ${card.hearts} hjerter.`
  : "";

// One line for the whole state: what was paid for which period, and — the
// question the member opened this page to answer — whether it continues. It
// stands directly under the card, before anything that could be mistaken for
// an ordinary running membership. When another arrangement of theirs still
// runs, it speaks about this one rather than about their support as a whole.
const statusLine = current
  ? [
      `${current.tierName} i ${org.name} — ${current.paidNok} kr betalt for ${periodLabel(current.periodYear)}.`,
      stopped
        ? chargedElsewhere
          ? "Denne avtalen fornyes ikke."
          : "Den fornyes ikke."
        : `Fornyes automatisk ved årsskiftet til ${agreement.annualFeeNok} kr i året.`,
    ].join(" ")
  : `Medlemskapet i ${org.name} er ikke bekreftet ennå.`;

const title = `Ditt støttemedlemskap — ${org.name}`;
---

<PublicShell title={title} description={`Administrer støttemedlemskapet ditt i ${org.name}.`} noindex>
  <Stack gap="lg">
    <Heading>Ditt støttemedlemskap</Heading>

    {
      card && cardToken && (
        <MemberCardFigure
          cardToken={cardToken}
          alt={cardAlt}
          shareUrl={memberCardUrl(cardToken)}
          shareTitle={`Medlemsbeviset mitt i ${org.name}`}
        />
      )
    }

    <Text variant="lead">{statusLine}</Text>

    {stopFailed && <Alert variant="error">Vi fikk ikke stoppet medlemskapet nå. Prøv igjen om litt.</Alert>}

    {
      stopped ? (
        <Stack gap="sm">
          <Alert variant="success">Medlemskapet er sagt opp.</Alert>
          <Text>
            {[
              chargedElsewhere
                ? "Denne avtalen belastes ikke igjen, men du har en annen avtale med oss som fortsatt løper. Du finner den i Vipps-appen."
                : "Du blir ikke belastet igjen.",
              current ? `Du er støttemedlem ut ${periodLabel(current.periodYear)}.` : null,
            ]
              .filter(Boolean)
              .join(" ")}
          </Text>
        </Stack>
      ) : (
        <Stack gap="sm">
          <Text>Du får varsel i Vipps-appen før hver fornyelse.</Text>
          <form method="post">
            <Button type="submit" variant="secondary">Si opp medlemskapet</Button>
          </form>
          <Text variant="small">
            Sier du opp, står du som støttemedlem ut året du har betalt for — du blir bare ikke
            belastet på nytt.
          </Text>
        </Stack>
      )
    }

    <Text variant="small">
      <TextLink href={`/bli-medlem/${org.slug}`}>Om {org.name}</TextLink>
    </Text>
  </Stack>
</PublicShell>
