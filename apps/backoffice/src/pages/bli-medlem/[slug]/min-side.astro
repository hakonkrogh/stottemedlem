---
import { joinPagePrivacyPath, periodLabel } from "@stottemedlem/core";
import {
  anonymizeMember,
  closeAgreement,
  findAgreementByManageToken,
  getMembershipTier,
  getOrganizationBySlug,
  hasOtherRunningAgreement,
  listMembershipHistory,
  resumeCostsNow,
} from "@stottemedlem/db";
import Alert from "@stottemedlem/ui/components/Alert.astro";
import Button from "@stottemedlem/ui/components/Button.astro";
import Heading from "@stottemedlem/ui/components/Heading.astro";
import Stack from "@stottemedlem/ui/components/Stack.astro";
import Text from "@stottemedlem/ui/components/Text.astro";
import TextLink from "@stottemedlem/ui/components/TextLink.astro";
import MemberCardFigure from "../../../components/MemberCardFigure.astro";
import PublicShell from "../../../layouts/PublicShell.astro";
import { getDb } from "../../../lib/db";
import { loadMemberCardForMemberId, memberCardUrl } from "../../../lib/memberCard";
import { publicOrigin, startJoin } from "../../../lib/membership";
import { periods } from "../../../lib/periods";
import { getVippsForOrg } from "../../../lib/vipps";
import { getWorkOS } from "../../../lib/workos";

// The member's own page — the address Vipps requires every agreement to carry,
// and which must offer actual management rather than an explanation of whom to
// contact (specs/use-cases/renew-annual-membership.md: ending the arrangement
// is never harder than starting it was).
//
// There is no login: the page is opened from the member's Vipps app, and the
// token in the URL is what makes it theirs. An unknown token is simply a 404 —
// it never reveals that some other membership exists.
const slug = Astro.params.slug;
const db = getDb();
const org = slug ? await getOrganizationBySlug(db, slug) : null;
if (!org) return new Response("Fant ikke organisasjonen", { status: 404 });

const token = Astro.url.searchParams.get("n");
const agreement = token ? await findAgreementByManageToken(db, token) : null;
if (!agreement || agreement.orgId !== org.id) {
  return new Response("Fant ikke medlemskapet", { status: 404 });
}

let stopped = agreement.status === "STOPPED" || agreement.status === "EXPIRED";
let stopFailed = false;
let resumeFailed = false;
// The member asked to be forgotten and it worked. Their token is void from
// that moment, so this page can never be reached again — which is why the
// confirmation has to be rendered here and now, not redirected to.
let erased = false;
let eraseFailed = false;

// One form action or the other (specs/use-cases/erase-member-data.md): ending
// the arrangement, or ending it AND erasing the person behind it. Erasing is
// deliberately the same button plus a confirmation rather than a hidden
// setting — it is the member's right, not an advanced option.
const action =
  Astro.request.method === "POST" ? (await Astro.request.formData()).get("handling") : null;

// Changing their mind back is as much the member's to do as ending it was
// (specs/concepts/member-self-service.md). A payment app cannot revive a
// stopped arrangement, so resuming drafts a NEW one — and because the member
// is known HERE, before the payment app is, it can ask for nothing when the
// period is already theirs. That is the whole reason this belongs on this
// page rather than on the public join page, where nobody has a name yet.
if (action === "fortsett" && stopped && agreement.memberId) {
  const tier = await getMembershipTier(db, org.id, agreement.tierId);
  const vipps = await getVippsForOrg(getWorkOS(), org.workosOrgId);
  // Never a second arrangement alongside a running one, and never back into a
  // membership the organization has stopped offering — those go through the
  // join page, which presents what is actually on offer today.
  const mayResume =
    tier &&
    !tier.archivedAt &&
    vipps &&
    !(await hasOtherRunningAgreement(db, agreement.memberId, agreement.id));
  if (mayResume) {
    try {
      const latest = (await listMembershipHistory(db, agreement.memberId))[0];
      const { confirmationUrl } = await startJoin(
        db,
        vipps,
        org,
        tier,
        publicOrigin(Astro.request),
        {
          periodAlreadyPaid: !resumeCostsNow(latest?.periodYear ?? null, periods.periodFor().year),
        },
      );
      // 303 so the browser follows with GET and the back button cannot draft a
      // second agreement — the same reason joining does it.
      return Astro.redirect(confirmationUrl, 303);
    } catch (error) {
      console.error("could not resume agreement", error);
      resumeFailed = true;
    }
  } else {
    resumeFailed = true;
  }
}

if (action === "stopp" || action === "slett") {
  if (!stopped) {
    const vipps = await getVippsForOrg(getWorkOS(), org.workosOrgId);
    try {
      if (!vipps) throw new Error("organisasjonen mangler Vipps-oppsett");
      // Stop it with Vipps first: the member's word only counts once the
      // provider will stop charging. Our record follows.
      await vipps.updateAgreement(
        agreement.vippsAgreementId,
        { status: "STOPPED" },
        crypto.randomUUID(),
      );
      await closeAgreement(db, agreement.vippsAgreementId, "STOPPED");
      stopped = true;
    } catch (error) {
      console.error("could not stop agreement", error);
      stopFailed = true;
    }
  }

  // Erasing only follows a payment arrangement that has actually stopped: a
  // member cannot be erased out of a contract that is still charging them.
  if (action === "slett") {
    if (!stopped || !agreement.memberId) {
      eraseFailed = true;
    } else {
      const outcome = await anonymizeMember(db, agreement.memberId).catch((error) => {
        console.error("could not erase member", error);
        return null;
      });
      if (outcome?.erased) erased = true;
      else eraseFailed = true;
    }
  }
}

// What they have paid for stands: stopping ends the renewal, not the year.
// Nothing personal is loaded once they are erased — the page they are about to
// see must not show the very details it just removed.
const history =
  agreement.memberId && !erased ? await listMembershipHistory(db, agreement.memberId) : [];
const current = history[0];

// "Will I be charged again?" is about this person's money, not about this one
// agreement — and stopping and re-joining leaves them holding both a stopped
// one and a live one. Promising no further payment while another arrangement
// renews would be the one wrong thing this page could say.
const chargedElsewhere =
  stopped && agreement.memberId && !erased
    ? await hasOtherRunningAgreement(db, agreement.memberId, agreement.id)
    : false;

// Offering the way back (specs/use-cases/renew-annual-membership.md). Not
// offered where it would be a lie: into a membership no longer on offer, or
// alongside an arrangement of theirs that already renews.
const resumeTier =
  stopped && agreement.memberId && !erased && !chargedElsewhere
    ? await getMembershipTier(db, org.id, agreement.tierId)
    : null;
const canResume = Boolean(resumeTier && !resumeTier.archivedAt);
// Inside a period they paid for, resuming costs nothing and only starts the
// renewal again; lapsed, it is an ordinary join and this period is theirs to
// pay for. The button must say which, before it is pressed.
const resumeNok =
  canResume && resumeTier && resumeCostsNow(current?.periodYear ?? null, periods.periodFor().year)
    ? periods.proratedJoinFeeNok(resumeTier.annualFeeNok, new Date())
    : null;

// The page is the card, then the paperwork (specs/concepts/member-card.md).
// What the card already says — the hearts collected, the year it is good for —
// is not repeated underneath it: the picture is the statement, and a page that
// explains its own illustration is longer without saying more. There is no
// card before a payment has completed — and none after an erasure, which took
// the card's address with it (specs/use-cases/erase-member-data.md).
const card =
  agreement.memberId && !erased ? await loadMemberCardForMemberId(db, agreement.memberId) : null;
const cardToken = card?.member.cardToken ?? null;
const cardAlt = card
  ? `Medlemsbevis for ${card.member.name?.trim() || "deg"} i ${org.name}, med ${card.hearts} hjerter.`
  : "";

// One line for the whole state: what was paid for which period, and — the
// question the member opened this page to answer — whether it continues. It
// stands directly under the card, before anything that could be mistaken for
// an ordinary running membership. When another arrangement of theirs still
// runs, it speaks about this one rather than about their support as a whole.
const statusLine = current
  ? [
      `${current.tierName} i ${org.name} — ${current.paidNok} kr betalt for ${periodLabel(current.periodYear)}.`,
      stopped
        ? chargedElsewhere
          ? "Denne avtalen fornyes ikke."
          : "Den fornyes ikke."
        : `Fornyes automatisk ved årsskiftet til ${agreement.annualFeeNok} kr i året.`,
    ].join(" ")
  : `Medlemskapet i ${org.name} er ikke bekreftet ennå.`;

const title = `Ditt støttemedlemskap — ${org.name}`;
---

<PublicShell title={title} description={`Administrer støttemedlemskapet ditt i ${org.name}.`} noindex>
  {
    /* Erased: the address that opened this page is void from now on, so this
       render is the member's last look at it. It says what happened and what
       is left, and offers nothing personal — there is nothing personal left to
       offer (specs/use-cases/erase-member-data.md). */
    erased ? (
      <Stack gap="lg">
        <Stack gap="sm">
          <Heading>Opplysningene dine er slettet</Heading>
          <Alert variant="success">
            Navn, e-postadresse og telefonnummer er fjernet fra medlemsregisteret til {org.name}.
          </Alert>
        </Stack>
        <Text>
          Medlemskapet er avsluttet, og du blir ikke belastet igjen. Betalingene som er gjort blir
          liggende i organisasjonens regnskap uten navn, slik loven krever.
        </Text>
        <Text>
          Denne siden fungerer ikke lenger — lenken til den er slettet sammen med opplysningene.
          Vil du støtte {org.name} igjen senere, melder du deg inn på nytt som et nytt medlem.
        </Text>
        <Text variant="small">
          <TextLink href={`/bli-medlem/${org.slug}`}>Om {org.name}</TextLink> ·
          <TextLink href={joinPagePrivacyPath(org.slug)}>Personvern</TextLink>
        </Text>
      </Stack>
    ) : (
  <Stack gap="lg">
    <Heading>Ditt støttemedlemskap</Heading>

    {
      card && cardToken && (
        <MemberCardFigure
          cardToken={cardToken}
          alt={cardAlt}
          shareUrl={memberCardUrl(cardToken)}
          shareTitle={`Medlemsbeviset mitt i ${org.name}`}
        />
      )
    }

    <Text variant="lead">{statusLine}</Text>

    {stopFailed && <Alert variant="error">Vi fikk ikke stoppet medlemskapet nå. Prøv igjen om litt.</Alert>}
    {resumeFailed && <Alert variant="error">Vi fikk ikke startet medlemskapet igjen nå. Prøv igjen om litt, eller meld deg inn på nytt fra støttemedlemssiden.</Alert>}
    {eraseFailed && !stopFailed && <Alert variant="error">Vi fikk ikke slettet opplysningene nå. Prøv igjen om litt.</Alert>}

    {
      stopped ? (
        <Stack gap="sm">
          <Alert variant="success">Medlemskapet er sagt opp.</Alert>
          <Text>
            {[
              chargedElsewhere
                ? "Denne avtalen belastes ikke igjen, men du har en annen avtale med oss som fortsatt løper. Du finner den i Vipps-appen."
                : "Du blir ikke belastet igjen.",
              current ? `Du er støttemedlem ut ${periodLabel(current.periodYear)}.` : null,
            ]
              .filter(Boolean)
              .join(" ")}
          </Text>
          {/* Angret? Ending is reversible for the person, if not for the
              agreement (specs/concepts/member-self-service.md). */}
          {canResume && (
            <Stack gap="sm">
              <form method="post">
                <input type="hidden" name="handling" value="fortsett" />
                <Button type="submit">Fortsett medlemskapet</Button>
              </form>
              <Text variant="small">
                {resumeNok === null
                  ? `Du har allerede betalt for ${current ? periodLabel(current.periodYear) : "perioden"}, så du betaler ingenting nå — den automatiske fornyelsen starter bare igjen. Du godkjenner den nye avtalen i Vipps.`
                  : `Du betaler ${resumeNok} kr nå for resten av ${periodLabel(periods.periodFor().year)}, deretter ${resumeTier?.annualFeeNok} kr i året. Du godkjenner i Vipps.`}
              </Text>
            </Stack>
          )}
        </Stack>
      ) : (
        <Stack gap="sm">
          <Text>Du får varsel i Vipps-appen før hver fornyelse.</Text>
          <form method="post">
            <input type="hidden" name="handling" value="stopp" />
            <Button type="submit" variant="secondary">Si opp medlemskapet</Button>
          </form>
          <Text variant="small">
            Sier du opp, står du som støttemedlem ut året du har betalt for — du blir bare ikke
            belastet på nytt.
          </Text>
        </Stack>
      )
    }

    {/* The way out of the register, next to the way out of the payment
        (specs/use-cases/erase-member-data.md). Only offered once the
        arrangement has stopped: nobody can be erased out of a contract that is
        still charging them. */}
    {
      stopped && (
        <Stack gap="sm">
          <Heading level={2}>Slett opplysningene dine</Heading>
          <Text>
            Du kan få navn, e-postadresse og telefonnummer fjernet fra medlemsregisteret til{" "}
            {org.name}. Betalingene du har gjort blir liggende i regnskapet uten navn, slik loven
            krever.
          </Text>
          <form method="post" data-confirm="Slette opplysningene dine? Denne siden slutter å virke, og hjertene dine forsvinner.">
            <input type="hidden" name="handling" value="slett" />
            <Button type="submit" variant="secondary">Slett opplysningene mine</Button>
          </form>
          <Text variant="small">
            Sletting kan ikke angres. Denne siden slutter å virke, og hjertene dine nullstilles —
            melder du deg inn igjen, starter du som nytt medlem.
          </Text>
        </Stack>
      )
    }

    <Text variant="small">
      <TextLink href={`/bli-medlem/${org.slug}`}>Om {org.name}</TextLink> ·
      <TextLink href={joinPagePrivacyPath(org.slug)}>Personvern</TextLink>
    </Text>
  </Stack>
    )
  }
</PublicShell>

<script>
  // A deletion that cannot be undone gets one question first. The form still
  // posts without JavaScript — the confirmation is a courtesy, never the thing
  // that protects the member (the server refuses while an arrangement runs).
  document.querySelectorAll<HTMLFormElement>("form[data-confirm]").forEach((form) => {
    form.addEventListener("submit", (event: Event) => {
      if (!window.confirm(form.dataset.confirm)) event.preventDefault();
    });
  });
</script>
