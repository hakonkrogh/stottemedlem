---
import { formatOrganisasjonsnummer, periodLabel } from "@stottemedlem/core";
import {
  findAgreementByManageToken,
  findAgreementByVippsId,
  findReceiptNotice,
  getOrganizationBySlug,
  getSupportingMember,
  listChargesForAgreement,
  listMembershipHistory,
  membershipStatus,
} from "@stottemedlem/db";
import Heading from "@stottemedlem/ui/components/Heading.astro";
import InfoList from "@stottemedlem/ui/components/InfoList.astro";
import Stack from "@stottemedlem/ui/components/Stack.astro";
import Text from "@stottemedlem/ui/components/Text.astro";
import TextLink from "@stottemedlem/ui/components/TextLink.astro";
import MemberCardFigure from "../../../components/MemberCardFigure.astro";
import OrgIdentityHeader from "../../../components/OrgIdentityHeader.astro";
import PublicShell from "../../../layouts/PublicShell.astro";
import { getDb } from "../../../lib/db";
import { getEmailSender } from "../../../lib/email";
import { loadMemberCardForMemberId, memberCardUrl } from "../../../lib/memberCard";
import { publicOrigin, syncAgreement, syncCharge } from "../../../lib/membership";
import { periods } from "../../../lib/periods";
import { sendOwedReceipts } from "../../../lib/receipts";
import { getVippsForOrg } from "../../../lib/vipps";
import { getWorkOS } from "../../../lib/workos";

// Where the supporter lands coming back from Vipps. Arriving here is NOT proof
// that anything was paid (specs/use-cases/join-as-supporting-member.md), so the
// page asks Vipps rather than believing the redirect — and it is also the
// polling fallback for when a webhook is slow or lost.
//
// When a payment IS confirmed, this page is the receipt itself
// (specs/concepts/payment-receipt.md): the same betalingsdokumentasjon the
// email carries, for the member standing here right now — including the one
// whose profile came without an email address.
const slug = Astro.params.slug;
const db = getDb();
const org = slug ? await getOrganizationBySlug(db, slug) : null;
if (!org) return new Response("Fant ikke organisasjonen", { status: 404 });

// Vipps appends NOTHING to the redirect, so the return address carries our
// own reference: the same unguessable manage token that addresses the
// member's own page (specs/concepts/member-self-service.md). An explicit
// agreementId is still honored — it is how an operator or an older
// registered redirect can point the page at a specific arrangement. With
// neither there is nothing to confirm and the visitor is simply sent back
// to the join page.
const token = Astro.url.searchParams.get("n");
const tokenAgreement = token ? await findAgreementByManageToken(db, token) : null;
const agreementId = tokenAgreement?.vippsAgreementId ?? Astro.url.searchParams.get("agreementId");
if (!agreementId) return Astro.redirect(`/bli-medlem/${org.slug}`);

let status: "active" | "already-a-member" | "pending" | "stopped" | "unknown" = "unknown";

/**
 * The supporter came back holding the period already, so this arrangement
 * bought them nothing — which is not the same as nothing having happened.
 * Two ways to arrive here, and the page owes a different sentence about the
 * money for each:
 *
 * - they **resumed** from their own page, which asks for nothing
 *   (specs/concepts/member-self-service.md) — `returned` is null;
 * - they **joined again** from the public page, where nobody could know who
 *   they were until the payment was taken, so it was given straight back
 *   (specs/use-cases/join-as-supporting-member.md).
 *
 * Either way they ARE a supporting member, and the page says so rather than
 * thanking them for a payment that never stood.
 */
interface AlreadyAMember {
  /** The period they already held, in words. */
  period: string;
  /** What was given back, when money moved at all. */
  returned: string | null;
  /** Whether THIS arrangement carries their renewal onward. */
  renews: boolean;
}
let already: AlreadyAMember | null = null;

/** The confirmed payment, presented as the payment documentation it is. */
interface ReceiptDetails {
  seller: string;
  memberLabel: string | null;
  what: string;
  period: string;
  paid: string;
  /** Where the same receipt also went, when it could be emailed. */
  emailedTo: string | null;
}
let receipt: ReceiptDetails | null = null;

// The card the supporter just earned (specs/concepts/member-card.md) — the
// first thing they should see here, ahead of the paperwork.
let card: Awaited<ReturnType<typeof loadMemberCardForMemberId>> = null;

/** "2026-03-14" (or a full timestamp) as people read it. */
const dato = (iso: string) =>
  new Date(iso.length === 10 ? `${iso}T00:00:00Z` : iso).toLocaleDateString("nb-NO", {
    day: "numeric",
    month: "long",
    year: "numeric",
    timeZone: "Europe/Oslo",
  });
const kr = (nok: number) => `${nok.toLocaleString("nb-NO").replace(/ /g, " ")} kr`;

const vipps = await getVippsForOrg(getWorkOS(), org.workosOrgId);
if (vipps) {
  try {
    const { local, remote } = await syncAgreement(db, vipps, agreementId);
    // The agreement belongs to this organization or it is none of our business.
    if (local && local.orgId === org.id) {
      for (const charge of await vipps.listCharges(agreementId)) {
        await syncCharge(db, vipps, agreementId, charge.id);
      }
      const settled = await findAgreementByVippsId(db, agreementId);
      // Our own record, not `remote`: that was read before the charges were
      // synced, and syncing a redundant join can end the arrangement in the
      // very lines above.
      const agreementStatus = settled?.status ?? remote.status;
      status =
        agreementStatus === "ACTIVE"
          ? "active"
          : agreementStatus === "PENDING"
            ? "pending"
            : "stopped";

      if (settled?.memberId) {
        // The email receipt goes out from here too — the supporter's own
        // arrival is usually the first moment the capture is known.
        await sendOwedReceipts(db, org, publicOrigin(Astro.request), getEmailSender());

        card = await loadMemberCardForMemberId(db, settled.memberId);
        const member = await getSupportingMember(db, settled.memberId);
        const charges = await listChargesForAgreement(db, settled.id);
        const captured = charges.filter((charge) => charge.status === "CHARGED").at(-1);

        // Nothing of this arrangement's money stands. Either it asked for none
        // (a resume) or what it took has gone back (a second join) — in both
        // cases a period of theirs stands on somebody else's payment, and that
        // is what the page has to talk about.
        const givenBack = captured
          ? undefined
          : charges.find((charge) => charge.status === "REFUNDED");
        const stillHeld =
          !captured && (givenBack || charges.length === 0)
            ? (await listMembershipHistory(db, settled.memberId)).find(
                (row) =>
                  row.agreementId !== settled.id &&
                  (givenBack
                    ? row.periodYear === givenBack.periodYear
                    : membershipStatus(row.periodYear, periods.periodFor().year) === "active"),
              )
            : undefined;
        if (stillHeld) {
          status = "already-a-member";
          already = {
            period: periodLabel(stillHeld.periodYear),
            returned: givenBack ? kr(givenBack.amountNok) : null,
            renews: agreementStatus === "ACTIVE",
          };
        }

        const membership = captured?.membershipId
          ? (await listMembershipHistory(db, settled.memberId)).find(
              (row) => row.id === captured.membershipId,
            )
          : undefined;
        if (captured && membership) {
          const emailed = await findReceiptNotice(db, captured.id);
          receipt = {
            seller: org.orgnr
              ? `${org.name} (org.nr. ${formatOrganisasjonsnummer(org.orgnr)})`
              : org.name,
            memberLabel: member?.name ?? member?.email ?? null,
            what: `Medlemskontingent — «${membership.tierName}»`,
            period: `${dato(membership.periodStart)} – ${dato(membership.periodEnd)} (${periodLabel(membership.periodYear)})`,
            paid: `${kr(captured.amountNok)} den ${dato(captured.capturedAt ?? captured.updatedAt)}, via Vipps`,
            emailedTo: emailed && member?.email ? member.email : null,
          };
        }
      }
    }
  } catch (error) {
    console.error("could not confirm agreement", error);
  }
}

const title =
  status === "already-a-member"
    ? already?.returned
      ? `Du er allerede støttemedlem — ${org.name}`
      : `Medlemskapet fortsetter — ${org.name}`
    : `Takk for støtten — ${org.name}`;
---

<PublicShell title={title} description={`Kvittering for støttemedlemskap i ${org.name}.`} noindex>
  <Stack gap="lg">
    {/* The same identity the supporter just joined under on the join page
        (specs/concepts/join-page.md) — the receipt confirms WHO you now
        support, not just that a payment happened. */}
    <OrgIdentityHeader org={org} />
    {
      status === "active" && (
        <Stack gap="sm">
          <Heading>Takk for støtten! ❤️</Heading>
          <Text variant="lead">Du er nå støttemedlem i {org.name}, ut året.</Text>
          <Text>
            Medlemskapet fornyes automatisk ved årsskiftet til den årlige kontingenten, så lenge du
            vil være med. Du får varsel i Vipps-appen før hver fornyelse, og kan si opp når som
            helst.
          </Text>
        </Stack>
      )
    }
    {
      /* Already theirs: the period was paid for once, and the second payment
         is on its way back (specs/use-cases/join-as-supporting-member.md). */
      status === "already-a-member" && already && (
        <Stack gap="sm">
          <Heading>
            {already.returned ? "Du er allerede støttemedlem ❤️" : "Medlemskapet fortsetter ❤️"}
          </Heading>
          <Text variant="lead">
            {already.returned
              ? `Du støtter ${org.name} for ${already.period} fra før, så denne betalingen skulle ikke vært tatt. ${already.returned} er betalt tilbake til deg.`
              : `Du støtter ${org.name} for ${already.period} fra før, så du betalte ingenting nå.`}
          </Text>
          <Text>
            {already.renews
              ? "Medlemskapet ditt fornyes igjen automatisk ved årsskiftet til den årlige kontingenten. Du får varsel i Vipps-appen før hver fornyelse, og kan si opp når som helst."
              : "Du har fra før en avtale som løper videre, så denne nye er avsluttet. Du finner den som gjelder i Vipps-appen."}
          </Text>
        </Stack>
      )
    }
    {
      (status === "active" || status === "already-a-member") && card?.member.cardToken && (
        <Stack gap="sm">
          <MemberCardFigure
            cardToken={card.member.cardToken}
            alt={`Medlemsbevis for ${card.member.name?.trim() || "deg"} i ${org.name}, med ${card.hearts} hjerter.`}
          />
          <Text variant="small">
            Dette er medlemsbeviset ditt. Det er ditt å dele —{" "}
            <TextLink href={memberCardUrl(card.member.cardToken)}>se og del det her</TextLink>. Blir
            noen støttemedlem ved å skanne QR-koden, teller det som en verving for deg.
          </Text>
        </Stack>
      )
    }
    {
      status === "active" && receipt && (
        <Stack gap="sm">
          <Heading level={2}>Kvittering</Heading>
          <InfoList
            items={[
              { label: "Organisasjon", value: receipt.seller },
              { label: "Medlem", value: receipt.memberLabel },
              { label: "Gjelder", value: receipt.what },
              { label: "Periode", value: receipt.period },
              { label: "Betalt", value: receipt.paid },
              {
                label: "Merverdiavgift",
                value: "0 kr",
                hint: "Medlemskontingent er unntatt mva.",
              },
            ]}
          />
          <Text variant="small">
            Ta gjerne vare på kvitteringen.
            {receipt.emailedTo ? ` Den er også sendt til ${receipt.emailedTo}.` : ""}
          </Text>
        </Stack>
      )
    }
    {
      status === "pending" && (
        <Stack gap="sm">
          <Heading>Vi venter på Vipps</Heading>
          <Text variant="lead">
            Betalingen er ikke bekreftet ennå. Fullfør i Vipps-appen om du ikke har gjort det — så
            snart Vipps bekrefter, er du støttemedlem i {org.name}.
          </Text>
          <Text>Du kan trygt laste denne siden på nytt.</Text>
        </Stack>
      )
    }
    {
      (status === "stopped" || status === "unknown") && (
        <Stack gap="sm">
          <Heading>Medlemskapet ble ikke opprettet</Heading>
          <Text variant="lead">
            Avtalen ble avbrutt eller avvist, og ingenting er trukket. Du kan prøve på nytt fra
            støttemedlemssiden.
          </Text>
        </Stack>
      )
    }
    <Text variant="small">
      <TextLink href={`/bli-medlem/${org.slug}`}>Tilbake til {org.name}</TextLink>
    </Text>
  </Stack>
</PublicShell>
