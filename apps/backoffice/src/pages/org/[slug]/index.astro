---
import { formatOrganisasjonsnummer, joinEntryPointUrl, orgTermsUrl } from "@stottemedlem/core";
import { getOrganizationBySlug, listMembershipTiers } from "@stottemedlem/db";
import Button from "@stottemedlem/ui/components/Button.astro";
import Card from "@stottemedlem/ui/components/Card.astro";
import Heading from "@stottemedlem/ui/components/Heading.astro";
import Stack from "@stottemedlem/ui/components/Stack.astro";
import Text from "@stottemedlem/ui/components/Text.astro";
import TextLink from "@stottemedlem/ui/components/TextLink.astro";
import PublicShell from "../../../layouts/PublicShell.astro";
import { getDb } from "../../../lib/db";
import { orgImageUrl } from "../../../lib/orgImages";

// PUBLIC org landing page (specs/concepts/org-landing-page.md): the page an
// admin registers as the organization's website in the Vipps portal, so it
// must show org name, org.nr, contact info, and the membership offer with its
// price — and link the salgsvilkår. It is also the org's shareable home for
// prospective supporters; the CTA hands off to the join entry point.
const slug = Astro.params.slug;
const db = getDb();
const org = slug ? await getOrganizationBySlug(db, slug) : null;
if (!org) return new Response("Fant ikke organisasjonen", { status: 404 });
// The organization's membership offer: its active tiers, cheapest first
// (specs/concepts/membership-tier.md). Every organization states its first
// membership at creation, so there is always at least one tier to show —
// zero happens only for organizations predating tiers, which the back office
// prompts to fix.
const tiers = await listMembershipTiers(db, org.id);

const title = `${org.name} — bli støttemedlem`;
const description = `Bli støttemedlem i ${org.name} og støtt arbeidet med et fast årlig bidrag.`;

// The hero copy invites the visitor to become a supporting member and explains
// the offer in plain words: with one tier it describes that membership and its
// fee, with several it says the visitor chooses between them, and it never
// enumerates options that don't exist. It always restates the product's
// promise: an annual membership that renews year by year, puts you on the
// org's member list, and makes your support count.
const singleTier = tiers.length === 1 ? tiers[0] : undefined;
const feePhrase = singleTier
  ? `en fast årlig kontingent på ${singleTier.annualFeeNok} kr`
  : "en fast årlig kontingent";
const subheadIntro =
  tiers.length > 1
    ? `Dette er støttemedlemssiden til ${org.name}. Her tegner du et støttemedlemskap — velg mellom ${tiers.length} typer medlemskap, hvert med en fast årlig kontingent som går direkte til arbeidet i organisasjonen.`
    : `Dette er støttemedlemssiden til ${org.name}. Her tegner du et støttemedlemskap — ${feePhrase} som går direkte til arbeidet i organisasjonen.`;
const subheadPromise =
  "Medlemskapet fornyes år for år så lenge du vil være med: du står på organisasjonens liste over støttemedlemmer, hører fra dem gjennom året, og støtten din teller for hvert år som går.";

// The org's uploaded visual identity, Facebook-style: a wide banner backdrop
// with the circular logo overlapping its bottom edge and the org name beside
// it. The banner stays bounded in height so the membership offer is never
// pushed far down the page. Either image is simply omitted when the org has
// not uploaded it.
const logoUrl = org.logoKey ? orgImageUrl(org.slug, "logo", org.logoKey) : null;
const bannerUrl = org.bannerKey ? orgImageUrl(org.slug, "banner", org.bannerKey) : null;
// The admin-chosen focal point decides which part of the banner survives the
// crop to the wide backdrop (settings page picker); center when unset.
const bannerFocus = `${org.bannerFocusX ?? 50}% ${org.bannerFocusY ?? 50}%`;
---

<PublicShell title={title} description={description}>
  <Stack gap="xl">
    <Stack gap="md">
      <header class:list={["identity", { "has-banner": bannerUrl }]}>
        {bannerUrl && (
          <img class="banner" src={bannerUrl} alt="" style={`object-position: ${bannerFocus}`} />
        )}
        <div class="head">
          {logoUrl && <img class="logo" src={logoUrl} alt="" />}
          <p class="org-name">{org.name}</p>
        </div>
      </header>
      <Stack gap="sm">
        <Heading>Bli støttemedlem</Heading>
        <Text variant="lead">{subheadIntro}</Text>
        <Text variant="lead">{subheadPromise}</Text>
      </Stack>
    </Stack>

    {
      tiers.map((tier) => (
        <Card>
          <Stack gap="md">
            <Heading level={2}>{tier.name}</Heading>
            <p class="price">
              {tier.annualFeeNok} kr <span class="per">per år</span>
            </p>
            {tier.description && <Text variant="muted">{tier.description}</Text>}
            <Button
              href={tiers.length > 1 ? joinEntryPointUrl(org.slug, tier.key) : joinEntryPointUrl(org.slug)}
              block
            >
              Bli støttemedlem med Vipps
            </Button>
          </Stack>
        </Card>
      ))
    }
    <Stack gap="sm">
      {
        tiers.length > 0 && (
          <Text variant="muted">
            Medlemskapet betales med Vipps og fornyes automatisk hvert år til du sier opp. Du får
            varsel i Vipps-appen før hver fornyelse.
          </Text>
        )
      }
      <Text variant="small">
        <TextLink href={orgTermsUrl(org.slug)}>Salgsvilkår</TextLink>
      </Text>
    </Stack>

    <Stack gap="sm">
      <Heading level={3}>Om organisasjonen</Heading>
      <dl>
        <dt>Navn</dt>
        <dd>{org.name}</dd>
        {
          org.orgnr && (
            <>
              <dt>Organisasjonsnummer</dt>
              <dd>{formatOrganisasjonsnummer(org.orgnr)}</dd>
            </>
          )
        }
        {
          org.contactEmail && (
            <>
              <dt>Kontakt</dt>
              <dd>
                <a href={`mailto:${org.contactEmail}`}>{org.contactEmail}</a>
              </dd>
            </>
          )
        }
      </dl>
    </Stack>
  </Stack>
</PublicShell>

<style>
  .identity {
    margin-bottom: 0.5rem;
  }
  .banner {
    display: block;
    width: 100%;
    /* A wide backdrop, not a hero — bounded so the offer stays near the top. */
    aspect-ratio: 12 / 5;
    min-height: 7.5rem;
    max-height: 15rem;
    object-fit: cover;
    border-radius: var(--sm-radius-lg);
  }
  .head {
    display: flex;
    align-items: flex-end;
    gap: 1.1rem;
  }
  /* The org name is the identity mark beside the logo, not the page headline —
     the h1 is the "Bli støttemedlem" invitation below. Styled like a display
     heading so the identity header keeps its weight. */
  .org-name {
    margin: 0;
    font-family: var(--sm-font-display);
    font-weight: var(--sm-font-display-weight, 600);
    font-variation-settings: var(--sm-font-display-variation, normal);
    letter-spacing: -0.01em;
    line-height: 1.2;
    font-size: 1.75rem;
    /* Long single-word org names can't wrap at spaces; allow shrinking below
       content width with mid-word wrapping as the extreme backstop. */
    min-width: 0;
    overflow-wrap: anywhere;
  }
  /* On narrow screens the whole identity row scales down so a typical
     compound org name still fits on one line beside the logo. */
  @media (max-width: 480px) {
    .logo {
      width: 4.5rem;
      height: 4.5rem;
      padding: 0.35rem;
    }
    .has-banner .logo {
      margin-top: -2.25rem;
    }
    .org-name {
      font-size: 1.3rem;
    }
  }
  /* Logos are always framed in a circle with a subtle outline, so mixed logo
     shapes still read as one consistent identity mark. */
  .logo {
    display: block;
    flex-shrink: 0;
    width: 6.5rem;
    height: 6.5rem;
    object-fit: contain;
    padding: 0.5rem;
    background: var(--sm-surface);
    border-radius: 50%;
    box-shadow:
      0 0 0 1px var(--sm-border),
      var(--sm-shadow-card);
  }
  /* With a banner, the circle overlaps its bottom edge (Facebook-style) with
     the name sitting beside it below the banner. */
  .has-banner .logo {
    margin-top: -3.25rem;
    margin-left: 1rem;
  }
  .price {
    margin: 0;
    font-family: var(--sm-font-display);
    font-weight: var(--sm-font-display-weight, 600);
    font-variation-settings: var(--sm-font-display-variation, normal);
    font-size: 2rem;
    line-height: 1.1;
  }
  .price .per {
    font-family: var(--sm-font-sans);
    font-weight: 400;
    font-size: 1rem;
    color: var(--sm-muted);
  }
  dl {
    margin: 0;
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.35rem 1.25rem;
    font-size: 0.95rem;
  }
  dt {
    color: var(--sm-muted);
  }
  dd {
    margin: 0;
    overflow-wrap: anywhere;
  }
  dd a {
    color: inherit;
  }
</style>
