---
import { getOrganizationMember, updateMemberContactDetails } from "@stottemedlem/db";
import MemberDetailScreen from "../../../../components/MemberDetailScreen.astro";
import OrgScreen from "../../../../components/OrgScreen.astro";
import Shell from "../../../../layouts/Shell.astro";
import { getDb } from "../../../../lib/db";
import {
  type MemberContactFieldErrors,
  memberContactFormValues,
  parseMemberContactForm,
} from "../../../../lib/memberContact";
import { requireOrgView } from "../../../../lib/orgView";
import { periods } from "../../../../lib/periods";
import { orgPath } from "../../../../lib/workos";

// One member, and the correction an administrator may make to how they are
// recorded (specs/use-cases/curate-member-list.md).
const view = await requireOrgView(Astro.locals.session, Astro.params.slug, Astro.request);
if (!view) return Astro.redirect("/orgs");
const { org, warnings } = view;

const db = getDb();
let entry = await getOrganizationMember(
  db,
  org.id,
  Astro.params.memberId ?? "",
  periods.periodFor().year,
);
// Another organization's member must read as no member at all.
if (!entry) return new Response("Fant ikke medlemmet", { status: 404 });

let values = memberContactFormValues(entry.member);
let fieldErrors: MemberContactFieldErrors = {};
let saved = false;

if (Astro.request.method === "POST") {
  const parsed = parseMemberContactForm(await Astro.request.formData());
  values = parsed.values;
  fieldErrors = parsed.fieldErrors;
  if (parsed.details) {
    await updateMemberContactDetails(db, org.id, entry.member.id, parsed.details);
    entry =
      (await getOrganizationMember(db, org.id, entry.member.id, periods.periodFor().year)) ?? entry;
    values = memberContactFormValues(entry.member);
    saved = true;
  }
}

const displayName = entry.member.name || entry.member.email || entry.member.phone || "Uten navn";
const membersPath = `${orgPath(org.slug)}/medlemmer`;
const memberPath = `${membersPath}/${entry.member.id}`;
// A save closes the form again; anything still wrong keeps it open.
const editing =
  Object.keys(fieldErrors).length > 0 || (Astro.url.searchParams.has("rediger") && !saved);
---

<Shell title={`${displayName} — ${org.name}`} frame={false}>
  <OrgScreen orgName={org.name} orgPath={orgPath(org.slug)} active="medlemmer" warnings={warnings} activeMembers={view.activeMembers}>
    <MemberDetailScreen
      entry={entry}
      values={values}
      fieldErrors={fieldErrors}
      saved={saved}
      editing={editing}
      membersPath={membersPath}
      memberPath={memberPath}
    />
  </OrgScreen>
</Shell>
