---
import {
  anonymizeMember,
  findChargeByVippsId,
  getMembershipAgreement,
  getOrganizationMember,
  listChargesForMember,
  updateMemberContactDetails,
} from "@stottemedlem/db";
import { VippsApiError } from "@stottemedlem/vipps";
import MemberDetailScreen from "../../../../components/MemberDetailScreen.astro";
import OrgScreen from "../../../../components/OrgScreen.astro";
import Shell from "../../../../layouts/Shell.astro";
import { getDb } from "../../../../lib/db";
import {
  type MemberContactFieldErrors,
  memberContactFormValues,
  parseMemberContactForm,
} from "../../../../lib/memberContact";
import { type RefundResult, refundMembershipPayment } from "../../../../lib/membership";
import { requireOrgView } from "../../../../lib/orgView";
import { periods } from "../../../../lib/periods";
import { PAYMENT_PARAM, paymentViews } from "../../../../lib/refunds";
import { getVippsForOrg } from "../../../../lib/vipps";
import { getWorkOS, orgPath } from "../../../../lib/workos";

// One member: who they are, every period they have supported, what was
// actually paid, and the two things an administrator may do about it —
// correct how they are recorded (specs/use-cases/curate-member-list.md) and
// give a payment back (specs/use-cases/refund-a-payment.md).
//
// Nothing here can make somebody a member or set their status by hand. A
// refund is not an exception to that: money moves, and the status follows it.
const view = await requireOrgView(Astro.locals.session, Astro.params.slug, Astro.request);
if (!view) return Astro.redirect("/orgs");
const { org, warnings } = view;

const db = getDb();
let entry = await getOrganizationMember(
  db,
  org.id,
  Astro.params.memberId ?? "",
  periods.periodFor().year,
);
// Another organization's member must read as no member at all.
if (!entry) return new Response("Fant ikke medlemmet", { status: 404 });

const membersPath = `${orgPath(org.slug)}/medlemmer`;
const memberPath = `${membersPath}/${entry.member.id}`;

let values = memberContactFormValues(entry.member);
let fieldErrors: MemberContactFieldErrors = {};
let refunded: RefundResult | null = null;
let refundError: string | null = null;
let eraseError: string | null = null;

// Every action that worked answers with a redirect to this page, saying what
// was done in the address: the page then reads the member back as a plain
// GET, and a reload shows the member as they now are rather than doing the
// same thing again (specs/concepts/presenting-and-editing.md).
const done = (flags: Record<string, string>) =>
  Astro.redirect(`${memberPath}?${new URLSearchParams(flags).toString()}`, 303);

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const refundChargeId = String(form.get("refunder") ?? "");

  if (refundChargeId) {
    refundError = await refundPayment(refundChargeId);
    if (!refundError && refunded) {
      return done({
        refundert: String(refunded.refundedNok),
        avtale: refunded.arrangementEnded ? "avsluttet" : "var-avsluttet",
      });
    }
  } else if (form.get("slett")) {
    eraseError = await erasePersonalData();
    if (!eraseError) return done({ slettet: "1" });
  } else {
    const parsed = parseMemberContactForm(form);
    values = parsed.values;
    fieldErrors = parsed.fieldErrors;
    if (parsed.details) {
      await updateMemberContactDetails(db, org.id, entry.member.id, parsed.details);
      return done({ lagret: "1" });
    }
  }

  // A failed action still changes nothing, but the page is re-read all the
  // same so that it never shows a state older than the attempt.
  entry =
    (await getOrganizationMember(db, org.id, entry.member.id, periods.periodFor().year)) ?? entry;
  // A rejected save keeps what was typed; the other actions show what is stored.
  if (refundChargeId || form.get("slett")) values = memberContactFormValues(entry.member);
}

const flags = Astro.url.searchParams;
const saved = flags.has("lagret");
const erased = flags.has("slettet");
if (flags.has("refundert")) {
  refunded = {
    refundedNok: Number(flags.get("refundert")) || 0,
    arrangementEnded: flags.get("avtale") === "avsluttet",
  };
}

/**
 * Erase the person, keep what they paid (specs/use-cases/erase-member-data.md).
 *
 * Refused while the yearly arrangement still runs: ending that is the member's
 * own to do, from their Vipps app or their own page, and erasing somebody who
 * is still being charged would leave the organization taking money from a
 * person it can no longer name.
 */
async function erasePersonalData(): Promise<string | null> {
  if (!entry) return "Fant ikke medlemmet.";
  if (entry.renewing) {
    return "Medlemmet har en løpende avtale. Den må avsluttes først — det gjør medlemmet selv i Vipps-appen eller på sin egen medlemsside.";
  }
  const outcome = await anonymizeMember(db, entry.member.id).catch((error) => {
    console.error("could not erase member", error);
    return null;
  });
  if (!outcome) return "Vi fikk ikke slettet opplysningene nå. Prøv igjen om litt.";
  if (!outcome.erased && !outcome.member.anonymizedAt) {
    return "Vi fikk ikke slettet opplysningene nå. Prøv igjen om litt.";
  }
  return null;
}

/**
 * Give one payment back. Refuses anything that is not this organization's own
 * member's payment, and reports every failure in words an administrator can
 * act on — nothing is written down unless Vipps confirmed the money moved.
 */
async function refundPayment(vippsChargeId: string): Promise<string | null> {
  const charge = await findChargeByVippsId(db, vippsChargeId);
  if (!charge || charge.orgId !== org.id) return "Fant ikke betalingen.";
  const agreement = await getMembershipAgreement(db, charge.agreementId);
  if (!agreement || agreement.memberId !== entry?.member.id) return "Fant ikke betalingen.";

  const vipps = await getVippsForOrg(getWorkOS(), org.workosOrgId);
  if (!vipps) return "Organisasjonen mangler Vipps-oppsett, så vi kan ikke refundere herfra.";

  try {
    refunded = await refundMembershipPayment(db, vipps, agreement, charge);
    return null;
  } catch (error) {
    console.error("could not refund charge", error);
    if (error instanceof VippsApiError) {
      return "Vipps ville ikke refundere denne betalingen. Det kan være at den allerede er refundert, eller at salgsenheten er satt opp med samleoppgjør. Prøv igjen, eller sjekk betalingen i Vipps-portalen.";
    }
    return "Vi fikk ikke refundert betalingen nå. Prøv igjen om litt.";
  }
}

const payments = paymentViews(await listChargesForMember(db, entry.member.id));
const displayName = entry.member.name || entry.member.email || entry.member.phone || "Uten navn";
// A save closes the form again; anything still wrong keeps it open.
const editing = Object.keys(fieldErrors).length > 0 || flags.has("rediger");
// Money leaving is deliberate: the button asks, and only this confirmation
// screen can send the refund.
const confirming = refunded
  ? null
  : (payments.find(
      (payment) => payment.chargeId === Astro.url.searchParams.get("refunder") && !payment.refusal,
    ) ?? null);
// Erasing is irreversible in the same way, and asks in the same place: the
// link opens this confirmation, and only the confirmation can erase.
const erasing = !erased && !entry.member.anonymizedAt && Astro.url.searchParams.has("slett");
// Arrived from a search for a payment reference: the page points that payment out.
const sought = flags.get(PAYMENT_PARAM);
---

<Shell title={`${displayName} — ${org.name}`} frame={false}>
  <OrgScreen orgName={org.name} orgPath={orgPath(org.slug)} active="medlemmer" warnings={warnings} activeMembers={view.stats.activeMembers}>
    <MemberDetailScreen
      entry={entry}
      values={values}
      fieldErrors={fieldErrors}
      saved={saved}
      editing={editing}
      payments={payments}
      confirming={confirming}
      refunded={refunded}
      refundError={refundError}
      sought={sought}
      erasing={erasing}
      erased={erased}
      eraseError={eraseError}
      membersPath={membersPath}
      memberPath={memberPath}
    />
  </OrgScreen>
</Shell>
