---
import { listOrganizationMembers } from "@stottemedlem/db";
import MemberListScreen from "../../../../components/MemberListScreen.astro";
import OrgScreen from "../../../../components/OrgScreen.astro";
import Shell from "../../../../layouts/Shell.astro";
import { getDb } from "../../../../lib/db";
import { shareableJoinUrl } from "../../../../lib/joinLinks";
import { orgIdentity } from "../../../../lib/orgImages";
import { requireOrgView } from "../../../../lib/orgView";
import { periods } from "../../../../lib/periods";
import { orgPath } from "../../../../lib/workos";

// The organization's member list (specs/use-cases/curate-member-list.md).
const view = await requireOrgView(Astro.locals.session, Astro.params.slug, Astro.request);
if (!view) return Astro.redirect("/orgs");
const { org, warnings } = view;

const currentPeriod = periods.periodFor().year;
const members = await listOrganizationMembers(getDb(), org.id, currentPeriod);
---

<Shell title={`Medlemmer — ${org.name}`} frame={false}>
  <OrgScreen identity={orgIdentity(org)} publicUrl={shareableJoinUrl(org.slug)} orgPath={orgPath(org.slug)} active="medlemmer" warnings={warnings} activeMembers={view.stats.activeMembers}>
    <MemberListScreen
      members={members}
      search={Astro.url.searchParams.get("sok") ?? ""}
      filter={Astro.url.searchParams.get("status")}
      membersPath={`${orgPath(org.slug)}/medlemmer`}
      exportHref={`${orgPath(org.slug)}/medlemmer/eksport.csv`}
      printHref={`${orgPath(org.slug)}/medlemmer/medlemsbevis`}
      currentYear={currentPeriod}
    />
  </OrgScreen>
</Shell>
