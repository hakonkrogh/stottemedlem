---
import MembershipsScreen from "../../../../components/MembershipsScreen.astro";
import OrgScreen from "../../../../components/OrgScreen.astro";
import Shell from "../../../../layouts/Shell.astro";
import { orgIdentity } from "../../../../lib/orgImages";
import { requireOrgView } from "../../../../lib/orgView";
import { orgPath } from "../../../../lib/workos";

// The membership tab: the organization's whole offer in one place
// (specs/use-cases/set-up-supporting-membership.md).
const view = await requireOrgView(Astro.locals.session, Astro.params.slug, Astro.request);
if (!view) return Astro.redirect("/orgs");
const { org, tiers, warnings } = view;
// The membership form lands here after a save or an archive, and names what it
// did in the address, so the list can say so: the change is visible in the
// cards, but a change is confirmed in words as well.
const savedName = Astro.url.searchParams.get("lagret");
const archivedName = Astro.url.searchParams.get("arkivert");
---

<Shell title={`Medlemskap — ${org.name}`} frame={false}>
  <OrgScreen
    orgName={org.name}
    logoUrl={orgIdentity(org).logoUrl}
    orgPath={orgPath(org.slug)}
    active="medlemskap"
    warnings={warnings}
    activeMembers={view.stats.activeMembers}
  >
    <MembershipsScreen
      orgPath={orgPath(org.slug)}
      tiers={tiers}
      warnings={warnings}
      savedName={savedName}
      archivedName={archivedName}
    />
  </OrgScreen>
</Shell>
