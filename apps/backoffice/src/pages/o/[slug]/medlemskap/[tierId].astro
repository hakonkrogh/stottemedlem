---
import {
  archiveMembershipTier,
  createMembershipTier,
  tierMemberReach,
  updateMembershipTier,
} from "@stottemedlem/db";
import MembershipTierFormScreen from "../../../../components/MembershipTierFormScreen.astro";
import OrgScreen from "../../../../components/OrgScreen.astro";
import Shell from "../../../../layouts/Shell.astro";
import { getDb } from "../../../../lib/db";
import { getEmailSender } from "../../../../lib/email";
import {
  getTierTemplate,
  parseTierForm,
  type TierFieldErrors,
  type TierFormValues,
  tierFormValues,
} from "../../../../lib/membershipTiers";
import {
  type FeeChangeReach,
  feeChangeReach,
  type NoticeReport,
  sendOwedFeeChangeNotices,
} from "../../../../lib/notices";
import { requireOrgView } from "../../../../lib/orgView";
import { purgeOrgPublicPages } from "../../../../lib/publicPageCache";
import { repriceAgreements } from "../../../../lib/renewals";
import { getVippsForOrg } from "../../../../lib/vipps";
import { getWorkOS, orgPath } from "../../../../lib/workos";

// Creating and editing a membership tier are ONE mechanism on this subpage
// (specs/use-cases/set-up-supporting-membership.md): /medlemskap/ny creates,
// /medlemskap/<id> edits. The membership tab lists the stored tiers (as the
// same membership cards the public page shows) and links here — keeping the
// form apart from the list so the stored offer is never confused with a
// half-filled form. Successful saves land back on the list, where the change
// is visible.
const view = await requireOrgView(Astro.locals.session, Astro.params.slug, Astro.request);
if (!view) return Astro.redirect("/orgs");
const { org, tiers, warnings } = view;
const db = getDb();
const tiersPath = `${orgPath(org.slug)}/medlemskap`;

const tierId = Astro.params.tierId;
const isNew = tierId === "ny";
const tier = isNew ? null : (tiers.find((t) => t.id === tierId) ?? null);
if (!isNew && !tier) return Astro.redirect(tiersPath);

let values: TierFormValues = tier
  ? tierFormValues(tier)
  : { name: "", description: "", annualFee: "" };
let fieldErrors: TierFieldErrors = {};
let archiveError: string | null = null;

// A `?mal=<key>` link prefills the create form from a standard template —
// name and description only; the price is always the administrator's own, so
// the template's suggested amount appears as the fee placeholder, never a
// value (specs/concepts/membership-tier.md).
const template =
  isNew && Astro.request.method !== "POST"
    ? getTierTemplate(Astro.url.searchParams.get("mal"))
    : null;
if (template) {
  values = { name: template.name, description: template.description, annualFee: "" };
}
const feePlaceholder = String(template?.suggestedFeeNok ?? 300);

let notice: NoticeReport | null = null;
// Set when a fee change awaits the administrator's word: the save is parsed
// and valid, but nothing is stored yet (specs/use-cases/change-the-annual-fee.md).
let confirmFeeChange: (FeeChangeReach & { newFeeNok: number }) | null = null;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const action = String(form.get("action") ?? "save");

  if (action === "archive" && tier) {
    const archived = await archiveMembershipTier(db, org.id, tier.id);
    if (archived) {
      // The public pages serve a cached copy; clear this datacenter's copy so
      // the admin sees the change straight away (visitors self-heal on traffic).
      await purgeOrgPublicPages(org.slug, Astro.url.origin);
      return Astro.redirect(tiersPath);
    }
    archiveError =
      "Kunne ikke arkivere medlemskapet — organisasjonen må alltid tilby minst ett medlemskap.";
  } else if (action === "save") {
    const parsed = parseTierForm(form);
    values = parsed.values;
    fieldErrors = parsed.fieldErrors;
    if (parsed.input) {
      if (isNew) {
        await createMembershipTier(db, org.id, parsed.input);
      } else if (tier) {
        const feeChanged = parsed.input.annualFeeNok !== tier.annualFeeNok;
        // A fee change is not saved on the first press. The product will email
        // every affected member and offers no way out of that, so the
        // administrator is told the number first and chooses: go through with
        // it, or cancel the whole update (specs/use-cases/change-the-annual-fee.md).
        // Only a change nobody is on skips the question.
        if (feeChanged && form.get("bekreft") !== "1") {
          const reach = await feeChangeReach(db, org.id, tier.id, parsed.input.annualFeeNok);
          if (reach.toEmail + reach.unreachable > 0) {
            confirmFeeChange = { ...reach, newFeeNok: parsed.input.annualFeeNok };
          }
        }
        if (!confirmFeeChange) {
          await updateMembershipTier(db, org.id, tier.id, parsed.input);
          // Existing members move to the new fee at their next renewal
          // (specs/use-cases/change-the-annual-fee.md). The nightly job would
          // get there anyway; doing it now means the amount in members' Vipps
          // apps matches what the administrator just set, immediately.
          if (feeChanged) {
            const vipps = await getVippsForOrg(getWorkOS(), org.workosOrgId);
            if (vipps) {
              const { failed } = await repriceAgreements(db, vipps, org.id);
              // Failures are not fatal: tonight's run tries again.
              if (failed) console.warn(`${failed} agreement(s) not repriced yet for ${org.slug}`);
            }
            // Telling the members is not a side effect of the price change — it
            // is half of what a price change *is*
            // (specs/use-cases/change-the-annual-fee.md). Doing it here rather
            // than leaving it to tonight's run means the administrator learns
            // straight away who could not be reached, while they are still
            // thinking about the change. Anything that fails is still owed, and
            // the nightly run picks it up.
            notice = await sendOwedFeeChangeNotices(db, org, Astro.url.origin, getEmailSender());
          }
        }
      }
      if (!confirmFeeChange) {
        await purgeOrgPublicPages(org.slug, Astro.url.origin);
        // A price change is half a message to the members, so it lands on the
        // overview where that result is reported; anything else lands back on
        // the membership offer it just changed.
        return Astro.redirect(
          notice
            ? `${orgPath(org.slug)}?varslet=${notice.told}.${notice.unreachable + notice.failed}`
            : tiersPath,
        );
      }
    }
  }
}

const canArchive = !isNew && tiers.length > 1;
// What a price change would actually move — shown up front, before the
// administrator has typed anything (specs/use-cases/change-the-annual-fee.md).
const reach = tier ? await tierMemberReach(db, tier.id) : { members: 0, unreachable: 0 };
const activeMembers = reach.members;
const title = isNew ? "Legg til medlemskap" : `Endre ${tier?.name}`;
---

<Shell title={`${title} — ${org.name}`} frame={false}>
  <OrgScreen
    orgName={org.name}
    orgPath={orgPath(org.slug)}
    active="medlemskap"
    warnings={warnings}
    activeMembers={view.activeMembers}
  >
    <MembershipTierFormScreen
      orgName={org.name}
      tiersPath={tiersPath}
      title={title}
      isNew={isNew}
      values={values}
      fieldErrors={fieldErrors}
      feePlaceholder={feePlaceholder}
      archiveError={archiveError}
      canArchive={canArchive}
      activeMembers={activeMembers}
      currentFeeNok={tier?.annualFeeNok}
      unreachable={reach.unreachable}
      confirmFeeChange={confirmFeeChange}
    />
  </OrgScreen>
</Shell>
