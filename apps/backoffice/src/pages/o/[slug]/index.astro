---
import { ensureOrganization, getOrganizationBySlug } from "@stottemedlem/db";
import OrgOverviewScreen from "../../../components/OrgOverviewScreen.astro";
import OrgScreen from "../../../components/OrgScreen.astro";
import Shell from "../../../layouts/Shell.astro";
import { getDb } from "../../../lib/db";
import {
  shareableJoinTermsUrl,
  shareableJoinUrl,
  shareableQrCardUrl,
} from "../../../lib/joinLinks";
import { orgView } from "../../../lib/orgView";
import {
  env,
  getWorkOS,
  orgPath,
  orgSlug,
  SESSION_COOKIE,
  sessionCookieOptions,
} from "../../../lib/workos";

// The front tab of the org's back office. Resolves the persisted slug to the
// org row (backfilling rows for orgs that predate persisted slugs), verifies
// the signed-in user is a member, and shows the org's public URLs — the join
// page, salgsvilkår and QR card — plus everything that is not yet in order.
const session = Astro.locals.session;
if (!session) return Astro.redirect("/login");
const slug = Astro.params.slug;
if (!slug) return Astro.redirect("/orgs");

const workos = getWorkOS();
const db = getDb();
const { data: memberships } = await workos.userManagement.listOrganizationMemberships({
  userId: session.userId,
  statuses: ["active"],
  limit: 100,
});

let org = await getOrganizationBySlug(db, slug);
let membership: (typeof memberships)[number] | undefined;
if (org) {
  const workosOrgId = org.workosOrgId;
  membership = memberships.find((m) => m.organizationId === workosOrgId);
  if (!membership) return Astro.redirect("/orgs");
} else {
  // Legacy URL from before slugs were persisted: match on the name-derived
  // slug, backfill the row, and settle on its (possibly different) stored slug.
  membership = memberships.find((m) => orgSlug(m.organizationName) === slug);
  if (!membership) return Astro.redirect("/orgs");
  org = await ensureOrganization(db, membership.organizationId, membership.organizationName);
  if (org.slug !== slug) return Astro.redirect(orgPath(org.slug));
}

// Make the URL authoritative: if the session is scoped to a different org, switch
// into this one so the dashboard is bookmarkable and self-correcting.
if (session.organizationId !== membership.organizationId) {
  const sealed = Astro.cookies.get(SESSION_COOKIE)?.value;
  if (sealed) {
    const cookieSession = workos.userManagement.loadSealedSession({
      sessionData: sealed,
      cookiePassword: env.WORKOS_COOKIE_PASSWORD,
    });
    const refreshed = await cookieSession.refresh({
      organizationId: membership.organizationId,
      cookiePassword: env.WORKOS_COOKIE_PASSWORD,
    });
    if (refreshed.authenticated && refreshed.sealedSession) {
      Astro.cookies.set(SESSION_COOKIE, refreshed.sealedSession, sessionCookieOptions(Astro.url));
    }
  }
}

const displayName =
  [session.firstName, session.lastName].filter(Boolean).join(" ") || session.email;
const view = await orgView(org, Astro.request);

// Set by the membership form after a price change: how many members were told,
// and how many still have to be told by the organization itself
// (specs/use-cases/change-the-annual-fee.md).
const [told = 0, unreached = 0] = (Astro.url.searchParams.get("varslet") ?? "")
  .split(".")
  .map((part) => Number.parseInt(part, 10) || 0);
const feeNotice = Astro.url.searchParams.has("varslet") ? { told, unreached } : undefined;
---

<Shell title={org.name} frame={false}>
  <OrgScreen
    orgName={org.name}
    orgPath={orgPath(org.slug)}
    active="oversikt"
    warnings={view.warnings}
    activeMembers={view.activeMembers}
    displayName={displayName}
    canSwitch={memberships.length > 1}
  >
    <OrgOverviewScreen
      orgPath={orgPath(org.slug)}
      joinUrl={shareableJoinUrl(org.slug)}
      termsUrl={shareableJoinTermsUrl(org.slug)}
      qrCardUrl={shareableQrCardUrl(org.slug)}
      warnings={view.warnings}
      tiers={view.tiers}
      feeNotice={feeNotice}
    />
  </OrgScreen>
</Shell>
