---
import OrgScreen from "../../../components/OrgScreen.astro";
import VippsKeysScreen from "../../../components/VippsKeysScreen.astro";
import Shell from "../../../layouts/Shell.astro";
import { orgView, requireOrgView } from "../../../lib/orgView";
import { getVippsForOrg } from "../../../lib/vipps";
import {
  ensureWebhookRegistration,
  maskSecret,
  type OrgVippsKeys,
  parseVippsKeysForm,
  saveOrgVippsKeys,
  type VippsKeysFieldErrors,
  type VippsKeysFormValues,
  validateVippsKeys,
  vippsEnvironmentLabel,
} from "../../../lib/vippsKeys";
import { getWorkOS, orgPath } from "../../../lib/workos";

// The org's own Vipps API keys (specs/concepts/vipps-api-keys.md). An
// administrator pastes the sales unit's four credentials from
// portal.vippsmobilepay.com → For utviklere; we prove they work with a live,
// read-only call to Vipps before storing them encrypted per org in WorkOS
// Vault. One set of keys per org — which Vipps environment they must belong
// to follows from where this app runs (test everywhere except production).
let view = await requireOrgView(Astro.locals.session, Astro.params.slug, Astro.request);
if (!view) return Astro.redirect("/orgs");
const org = view.org;
const workosOrgId = org.workosOrgId;
const workos = getWorkOS();

let stored: OrgVippsKeys | null = view.vippsKeys;
let values: VippsKeysFormValues = {
  clientId: "",
  clientSecret: "",
  subscriptionKey: "",
  merchantSerialNumber: "",
};
let fieldErrors: VippsKeysFieldErrors = {};
let saved = false;
let retested = false;
let validationError: string | null = null;
let webhookConnected = false;
let webhookError: string | null = null;
// Only a rejected submission keeps the key form open; a failed re-test does not.
let formRejected = false;

// Where THIS deployment receives the org's payment events. Derived from the
// request, so production, staging and a local tunnel each register their own
// receiver against the same sales unit rather than stealing each other's.
const webhookUrl = view.webhookUrl;

// Connecting payment events is not the administrator's job: whenever keys are
// stored or re-proven, the registration is brought up to date on its own, and
// the scheduled runs keep doing so afterwards (specs/concepts/vipps-api-keys.md).
// An administrator who is looking at a broken connection can also ask for it
// now rather than waiting for the next run.
async function connectPaymentEvents(): Promise<void> {
  const vipps = await getVippsForOrg(workos, workosOrgId);
  try {
    if (!vipps) throw new Error("missing Vipps client");
    const ensured = await ensureWebhookRegistration(workos, workosOrgId, vipps, webhookUrl);
    if (ensured.outcome === "connected" && stored) {
      stored = { ...stored, webhook: ensured.webhook };
      webhookConnected = true;
    }
  } catch (error) {
    console.error("could not register webhooks", error);
    webhookError =
      "Vipps ville ikke registrere varslingsadressen nå — vi prøver igjen automatisk. " +
      "Du kan også prøve på nytt om litt.";
  }
}

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const intent = form.get("intent");
  if (intent === "webhook" && stored) {
    await connectPaymentEvents();
  } else if (intent === "test" && stored) {
    // Re-run the live check against the keys already in Vault.
    const result = await validateVippsKeys(stored);
    if (result.ok) {
      stored = { ...stored, validatedAt: new Date().toISOString() };
      await saveOrgVippsKeys(workos, workosOrgId, stored);
      retested = true;
      await connectPaymentEvents();
    } else {
      validationError = result.message;
    }
  } else {
    const parsed = parseVippsKeysForm(form);
    values = parsed.values;
    fieldErrors = parsed.fieldErrors;
    formRejected = true;
    if (parsed.keys) {
      const result = await validateVippsKeys(parsed.keys);
      if (result.ok) {
        stored = { ...parsed.keys, validatedAt: new Date().toISOString() };
        await saveOrgVippsKeys(workos, workosOrgId, stored);
        saved = true;
        values = { clientId: "", clientSecret: "", subscriptionKey: "", merchantSerialNumber: "" };
        formRejected = false;
        await connectPaymentEvents();
      } else {
        validationError = result.message;
      }
    }
  }
  // Keys or their event delivery may have changed — the chrome's badges say so.
  view = await orgView(org, Astro.request);
}

const date = (iso: string) => new Date(iso).toLocaleDateString("nb-NO");
const storedView = stored
  ? {
      merchantSerialNumber: stored.merchantSerialNumber,
      clientId: stored.clientId,
      clientSecretMasked: maskSecret(stored.clientSecret),
      subscriptionKeyMasked: maskSecret(stored.subscriptionKey),
      validatedDate: date(stored.validatedAt),
      webhookUrl: stored.webhook?.url ?? null,
      webhookRegisteredDate: stored.webhook ? date(stored.webhook.registeredAt) : null,
    }
  : null;
// A successful save closes the form; a rejected one keeps it open with what
// was typed.
const editing = formRejected || (Astro.url.searchParams.has("rediger") && !saved);
---

<Shell title={`Vipps-nøkler — ${org.name}`} frame={false}>
  <OrgScreen
    orgName={org.name}
    orgPath={orgPath(org.slug)}
    active="innstillinger"
    warnings={view.warnings}
    activeMembers={view.activeMembers}
  >
    <VippsKeysScreen
      orgName={org.name}
      orgPath={orgPath(org.slug)}
      envLabel={vippsEnvironmentLabel()}
      stored={storedView}
      editing={editing}
      values={values}
      fieldErrors={fieldErrors}
      expectedWebhookUrl={webhookUrl}
      saved={saved}
      retested={retested}
      validationError={validationError}
      webhookConnected={webhookConnected}
      webhookError={webhookError}
    />
  </OrgScreen>
</Shell>
