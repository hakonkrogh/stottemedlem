---
import { env } from "cloudflare:workers";
import { DPA_VERSION } from "@stottemedlem/core";
import {
  acceptDataProcessingAgreement,
  type OrganizationImages,
  type OrganizationProfile,
  updateOrganizationProfile,
} from "@stottemedlem/db";
import OrgScreen from "../../../components/OrgScreen.astro";
import OrgSettingsScreen from "../../../components/OrgSettingsScreen.astro";
import Shell from "../../../layouts/Shell.astro";
import { getDb } from "../../../lib/db";
import { applyImageField } from "../../../lib/orgImages";
import {
  type ProfileFieldErrors,
  parseProfileForm,
  profileFormValues,
} from "../../../lib/orgProfile";
import { orgView, requireOrgView } from "../../../lib/orgView";
import { purgeOrgPublicPages } from "../../../lib/publicPageCache";
import { getWorkOS, orgPath } from "../../../lib/workos";

// Org settings — the org's public details: the profile fields the join page
// and salgsvilkår show (specs/concepts/join-page.md), the name, and the
// optional visual identity (logo + banner image). What is stored is shown as
// information; `?rediger=1` opens the one form that changes it.
/** Parse a focal-point percentage from the form; null when absent/invalid. */
function parseFocusPercent(value: FormDataEntryValue | null): number | null {
  if (typeof value !== "string" || value.trim() === "") return null;
  const n = Number(value);
  if (!Number.isFinite(n)) return null;
  return Math.min(100, Math.max(0, Math.round(n)));
}

let view = await requireOrgView(Astro.locals.session, Astro.params.slug, Astro.request);
if (!view) return Astro.redirect("/orgs");
let org = view.org;
const workosOrgId = org.workosOrgId;

let values = profileFormValues(org);
let fieldErrors: ProfileFieldErrors = {};
let name = org.name;
let nameError: string | undefined;
let imageErrors: { logo?: string; banner?: string } = {};
let saved = false;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();

  // Accepting the agreement is its OWN form and must return before the profile
  // handling below — that path reads every profile field off the form, so
  // letting a one-field post fall through would blank the public profile
  // (specs/concepts/data-processing-agreement.md).
  if (form.get("godta") === "databehandleravtale") {
    org = (await acceptDataProcessingAgreement(getDb(), org.id, DPA_VERSION)) ?? org;
    // Redirect rather than re-render: the acceptance settles a warning in the
    // chrome, and a plain GET recomputes all of it without this page having to.
    return new Response(null, {
      status: 303,
      headers: { location: `${orgPath(org.slug)}/innstillinger#databehandleravtale` },
    });
  }

  const parsed = parseProfileForm(form);
  values = parsed.values;
  fieldErrors = parsed.fieldErrors;
  name = String(form.get("name") ?? "").trim();
  if (!name) nameError = "Skriv inn et navn på organisasjonen.";

  const logo = await applyImageField(env.MEDIA, org, "logo", form);
  const banner = await applyImageField(env.MEDIA, org, "banner", form);
  imageErrors = { logo: logo.error, banner: banner.error };

  const patch: Partial<OrganizationProfile> & { name?: string } & Partial<OrganizationImages> = {};
  if (parsed.profile) Object.assign(patch, parsed.profile);
  if (!nameError && name !== org.name) {
    // The WorkOS org is the identity source; keep its name mirrored.
    await getWorkOS().organizations.updateOrganization({ organization: workosOrgId, name });
    patch.name = name;
  }
  if (logo.key !== undefined) patch.logoKey = logo.key;
  if (banner.key !== undefined) patch.bannerKey = banner.key;

  // Banner focal point from the settings picker. Cleared with the banner;
  // otherwise saved whenever the form carries it (the picker always does when
  // a banner is shown).
  if (banner.key === null) {
    patch.bannerFocusX = null;
    patch.bannerFocusY = null;
  } else if (org.bannerKey || banner.key) {
    const focusX = parseFocusPercent(form.get("bannerFocusX"));
    const focusY = parseFocusPercent(form.get("bannerFocusY"));
    if (focusX !== null && focusY !== null) {
      patch.bannerFocusX = focusX;
      patch.bannerFocusY = focusY;
    }
  }

  if (Object.keys(patch).length > 0) {
    org = (await updateOrganizationProfile(getDb(), workosOrgId, patch)) ?? org;
  }
  saved = Object.keys(fieldErrors).length === 0 && !nameError && !logo.error && !banner.error;
  if (saved) {
    // The public pages serve a cached copy; clear this datacenter's copy so the
    // admin sees the change on their next look (visitors self-heal on traffic).
    await purgeOrgPublicPages(org.slug, Astro.url.origin);
    // The saved details may have settled a warning — recompute the chrome.
    view = await orgView(org, Astro.request);
    values = profileFormValues(org);
    name = org.name;
  }
}

// A save closes the form again; anything still wrong keeps it open.
const hasErrors =
  Object.keys(fieldErrors).length > 0 || !!nameError || !!imageErrors.logo || !!imageErrors.banner;
const editing = hasErrors || (Astro.url.searchParams.has("rediger") && !saved);
---

<Shell title={`Innstillinger — ${org.name}`} frame={false}>
  <OrgScreen
    orgName={org.name}
    orgPath={orgPath(org.slug)}
    active="innstillinger"
    warnings={view.warnings}
    activeMembers={view.activeMembers}
  >
    <OrgSettingsScreen
      org={org}
      orgPath={orgPath(org.slug)}
      editing={editing}
      values={values}
      fieldErrors={fieldErrors}
      name={name}
      nameError={nameError}
      imageErrors={imageErrors}
      saved={saved}
      vippsKeys={view.vippsKeys}
      paymentEventsConnected={view.vippsKeys?.webhook?.url === view.webhookUrl}
      warnings={view.warnings}
    />
  </OrgScreen>
</Shell>
