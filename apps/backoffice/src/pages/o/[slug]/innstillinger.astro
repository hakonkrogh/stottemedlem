---
import { env } from "cloudflare:workers";
import {
  getOrganizationBySlug,
  type OrganizationImages,
  type OrganizationProfile,
  updateOrganizationProfile,
} from "@stottemedlem/db";
import Alert from "@stottemedlem/ui/components/Alert.astro";
import Button from "@stottemedlem/ui/components/Button.astro";
import CardFooter from "@stottemedlem/ui/components/CardFooter.astro";
import Heading from "@stottemedlem/ui/components/Heading.astro";
import Stack from "@stottemedlem/ui/components/Stack.astro";
import Text from "@stottemedlem/ui/components/Text.astro";
import TextField from "@stottemedlem/ui/components/TextField.astro";
import TextLink from "@stottemedlem/ui/components/TextLink.astro";
import OrgImageFields from "../../../components/OrgImageFields.astro";
import OrgProfileFields from "../../../components/OrgProfileFields.astro";
import Shell from "../../../layouts/Shell.astro";
import { getDb } from "../../../lib/db";
import { applyImageField } from "../../../lib/orgImages";
import {
  type ProfileFieldErrors,
  parseProfileForm,
  profileFormValues,
} from "../../../lib/orgProfile";
import { purgeOrgPublicPages } from "../../../lib/publicPageCache";
import { getWorkOS, orgPath } from "../../../lib/workos";

// Org settings — the org's public details: the profile fields the landing page
// and salgsvilkår show (specs/concepts/org-landing-page.md), the name, and the
// optional visual identity (logo + banner image). Orgs created before a field
// was required complete it here, prompted by the dashboard banner.
/** Parse a focal-point percentage from the form; null when absent/invalid. */
function parseFocusPercent(value: FormDataEntryValue | null): number | null {
  if (typeof value !== "string" || value.trim() === "") return null;
  const n = Number(value);
  if (!Number.isFinite(n)) return null;
  return Math.min(100, Math.max(0, Math.round(n)));
}

const session = Astro.locals.session;
if (!session) return Astro.redirect("/login");
const slug = Astro.params.slug;
if (!slug) return Astro.redirect("/orgs");

const db = getDb();
let org = await getOrganizationBySlug(db, slug);
if (!org) return Astro.redirect("/orgs");
const workosOrgId = org.workosOrgId;

const { data: memberships } = await getWorkOS().userManagement.listOrganizationMemberships({
  userId: session.userId,
  statuses: ["active"],
  limit: 100,
});
if (!memberships.some((m) => m.organizationId === workosOrgId)) {
  return Astro.redirect("/orgs");
}

let values = profileFormValues(org);
let fieldErrors: ProfileFieldErrors = {};
let name = org.name;
let nameError: string | undefined;
let imageErrors: { logo?: string; banner?: string } = {};
let saved = false;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const parsed = parseProfileForm(form);
  values = parsed.values;
  fieldErrors = parsed.fieldErrors;
  name = String(form.get("name") ?? "").trim();
  if (!name) nameError = "Skriv inn et navn på organisasjonen.";

  const logo = await applyImageField(env.MEDIA, org, "logo", form);
  const banner = await applyImageField(env.MEDIA, org, "banner", form);
  imageErrors = { logo: logo.error, banner: banner.error };

  const patch: Partial<OrganizationProfile> & { name?: string } & Partial<OrganizationImages> = {};
  if (parsed.profile) Object.assign(patch, parsed.profile);
  if (!nameError && name !== org.name) {
    // The WorkOS org is the identity source; keep its name mirrored.
    await getWorkOS().organizations.updateOrganization({ organization: workosOrgId, name });
    patch.name = name;
  }
  if (logo.key !== undefined) patch.logoKey = logo.key;
  if (banner.key !== undefined) patch.bannerKey = banner.key;

  // Banner focal point from the settings picker. Cleared with the banner;
  // otherwise saved whenever the form carries it (the picker always does when
  // a banner is shown).
  if (banner.key === null) {
    patch.bannerFocusX = null;
    patch.bannerFocusY = null;
  } else if (org.bannerKey || banner.key) {
    const focusX = parseFocusPercent(form.get("bannerFocusX"));
    const focusY = parseFocusPercent(form.get("bannerFocusY"));
    if (focusX !== null && focusY !== null) {
      patch.bannerFocusX = focusX;
      patch.bannerFocusY = focusY;
    }
  }

  if (Object.keys(patch).length > 0) {
    org = (await updateOrganizationProfile(db, workosOrgId, patch)) ?? org;
  }
  saved = Object.keys(fieldErrors).length === 0 && !nameError && !logo.error && !banner.error;
  // The public pages serve a cached copy; clear this datacenter's copy so the
  // admin sees the change on their next look (visitors self-heal on traffic).
  if (saved) await purgeOrgPublicPages(org.slug, Astro.url.origin);
}
---

<Shell title={`Innstillinger — ${org.name}`}>
  <Stack gap="lg">
    <Stack gap="sm">
      <Heading>Innstillinger</Heading>
      <Text variant="lead">
        Dette vises på den offentlige siden til {org.name} og i salgsvilkårene — Vipps krever at
        organisasjonsnummer og kontakt er fylt ut. Logo og bannerbilde er valgfritt. Medlemskap
        og priser setter du opp under{" "}
        <TextLink href={`${orgPath(org.slug)}/medlemskap`}>Medlemskap</TextLink>.
      </Text>
    </Stack>
    {saved && <Alert variant="info">Lagret. Den offentlige siden oppdateres ved neste besøk.</Alert>}
    <form method="post" enctype="multipart/form-data">
      <Stack gap="lg">
        <TextField label="Navn" name="name" value={name} required error={nameError} />
        <OrgProfileFields values={values} fieldErrors={fieldErrors} />
        <OrgImageFields org={org} errors={imageErrors} />
        <Button block>Lagre</Button>
      </Stack>
    </form>
    <CardFooter>
      <TextLink href={orgPath(org.slug)}>Tilbake til oversikten</TextLink>
    </CardFooter>
  </Stack>
</Shell>
