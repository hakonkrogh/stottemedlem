---
import { joinEntryPointUrl } from "@stottemedlem/core";
import {
  archiveMembershipTier,
  createMembershipTier,
  getOrganizationBySlug,
  listMembershipTiers,
  updateMembershipTier,
} from "@stottemedlem/db";
import Alert from "@stottemedlem/ui/components/Alert.astro";
import Button from "@stottemedlem/ui/components/Button.astro";
import Card from "@stottemedlem/ui/components/Card.astro";
import CardFooter from "@stottemedlem/ui/components/CardFooter.astro";
import Heading from "@stottemedlem/ui/components/Heading.astro";
import Stack from "@stottemedlem/ui/components/Stack.astro";
import Text from "@stottemedlem/ui/components/Text.astro";
import TextField from "@stottemedlem/ui/components/TextField.astro";
import TextLink from "@stottemedlem/ui/components/TextLink.astro";
import Shell from "../../../layouts/Shell.astro";
import { getDb } from "../../../lib/db";
import {
  getTierTemplate,
  parseTierForm,
  TIER_TEMPLATES,
  type TierFieldErrors,
  type TierFormValues,
  tierFormValues,
} from "../../../lib/membershipTiers";
import { purgeOrgPublicPages } from "../../../lib/publicPageCache";
import { getWorkOS, orgPath } from "../../../lib/workos";

// Membership tiers (specs/concepts/membership-tier.md): the organization's
// catalogue of supporting-membership levels, managed here and shown on the
// public landing page and — via each tier's Vipps agreements — in the Vipps
// app. The product hosts this catalogue because Vipps has no product-catalogue
// API; the tier's stable key is what ties Vipps agreements back to it.
const session = Astro.locals.session;
if (!session) return Astro.redirect("/login");
const slug = Astro.params.slug;
if (!slug) return Astro.redirect("/orgs");

const db = getDb();
const org = await getOrganizationBySlug(db, slug);
if (!org) return Astro.redirect("/orgs");

const { data: memberships } = await getWorkOS().userManagement.listOrganizationMemberships({
  userId: session.userId,
  statuses: ["active"],
  limit: 100,
});
if (!memberships.some((m) => m.organizationId === org.workosOrgId)) {
  return Astro.redirect("/orgs");
}

const emptyValues: TierFormValues = { name: "", description: "", annualFee: "" };
let createValues = emptyValues;
let createErrors: TierFieldErrors = {};
// A `?mal=<key>` link prefills the add-form from a standard template — name
// and description only; the price is always the administrator's own, so the
// template's suggested amount appears as the fee placeholder, never a value.
const template =
  Astro.request.method === "POST" ? null : getTierTemplate(Astro.url.searchParams.get("mal"));
if (template) {
  createValues = { name: template.name, description: template.description, annualFee: "" };
}
const feePlaceholder = String(template?.suggestedFeeNok ?? 300);
// When an edit fails validation, that tier's form re-renders with the
// submitted values and errors; every other tier shows its stored state.
let editedTierId: string | null = null;
let editedValues: TierFormValues = emptyValues;
let editedErrors: TierFieldErrors = {};
let saved = false;
let archiveError: string | null = null;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const action = String(form.get("action") ?? "");
  const tierId = String(form.get("tierId") ?? "");

  if (action === "create") {
    const parsed = parseTierForm(form);
    if (parsed.input) {
      await createMembershipTier(db, org.id, parsed.input);
      saved = true;
    } else {
      createValues = parsed.values;
      createErrors = parsed.fieldErrors;
    }
  } else if (action === "update" && tierId) {
    const parsed = parseTierForm(form);
    if (parsed.input) {
      saved = (await updateMembershipTier(db, org.id, tierId, parsed.input)) !== null;
    } else {
      editedTierId = tierId;
      editedValues = parsed.values;
      editedErrors = parsed.fieldErrors;
    }
  } else if (action === "archive" && tierId) {
    saved = (await archiveMembershipTier(db, org.id, tierId)) !== null;
    if (!saved) {
      archiveError =
        "Kunne ikke arkivere medlemskapet — organisasjonen må alltid tilby minst ett medlemskap.";
    }
  }

  // The public pages serve a cached copy; clear this datacenter's copy so the
  // admin sees the change on their next look (visitors self-heal on traffic).
  if (saved) await purgeOrgPublicPages(org.slug, Astro.url.origin);
}

const tiers = await listMembershipTiers(db, org.id);
---

<Shell title={`Medlemskap — ${org.name}`}>
  <Stack gap="lg">
    <Stack gap="sm">
      <Heading>Medlemskap</Heading>
      <Text variant="lead">
        Typene støttemedlemskap {org.name} tilbyr — navn, beskrivelse og årlig kontingent. De
        vises på den offentlige siden, og navnet er det støttemedlemmet ser på avtalen i
        Vipps-appen. Prisendringer gjelder nye innmeldinger og fremtidige fornyelser.
      </Text>
    </Stack>
    {saved && <Alert variant="info">Lagret. Den offentlige siden oppdateres ved neste besøk.</Alert>}
    {archiveError && <Alert variant="error">{archiveError}</Alert>}
    {
      tiers.length === 0 && (
        <Text variant="muted">
          Ingen medlemskap ennå — legg til det første nedenfor, så får den offentlige siden en
          pris Vipps kan godkjenne.
        </Text>
      )
    }
    {
      tiers.map((tier) => {
        const edited = tier.id === editedTierId;
        const values = edited ? editedValues : tierFormValues(tier);
        const errors = edited ? editedErrors : {};
        return (
          <Card>
            <form method="post">
              <input type="hidden" name="tierId" value={tier.id} />
              <Stack gap="md">
                <TextField
                  label="Navn"
                  name="name"
                  id={`name-${tier.id}`}
                  value={values.name}
                  required
                  error={errors.name}
                />
                <TextField
                  label="Beskrivelse (valgfritt)"
                  name="description"
                  id={`description-${tier.id}`}
                  value={values.description}
                  placeholder="F.eks. hva medlemskapet betyr for organisasjonen"
                  error={errors.description}
                />
                <TextField
                  label="Årlig kontingent (kr)"
                  name="annualFee"
                  id={`annualFee-${tier.id}`}
                  value={values.annualFee}
                  placeholder="300"
                  required
                  error={errors.annualFee}
                />
                <Text variant="small">
                  Innmeldingslenke for dette medlemskapet:{" "}
                  <TextLink href={joinEntryPointUrl(org.slug, tier.key)}>
                    {joinEntryPointUrl(org.slug, tier.key)}
                  </TextLink>
                </Text>
                <div class="actions">
                  <Button name="action" value="update">Lagre</Button>
                  {
                    tiers.length > 1 && (
                      <Button variant="secondary" name="action" value="archive">Arkiver</Button>
                    )
                  }
                </div>
                <Text variant="small">
                  {tiers.length > 1 &&
                    "Arkivering fjerner medlemskapet fra den offentlige siden — historikken og eksisterende medlemmer beholdes. "}
                  Identifikatoren «{tier.key}» er fast og følger Vipps-avtalene til medlemskapet.
                </Text>
              </Stack>
            </form>
          </Card>
        );
      })
    }
    <Card>
      <form method="post" id="legg-til">
        <Stack gap="md">
          <Heading level={2}>Legg til medlemskap</Heading>
          <div class="templates">
            <Text variant="small">
              Start fra en mal — fyller ut navn og standardtekst, prisen setter du selv:
            </Text>
            <div class="template-buttons">
              {TIER_TEMPLATES.map((t) => (
                <Button variant="secondary" href={`?mal=${t.key}#legg-til`}>{t.name}</Button>
              ))}
            </div>
          </div>
          <TextField
            label="Navn"
            name="name"
            id="new-name"
            value={createValues.name}
            placeholder="F.eks. Støttemedlemskap"
            required
            error={createErrors.name}
          />
          <TextField
            label="Beskrivelse (valgfritt)"
            name="description"
            id="new-description"
            value={createValues.description}
            placeholder="F.eks. hva medlemskapet betyr for organisasjonen"
            error={createErrors.description}
          />
          <TextField
            label="Årlig kontingent (kr)"
            name="annualFee"
            id="new-annualFee"
            value={createValues.annualFee}
            placeholder={feePlaceholder}
            required
            error={createErrors.annualFee}
          />
          <Button name="action" value="create" block>Legg til</Button>
        </Stack>
      </form>
    </Card>
    <CardFooter>
      <TextLink href={orgPath(org.slug)}>Tilbake til oversikten</TextLink>
    </CardFooter>
  </Stack>
</Shell>

<style>
  .actions {
    display: flex;
    gap: 0.75rem;
  }
  .templates {
    display: grid;
    gap: 0.5rem;
  }
  .template-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
