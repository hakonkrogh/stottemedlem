---
import { env } from "cloudflare:workers";
import {
  listMessageableMembers,
  listOrgMessages,
  messageReach,
  type OrgMessageAudience,
  recordOrgMessage,
} from "@stottemedlem/db";
import ComposeMessageScreen from "../../../../components/ComposeMessageScreen.astro";
import Shell from "../../../../layouts/Shell.astro";
import { getDb } from "../../../../lib/db";
import type { OrgMessageJob } from "../../../../lib/messages";
import { requireOrgAccess } from "../../../../lib/orgAccess";
import { periods } from "../../../../lib/periods";
import { orgPath } from "../../../../lib/workos";

// Writing to the supporting members (specs/use-cases/keep-supporters-in-the-loop.md).
// This page only writes the message down and hands it to the queue — walking
// the whole register is the queue consumer's job (src/worker.ts), because
// sending to everyone is bigger than one request wants to be.
const org = await requireOrgAccess(Astro.locals.session, Astro.params.slug);
if (!org) return Astro.redirect("/orgs");

const db = getDb();
const messagesPath = `${orgPath(org.slug)}/meldinger`;

let values: { subject: string; body: string; audience: OrgMessageAudience } = {
  subject: "",
  body: "",
  audience: "active",
};
let fieldErrors: { subject?: string; body?: string } = {};
let mode: "edit" | "preview" = "edit";
let error: string | null = null;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const action = String(form.get("action") ?? "preview");
  values = {
    subject: String(form.get("subject") ?? "").trim(),
    body: String(form.get("body") ?? "")
      .replace(/\r\n/g, "\n")
      .trim(),
    audience: form.get("audience") === "all" ? "all" : "active",
  };
  fieldErrors = {
    subject: values.subject ? undefined : "Skriv et emne.",
    body: values.body ? undefined : "Skriv en melding.",
  };
  const valid = !fieldErrors.subject && !fieldErrors.body;

  if (action === "send" && valid) {
    const message = await recordOrgMessage(db, { orgId: org.id, ...values });
    const job: OrgMessageJob = {
      type: "org-message",
      slug: org.slug,
      messageId: message.id,
      origin: Astro.url.origin,
    };
    try {
      await env.ORG_MESSAGES.send(job);
      return Astro.redirect(`${messagesPath}/${message.id}`);
    } catch (queueError) {
      // The message row is recorded but nobody will walk it — say so rather
      // than showing a result page that would sit on "sending" forever.
      console.error("could not enqueue org message", queueError);
      error = "Meldingen ble ikke sendt — vi fikk ikke satt den i kø. Prøv igjen.";
      mode = "preview";
    }
  } else if (action === "preview" && valid) {
    mode = "preview";
  }
  // "edit", or anything invalid, falls through to the form with errors shown.
}

const everyone = await listMessageableMembers(db, org.id, periods.periodFor().year);
const reach = {
  active: messageReach(everyone, "active"),
  all: messageReach(everyone, "all"),
};
const previous = (await listOrgMessages(db, org.id)).slice(0, 20);
---

<Shell title={`Meldinger — ${org.name}`}>
  <ComposeMessageScreen
    orgName={org.name}
    values={values}
    fieldErrors={fieldErrors}
    reach={reach}
    mode={mode}
    previous={previous}
    messagesPath={messagesPath}
    backPath={orgPath(org.slug)}
    error={error}
  />
</Shell>
