---
// Frame for the PUBLIC org pages (/org/<slug>…): indexable (no robots noindex —
// Vipps' website verification must be able to read them), a single readable
// column on the warm brand background, and the mandatory subtle støttemedlem.no
// attribution (specs/concepts/brand-attribution.md: ø in visible text, punycode
// in the href).
import "@stottemedlem/ui/tokens.css";
import "@stottemedlem/ui/base.css";
import { CANONICAL_ORIGIN } from "@stottemedlem/core";

interface Props {
  title: string;
  description?: string;
  /**
   * Keep this page out of search results. The join page and its salgsvilkår
   * must stay indexable (Vipps' website verification reads them), but a
   * personal page — a receipt, a membership's own page — is for one visitor
   * and belongs to nobody else.
   */
  noindex?: boolean;
}
const { title, description, noindex } = Astro.props;
---

<html lang="no">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <slot />
    </main>
    <footer>
      Medlemssiden leveres av <a href={CANONICAL_ORIGIN}>støttemedlem.no</a>
    </footer>
  </body>
</html>

<style>
  body {
    /* WebKit (every iPhone browser) can lay out a page arriving from another
     * app — an email link, the Vipps redirect — against the collapsed browser
     * chrome, hiding the page top under the status bar. The document is not
     * scrolled (scrollY is 0; scripts cannot fix it, and a pageshow scrollTo
     * once shipped here yanked real readers instead — see PR #55's revert).
     * The one lever that helps is height: filling the largest-viewport size
     * guarantees a sliver of scroll range on even the shortest page, and that
     * first scroll snaps the chrome back and reveals the top. */
    min-height: 100vh;
    min-height: 100lvh;
  }
  main {
    width: 100%;
    max-width: 38rem;
    margin-inline: auto;
    padding: 3rem 1.25rem 2rem;
  }
  footer {
    max-width: 38rem;
    margin-inline: auto;
    padding: 1rem 1.25rem 2.5rem;
    font-size: 0.85rem;
    color: var(--sm-muted);
  }
  footer a {
    color: inherit;
  }
</style>
