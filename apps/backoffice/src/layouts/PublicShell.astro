---
// Frame for the PUBLIC org pages (/org/<slug>…): indexable (no robots noindex —
// Vipps' website verification must be able to read them), a single readable
// column on a white ground (the product's cream steps back where it presents
// an organization or a member, see specs/concepts/brand-palette.md), and the mandatory subtle støttemedlem.no
// attribution (specs/concepts/brand-attribution.md: ø in visible text, punycode
// in the href).
//
// A page that presents an organization hands it in as `org`, and the shell
// opens with its identity (specs/concepts/join-page.md): with a banner or a
// logo, as the full-width stage the page rises over; with neither, as the
// name alone at the top of the column.
import "@stottemedlem/ui/tokens.css";
import "@stottemedlem/ui/base.css";
import { CANONICAL_ORIGIN } from "@stottemedlem/core";
import LiveForms from "@stottemedlem/ui/components/LiveForms.astro";
import OrgIdentityHeader from "@stottemedlem/ui/components/OrgIdentityHeader.astro";
import type { OrgIdentity } from "../lib/orgImages";

interface Props {
  title: string;
  description?: string;
  /**
   * Keep this page out of search results. The join page and its salgsvilkår
   * must stay indexable (Vipps' website verification reads them), but a
   * personal page — a receipt, a membership's own page — is for one visitor
   * and belongs to nobody else.
   */
  noindex?: boolean;
  /**
   * The picture this page previews as when its address is pasted into a chat
   * or a social feed. A member's card is made to be shared, and a shared card
   * must show the card itself rather than a bare link
   * (specs/concepts/member-card.md).
   */
  previewImage?: string;
  previewImageAlt?: string;
  /** The organization this page presents, shown at its top. */
  org?: OrgIdentity;
}
const { title, description, noindex, previewImage, previewImageAlt, org } = Astro.props;
const onStage = Boolean(org && (org.bannerUrl || org.logoUrl));
---

<html lang="no">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    {
      previewImage && (
        <>
          <meta property="og:image" content={previewImage} />
          {previewImageAlt && <meta property="og:image:alt" content={previewImageAlt} />}
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:image" content={previewImage} />
        </>
      )
    }
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <LiveForms />
  </head>
  <body>
    {onStage && org && <OrgIdentityHeader {...org} layout="stage" />}
    <main class:list={[{ "on-stage": onStage }]}>
      {
        org && !onStage && (
          <div class="org-top">
            <OrgIdentityHeader {...org} />
          </div>
        )
      }
      <slot />
    </main>
    <footer>
      Medlemssiden leveres av <a href={CANONICAL_ORIGIN}>❤️ støttemedlem.no</a>
    </footer>
  </body>
</html>

<style is:global>
  /* The public pages stand on white, not on the product's cream
   * (specs/concepts/brand-palette.md): here the product presents someone
   * else, an organization or a member, and its own paper colour steps back.
   * Everything else in the palette stays as the tokens say. */
  :root {
    --sm-bg: #ffffff;
    /* How far the page rises over the foot of the organization's stage; the
     * stage keeps its name row clear of it. */
    --sm-stage-lift: clamp(1.75rem, 3vw, 2.75rem);
  }
</style>

<style>
  main {
    /* The reading column's side gutter, named so anything that needs to
     * relate to it can, instead of hard-coding a number that would drift. */
    --sm-page-gutter: 1.25rem;
    width: 100%;
    max-width: 38rem;
    margin-inline: auto;
    /* Generous air above and below the reading column. Nothing here moves the
     * page for the reader: where a page opens is the browser's business. */
    padding: 3.5rem var(--sm-page-gutter) 2rem;
  }
  /* Below a stage the page is a white sheet rising over the photo's foot:
   * the full width on a phone, the reading column's width (with room to
   * spare) once the screen is wider than that. The stage itself is the air
   * at the top. */
  main.on-stage {
    position: relative;
    z-index: 1;
    margin-top: calc(-1 * var(--sm-stage-lift));
    padding-top: 1.75rem;
    background: var(--sm-bg);
    border-radius: 1.5rem 1.5rem 0 0;
  }
  @media (min-width: 700px) {
    main.on-stage {
      max-width: calc(38rem + 5rem);
      padding-inline: calc(var(--sm-page-gutter) + 2.5rem);
    }
  }
  .org-top {
    margin-bottom: var(--sm-space-lg);
  }
  footer {
    max-width: 38rem;
    margin-inline: auto;
    padding: 1rem 1.25rem 6rem;
    font-size: 0.85rem;
    color: var(--sm-muted);
  }
  footer a {
    color: inherit;
  }
</style>
