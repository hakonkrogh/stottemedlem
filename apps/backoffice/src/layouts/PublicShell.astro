---
// Frame for the PUBLIC org pages (/org/<slug>…): indexable (no robots noindex —
// Vipps' website verification must be able to read them), a single readable
// column on the warm brand background, and the mandatory subtle støttemedlem.no
// attribution (specs/concepts/brand-attribution.md: ø in visible text, punycode
// in the href).
import "@stottemedlem/ui/tokens.css";
import "@stottemedlem/ui/base.css";
import { CANONICAL_ORIGIN } from "@stottemedlem/core";
import LiveForms from "@stottemedlem/ui/components/LiveForms.astro";

interface Props {
  title: string;
  description?: string;
  /**
   * Keep this page out of search results. The join page and its salgsvilkår
   * must stay indexable (Vipps' website verification reads them), but a
   * personal page — a receipt, a membership's own page — is for one visitor
   * and belongs to nobody else.
   */
  noindex?: boolean;
  /**
   * The picture this page previews as when its address is pasted into a chat
   * or a social feed. A member's card is made to be shared, and a shared card
   * must show the card itself rather than a bare link
   * (specs/concepts/member-card.md).
   */
  previewImage?: string;
  previewImageAlt?: string;
}
const { title, description, noindex, previewImage, previewImageAlt } = Astro.props;
---

<html lang="no">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    {
      previewImage && (
        <>
          <meta property="og:image" content={previewImage} />
          {previewImageAlt && <meta property="og:image:alt" content={previewImageAlt} />}
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:image" content={previewImage} />
        </>
      )
    }
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <LiveForms />
  </head>
  <body>
    <main>
      <slot />
    </main>
    <footer>
      Medlemssiden leveres av <a href={CANONICAL_ORIGIN}>❤️ støttemedlem.no</a>
    </footer>
  </body>
</html>

<style>
  main {
    /* The reading column's side gutter, named so anything that needs to
     * relate to it can, instead of hard-coding a number that would drift. */
    --sm-page-gutter: 1.25rem;
    width: 100%;
    max-width: 38rem;
    margin-inline: auto;
    /* Generous air above and below the reading column. Nothing here moves the
     * page for the reader: where a page opens is the browser's business. */
    padding: 3.5rem var(--sm-page-gutter) 2rem;
  }
  footer {
    max-width: 38rem;
    margin-inline: auto;
    padding: 1rem 1.25rem 6rem;
    font-size: 0.85rem;
    color: var(--sm-muted);
  }
  footer a {
    color: inherit;
  }
</style>
