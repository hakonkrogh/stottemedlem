---
// Frame for the PUBLIC org pages (/org/<slug>…): indexable (no robots noindex —
// Vipps' website verification must be able to read them), a single readable
// column on the warm brand background, and the mandatory subtle støttemedlem.no
// attribution (specs/concepts/brand-attribution.md: ø in visible text, punycode
// in the href).
import "@stottemedlem/ui/tokens.css";
import "@stottemedlem/ui/base.css";
import { CANONICAL_ORIGIN } from "@stottemedlem/core";

interface Props {
  title: string;
  description?: string;
  /**
   * Keep this page out of search results. The join page and its salgsvilkår
   * must stay indexable (Vipps' website verification reads them), but a
   * personal page — a receipt, a membership's own page — is for one visitor
   * and belongs to nobody else.
   */
  noindex?: boolean;
  /**
   * The picture this page previews as when its address is pasted into a chat
   * or a social feed. A member's card is made to be shared, and a shared card
   * must show the card itself rather than a bare link
   * (specs/concepts/member-card.md).
   */
  previewImage?: string;
  previewImageAlt?: string;
}
const { title, description, noindex, previewImage, previewImageAlt } = Astro.props;
---

<html lang="no">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    {
      previewImage && (
        <>
          <meta property="og:image" content={previewImage} />
          {previewImageAlt && <meta property="og:image:alt" content={previewImageAlt} />}
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:image" content={previewImage} />
        </>
      )
    }
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <script is:inline>
      // The arrival bug, fully diagnosed on-device (overlay videos,
      // 2026-08-28): ~150ms after load WebKit grows the LAYOUT viewport
      // upward under the status bar (innerHeight 683→757) while scrollY,
      // every visualViewport offset, and — even under viewport-fit=cover —
      // env(safe-area-inset-top) all read 0, and a programmatic scroll
      // change does not re-seat the chrome (only a real finger drag does).
      // So no browser API will name or undo the covered area — but its size
      // is measurable: the growth delta IS the covered status bar. Apply
      // that delta as top padding while the page sits untouched at scroll 0,
      // and withdraw it only when the viewport actually shrinks back
      // (the chrome re-seated), so the layout never shifts under a reader.
      (function () {
        var h0 = window.innerHeight;
        var touched = false;
        addEventListener("touchstart", function () { touched = true; }, { once: true, passive: true });
        addEventListener("DOMContentLoaded", function () {
          h0 = Math.min(h0, window.innerHeight);
        });
        var apply = function () {
          var delta = window.innerHeight - h0;
          var root = document.documentElement.style;
          if (!touched && window.scrollY === 0 && delta >= 20 && delta <= 120) {
            root.setProperty("--sm-arrival-inset", delta + "px");
          } else if (window.innerHeight <= h0 + 2) {
            root.setProperty("--sm-arrival-inset", "0px");
          }
        };
        [200, 400, 800, 1600, 3200].forEach(function (ms) { setTimeout(apply, ms); });
        addEventListener("resize", apply);
        if (window.visualViewport) window.visualViewport.addEventListener("resize", apply);
      })();
    </script>
  </head>
  <body>
    <main>
      <slot />
    </main>
    <footer>
      Medlemssiden leveres av <a href={CANONICAL_ORIGIN}>❤️ støttemedlem.no</a>
    </footer>
  </body>
</html>

<style>
  body {
    /* WebKit (every iPhone browser) can lay out a page arriving from another
     * app — an email link, the Vipps redirect — against the collapsed browser
     * chrome, hiding the page top under the status bar. The document is not
     * scrolled (scrollY is 0; scripts cannot fix it, and a pageshow scrollTo
     * once shipped here yanked real readers instead — see PR #55's revert).
     * The one lever that helps is height: filling the largest-viewport size
     * guarantees a sliver of scroll range on even the shortest page, and that
     * first scroll snaps the chrome back and reveals the top. */
    min-height: 100vh;
    min-height: 100lvh;
  }
  main {
    /* Published so content that is meant to run wider than the reading column
     * — the member's card on a phone — can cancel exactly this much padding
     * instead of hard-coding a number that would drift. */
    --sm-page-gutter: 1.25rem;
    width: 100%;
    max-width: 38rem;
    margin-inline: auto;
    padding: 3rem var(--sm-page-gutter) 2rem;
    /* The measured status-bar compensation from the arrival script in <head>:
     * 0 in the normal state, the viewport-growth delta when the arrival bug
     * lays the page out under the status bar. */
    padding-top: calc(3rem + var(--sm-arrival-inset, 0px));
  }
  footer {
    max-width: 38rem;
    margin-inline: auto;
    padding: 1rem 1.25rem 2.5rem;
    font-size: 0.85rem;
    color: var(--sm-muted);
  }
  footer a {
    color: inherit;
  }
</style>
