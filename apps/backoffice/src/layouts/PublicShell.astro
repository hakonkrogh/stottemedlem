---
// Frame for the PUBLIC org pages (/org/<slug>…): indexable (no robots noindex —
// Vipps' website verification must be able to read them), a single readable
// column on the warm brand background, and the mandatory subtle støttemedlem.no
// attribution (specs/concepts/brand-attribution.md: ø in visible text, punycode
// in the href).
import "@stottemedlem/ui/tokens.css";
import "@stottemedlem/ui/base.css";
import { CANONICAL_ORIGIN } from "@stottemedlem/core";

interface Props {
  title: string;
  description?: string;
  /**
   * Keep this page out of search results. The join page and its salgsvilkår
   * must stay indexable (Vipps' website verification reads them), but a
   * personal page — a receipt, a membership's own page — is for one visitor
   * and belongs to nobody else.
   */
  noindex?: boolean;
}
const { title, description, noindex } = Astro.props;
---

<html lang="no">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <script is:inline>
      // iOS Safari can hand over a page arriving from another app (an email
      // link, the Vipps redirect) with the viewport nudged down so the heading
      // sits under the status bar. On a page shorter than the screen there is
      // no scroll range to pull it back, so put the top back ourselves.
      addEventListener("pageshow", (event) => {
        if (event.persisted) return;
        const offset = window.visualViewport ? window.visualViewport.pageTop : 0;
        if (window.scrollY > 0 || offset > 0) window.scrollTo(0, 0);
      });
    </script>
  </head>
  <body>
    <main>
      <slot />
    </main>
    <footer>
      Medlemssiden leveres av <a href={CANONICAL_ORIGIN}>støttemedlem.no</a>
    </footer>
  </body>
</html>

<style>
  body {
    /* Fill the largest viewport state so mobile browsers always leave enough
     * scroll range to recover from a mis-restored offset (see the pageshow
     * handler), and the attribution footer sits at the bottom of the screen. */
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100lvh;
  }
  main {
    width: 100%;
    max-width: 38rem;
    margin-inline: auto;
    padding: 3rem 1.25rem 2rem;
    flex-grow: 1;
  }
  footer {
    width: 100%;
    max-width: 38rem;
    margin-inline: auto;
    padding: 1rem 1.25rem 2.5rem;
    font-size: 0.85rem;
    color: var(--sm-muted);
  }
  footer a {
    color: inherit;
  }
</style>
