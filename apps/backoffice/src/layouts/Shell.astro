---
// Back-office chrome: the warm brand background, and by default a single
// centered ScreenFrame for the narrow one-thing-at-a-time screens (sign-in,
// create org). Screens that bring their own frame — the organization's tabbed
// back office, which uses whatever width the display offers — pass
// `frame={false}` and lay themselves out from the top.
import "@stottemedlem/ui/tokens.css";
import "@stottemedlem/ui/base.css";
import ScreenFrame from "../components/ScreenFrame.astro";

interface Props {
  title: string;
  frame?: boolean;
}
const { title, frame = true } = Astro.props;
---

<html lang="no">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} — støttemedlem backoffice</title>
  </head>
  <body class:list={[{ centered: frame }]}>
    <main>
      {
        frame ? (
          <ScreenFrame>
            <slot />
          </ScreenFrame>
        ) : (
          <slot />
        )
      }
    </main>
  </body>
</html>

<style>
  body {
    min-height: 100dvh;
    display: grid;
    align-items: start;
    justify-items: center;
    padding: 1.5rem 1rem 3rem;
  }
  body.centered {
    align-items: center;
    padding: 2rem 1rem;
  }
  main {
    width: 100%;
  }
</style>
