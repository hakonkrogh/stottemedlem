---
// Back-office chrome: a vertically centered ScreenFrame on the warm brand
// background. All styling of the content itself comes from @stottemedlem/ui
// primitives — Shell only owns the page-level frame.
import "@stottemedlem/ui/tokens.css";
import "@stottemedlem/ui/base.css";
import ScreenFrame from "../components/ScreenFrame.astro";

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<html lang="no">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} — støttemedlem backoffice</title>
  </head>
  <body>
    <main>
      <ScreenFrame>
        <slot />
      </ScreenFrame>
    </main>
  </body>
</html>

<style>
  body {
    min-height: 100dvh;
    display: grid;
    place-items: center;
    padding: 2rem 1rem;
  }
  main {
    width: 100%;
  }
</style>
