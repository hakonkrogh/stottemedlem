---
// The member's card, shown (specs/concepts/member-card.md).
//
// Always the same drawing the member would share — the page embeds the card's
// own image rather than re-laying it out in HTML, so what someone sees here
// and what lands in a social feed can never drift apart. The alt text carries
// what the picture says, since the picture is the whole content.
//
// One card, one image (specs/concepts/member-card.md). The card is drawn
// upright for a phone, so there is nothing to choose between here — it simply
// scales inside the page's column, with air around it, and caps at a
// card-like width where there is room to spare.
//
// Sharing is offered ON the card rather than as a paragraph elsewhere on the
// page: the thing being shared is right there, so the action belongs on it.
//
// The card also checks itself here. A picture is painted once, and only the
// reader's browser can see what actually landed on it, so this is the only
// place a wordless card can be noticed at all (specs/concepts/member-card.md).
import { memberCardImagePath } from "@stottemedlem/core";
import { type MemberCardOptions, memberCardNameBand, memberCardSize } from "@stottemedlem/qr";

interface Props {
  cardToken: string;
  /**
   * Which version of the card to show (memberCardVersion). The picture is
   * embedded at an address that names its version, so a card that just gained
   * a heart is fetched afresh rather than served from the browser's copy of
   * the old one (specs/concepts/member-card.md).
   */
  version: string;
  alt: string;
  /**
   * The card's own public address. Passing it puts a share action on the card;
   * leaving it out shows the card alone. Only ever the CARD's address — the
   * member's self-service address can end the membership and must never be
   * offered for sharing (specs/concepts/member-self-service.md).
   */
  shareUrl?: string;
  /** What the share sheet calls it. */
  shareTitle?: string;
  /**
   * What the card says, so this can work out where its name strip landed and
   * check that the words are on the picture the reader got. Leaving it out
   * shows the card without that check.
   */
  words?: Pick<
    MemberCardOptions,
    "memberName" | "organizationName" | "hearts" | "recruits" | "lapsed"
  >;
  /** Which page is showing the card, for the report. Never an address: those carry the member's token. */
  surface?: "kvittering" | "min-side" | "medlemsbevis";
}
const { cardToken, version, alt, shareUrl, shareTitle, words, surface } = Astro.props;

const { width, height } = memberCardSize();
const band = words && surface ? memberCardNameBand(words) : null;
---

<figure class="member-card" style={`--sm-card-ratio: ${width} / ${height}`}>
  <img
    src={`${memberCardImagePath(cardToken, "svg")}?v=${version}`}
    alt={alt}
    width={width}
    height={height}
    data-card-version={band ? version : undefined}
    data-card-surface={band ? surface : undefined}
    data-card-name-band={band ? `${band.top} ${band.bottom} ${band.left} ${band.right}` : undefined}
  />

  {
    shareUrl && (
      <a
        class="member-card__share"
        href={shareUrl}
        data-share
        data-share-title={shareTitle}
        aria-label="Del medlemsbeviset"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path
            d="M12 3v12M12 3l-4 4M12 3l4 4M5 13v6a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-6"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
        <span data-share-label>Del</span>
      </a>
    )
  }
</figure>

<script>
  // Does the card the reader actually got have its words on it?
  //
  // The card is an `<img>`, so nothing on this page can look INSIDE it. What a
  // page can do is draw the picture it was handed onto a canvas and read the
  // pixels back, and that is enough to answer the one question worth asking:
  // is the strip where the member's name belongs blank?
  // (specs/concepts/member-card.md, specs/concepts/operational-alerting.md)
  //
  // It is a witness, not a guarantee. `drawImage` rasterizes the picture again
  // at the moment it is called, so a typeface that arrives late enough to spoil
  // the first paint but early enough to be ready here goes unseen. What it does
  // catch is the case that matters: a card whose words never come at all, which
  // is the card the reader is left holding.
  function checkCardHasWords(img: HTMLImageElement): void {
    const band = img.dataset.cardNameBand?.split(" ").map(Number);
    const surface = img.dataset.cardSurface;
    const version = img.dataset.cardVersion;
    if (!band || band.length !== 4 || band.some(Number.isNaN) || !surface || !version) return;
    const [top, bottom, left, right] = band as [number, number, number, number];

    // Small on purpose: enough pixels to see letters, few enough that reading
    // them back costs a phone nothing.
    const width = 240;
    const height = Math.round((width * img.naturalHeight) / img.naturalWidth);
    const canvas = document.createElement("canvas");
    canvas.width = width;
    canvas.height = height;
    const context = canvas.getContext("2d", { willReadFrequently: true });
    if (!context) return;
    context.fillStyle = "#fff";
    context.fillRect(0, 0, width, height);
    context.drawImage(img, 0, 0, width, height);

    /** How many pixels of a region are dark enough to be ink. */
    const ink = (x0: number, y0: number, x1: number, y1: number): number => {
      const w = Math.max(1, Math.round(x1 - x0));
      const h = Math.max(1, Math.round(y1 - y0));
      const { data } = context.getImageData(Math.round(x0), Math.round(y0), w, h);
      let dark = 0;
      for (let i = 0; i < data.length; i += 4) {
        // Rough luminance. The card is white paper; its words are near-black.
        const luminance = 0.299 * (data[i] ?? 255) + 0.587 * (data[i + 1] ?? 255) + 0.114 * (data[i + 2] ?? 255);
        if (luminance < 160) dark++;
      }
      return dark;
    };

    // A card with nothing on it anywhere never loaded; that is not this bug and
    // the operator must not hear about it. Only a card that DID draw, with a
    // blank name strip, is a card that lost its words.
    if (ink(0, 0, width, height) < 200) return;
    if (ink(left * width, top * height, right * width, bottom * height) >= 12) return;

    navigator.sendBeacon?.(
      "/api/card-without-words",
      // Nothing of the member travels: the surface, the card's public version
      // tag, and how wide it was drawn (specs/concepts/operational-alerting.md).
      new Blob([JSON.stringify({ surface, version, width: img.clientWidth })], {
        type: "application/json",
      }),
    );
  }

  for (const img of Array.from(
    document.querySelectorAll<HTMLImageElement>("img[data-card-name-band]"),
  )) {
    // Never let a check break a page: no card is worth less for being
    // unmeasurable, and a canvas the browser refuses to read back (or refuses
    // to let us touch at all) simply means no report.
    const check = () => {
      try {
        checkCardHasWords(img);
      } catch {
        /* unmeasurable, and that is fine */
      }
    };
    if (img.complete && img.naturalWidth > 0) check();
    else img.addEventListener("load", check, { once: true });
  }

  // Sharing the card, in whatever way the reader's device can: the phone's own
  // share sheet when it has one, the clipboard otherwise. With no script at
  // all the link still works — it opens the card, which is the address the
  // member wanted in the first place.
  // Bound on the document rather than on the link, so a card that LiveForms
  // swaps in after a form answer shares just the same.
  document.addEventListener("click", (event: MouseEvent) => {
    const anchor =
      event.target instanceof Element ? event.target.closest<HTMLAnchorElement>("a[data-share]") : null;
    if (!anchor) return;
    {
      const url = anchor.href;
      const title = anchor.dataset.shareTitle;
      const label = anchor.querySelector("[data-share-label]");

      if (navigator.share) {
        event.preventDefault();
        navigator.share(title ? { title, url } : { url }).catch(() => {});
        return;
      }
      if (!navigator.clipboard) return;

      event.preventDefault();
      navigator.clipboard.writeText(url).then(
        () => {
          if (!label) return;
          const previous = label.textContent;
          label.textContent = "Lenke kopiert";
          setTimeout(() => {
            label.textContent = previous;
          }, 2500);
        },
        () => {
          window.location.href = url;
        },
      );
    }
  });
</script>

<style>
  .member-card {
    position: relative;
    /* An object on the page, not the page itself: it keeps the reading
     * column's gutter on both sides and takes a little extra air above and
     * below, so it reads as a card lying on the page. It stops growing at a
     * card-like width: upright, the full 38rem column would make it over
     * 800px tall and it would read as a poster rather than as a card. */
    margin: 0.75rem auto;
    max-width: 24rem;
  }
  .member-card img {
    display: block;
    width: 100%;
    height: auto;
    /* The card's shape is known before the picture arrives, so its space is
     * reserved from the first paint and nothing below it jumps when the
     * drawing loads. */
    aspect-ratio: var(--sm-card-ratio);
  }

  .member-card__share {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--sm-border-strong);
    border-radius: 999px;
    background: var(--sm-surface);
    color: var(--sm-ink);
    font: inherit;
    font-size: 0.85rem;
    line-height: 1;
    text-decoration: none;
    box-shadow: 0 1px 4px rgba(80, 60, 30, 0.12);
  }
  .member-card__share:hover {
    background: var(--sm-accent-soft);
    border-color: var(--sm-accent-deep);
  }
  .member-card__share:focus-visible {
    outline: 3px solid var(--sm-focus-ring);
    outline-offset: 2px;
  }
  .member-card__share svg {
    width: 1em;
    height: 1em;
  }
</style>
