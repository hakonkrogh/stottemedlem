---
// The member's card, shown (specs/concepts/member-card.md).
//
// Always the same drawing the member would share — the page embeds the card's
// own image rather than re-laying it out in HTML, so what someone sees here
// and what lands in a social feed can never drift apart. The alt text carries
// what the picture says, since the picture is the whole content.
//
// One card, one image (specs/concepts/member-card.md). The card is drawn
// upright for a phone, so there is nothing to choose between here — it simply
// scales inside the page's column, with air around it, and caps at a
// card-like width where there is room to spare.
//
// Sharing is offered ON the card rather than as a paragraph elsewhere on the
// page: the thing being shared is right there, so the action belongs on it.
import { memberCardImagePath } from "@stottemedlem/core";
import { memberCardSize } from "@stottemedlem/qr";

interface Props {
  cardToken: string;
  alt: string;
  /**
   * The card's own public address. Passing it puts a share action on the card;
   * leaving it out shows the card alone. Only ever the CARD's address — the
   * member's self-service address can end the membership and must never be
   * offered for sharing (specs/concepts/member-self-service.md).
   */
  shareUrl?: string;
  /** What the share sheet calls it. */
  shareTitle?: string;
}
const { cardToken, alt, shareUrl, shareTitle } = Astro.props;

const { width, height } = memberCardSize();
---

<figure class="member-card">
  <img src={memberCardImagePath(cardToken, "svg")} alt={alt} width={width} height={height} />

  {
    shareUrl && (
      <a
        class="member-card__share"
        href={shareUrl}
        data-share
        data-share-title={shareTitle}
        aria-label="Del medlemsbeviset"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path
            d="M12 3v12M12 3l-4 4M12 3l4 4M5 13v6a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-6"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
        <span data-share-label>Del</span>
      </a>
    )
  }
</figure>

<script>
  // Sharing the card, in whatever way the reader's device can: the phone's own
  // share sheet when it has one, the clipboard otherwise. With no script at
  // all the link still works — it opens the card, which is the address the
  // member wanted in the first place.
  const links = document.querySelectorAll<HTMLAnchorElement>("a[data-share]");
  links.forEach((anchor) => {
    anchor.addEventListener("click", (event: MouseEvent) => {
      const url = anchor.href;
      const title = anchor.dataset.shareTitle;
      const label = anchor.querySelector("[data-share-label]");

      if (navigator.share) {
        event.preventDefault();
        navigator.share(title ? { title, url } : { url }).catch(() => {});
        return;
      }
      if (!navigator.clipboard) return;

      event.preventDefault();
      navigator.clipboard.writeText(url).then(
        () => {
          if (!label) return;
          const previous = label.textContent;
          label.textContent = "Lenke kopiert";
          setTimeout(() => {
            label.textContent = previous;
          }, 2500);
        },
        () => {
          window.location.href = url;
        },
      );
    });
  });
</script>

<style>
  .member-card {
    position: relative;
    /* An object on the page, not the page itself: it keeps the reading
     * column's gutter on both sides and takes a little extra air above and
     * below, so it reads as a card lying on the page. It stops growing at a
     * card-like width: upright, the full 38rem column would make it over
     * 800px tall and it would read as a poster rather than as a card. */
    margin: 0.75rem auto;
    max-width: 24rem;
  }
  .member-card img {
    display: block;
    width: 100%;
    height: auto;
  }

  .member-card__share {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--sm-border-strong);
    border-radius: 999px;
    background: var(--sm-surface);
    color: var(--sm-ink);
    font: inherit;
    font-size: 0.85rem;
    line-height: 1;
    text-decoration: none;
    box-shadow: 0 1px 4px rgba(80, 60, 30, 0.12);
  }
  .member-card__share:hover {
    background: var(--sm-accent-soft);
    border-color: var(--sm-accent-deep);
  }
  .member-card__share:focus-visible {
    outline: 3px solid var(--sm-focus-ring);
    outline-offset: 2px;
  }
  .member-card__share svg {
    width: 1em;
    height: 1em;
  }
</style>
