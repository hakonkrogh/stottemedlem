---
// Presentational create-organization screen, composed from @stottemedlem/ui
// primitives. Shared by the real route (pages/orgs/new.astro, which owns the
// POST handling) and its story, so the look can be iterated on without
// touching WorkOS logic. Besides the name it collects the identity part of the
// public profile (see OrgProfileFields) and the FIRST membership's annual fee:
// every organization states a minimal membership at creation — the default
// membership name at this fee — because Vipps evaluates the public page
// against a real, priced product. Everything about it can be changed later on
// the medlemskap page (specs/concepts/membership-tier.md).
import { DPA_PATH } from "@stottemedlem/core";
import Alert from "@stottemedlem/ui/components/Alert.astro";
import Button from "@stottemedlem/ui/components/Button.astro";
import CardFooter from "@stottemedlem/ui/components/CardFooter.astro";
import Checkbox from "@stottemedlem/ui/components/Checkbox.astro";
import Heading from "@stottemedlem/ui/components/Heading.astro";
import Stack from "@stottemedlem/ui/components/Stack.astro";
import Text from "@stottemedlem/ui/components/Text.astro";
import TextField from "@stottemedlem/ui/components/TextField.astro";
import TextLink from "@stottemedlem/ui/components/TextLink.astro";
import type { ProfileFieldErrors, ProfileFormValues } from "../lib/orgProfile";
import OrgProfileFields from "./OrgProfileFields.astro";

interface Props {
  name?: string;
  values?: ProfileFormValues;
  annualFee?: string;
  fieldErrors?: ProfileFieldErrors & {
    name?: string;
    annualFee?: string;
    godtarAvtale?: string;
    godtarTidligTilgang?: string;
  };
  /** Keep the tick when a rejected submission re-renders the form. */
  acceptedDpa?: boolean;
  /** Keep the early-access tick the same way. */
  acceptedEarlyAccess?: boolean;
  error?: string | null;
}
const {
  name = "",
  values = { orgnr: "", contactEmail: "", websiteUrl: "" },
  annualFee = "",
  fieldErrors = {},
  acceptedDpa = false,
  acceptedEarlyAccess = false,
  error = null,
} = Astro.props;
---

<Stack gap="lg">
  <Stack gap="sm">
    <Heading>Opprett organisasjon</Heading>
    <Text variant="lead">
      Gi organisasjonen et navn støttemedlemmene kjenner igjen. Resten vises på organisasjonens
      offentlige side sammen med navnet — den trenger Vipps for å godkjenne betalinger.
    </Text>
  </Stack>
  {/* Said before anything is filled in, not after: an organization should
      know what it is signing up for before it spends time on the form
      (specs/use-cases/sign-up-for-early-access.md). */}
  <Alert variant="info">
    <strong>støttemedlem.no er i tidlig tilgang.</strong> Det er gratis så lenge testfasen varer,
    og medlemmene betaler med ekte penger gjennom organisasjonens egen Vipps-avtale. Tjenesten er
    ny og endrer seg fortsatt, og noe kan svikte. Vi følger med og hjelper dere gjerne:{" "}
    <TextLink href="mailto:hei@xn--stttemedlem-hgb.no">hei@støttemedlem.no</TextLink>.
  </Alert>
  {error && <Alert variant="error">{error}</Alert>}
  <form method="post">
    <Stack gap="lg">
      <TextField
        label="Navn på organisasjonen"
        name="name"
        value={name}
        placeholder="F.eks. Bakvendtland Skolekorps"
        required
        autofocus
        error={fieldErrors.name}
      />
      <OrgProfileFields values={values} fieldErrors={fieldErrors} />
      <TextField
        label="Årlig kontingent for støttemedlemskapet (kr)"
        name="annualFee"
        value={annualFee}
        placeholder="300"
        required
        error={fieldErrors.annualFee}
      />
      <Text variant="small">
        Dette blir prisen på det første medlemskapet. Du kan endre navn og pris — og legge til
        flere typer medlemskap — når som helst etterpå.
      </Text>
      {/* An explicit tick, never a pre-ticked box and never a line of small
          print under the button: the administrator is taking on
          responsibility for other people's data, and should have to notice
          (specs/concepts/data-processing-agreement.md). It sits ABOVE the
          button, because a condition of pressing something belongs before it.
          The agreement is linked and readable without signing in. */}
      <Checkbox name="godtarAvtale" checked={acceptedDpa} required error={fieldErrors.godtarAvtale}>
        Jeg godtar <TextLink href={DPA_PATH}>databehandleravtalen</TextLink>: organisasjonen eier
        medlemsregisteret sitt, og støttemedlem.no behandler opplysningene bare på organisasjonens
        vegne.
      </Checkbox>
      {/* The second condition, ticked the same way: an organization joining
          a test phase should have noticed that it is one, since its own
          members will pay through it
          (specs/use-cases/sign-up-for-early-access.md). */}
      <Checkbox
        name="godtarTidligTilgang"
        checked={acceptedEarlyAccess}
        required
        error={fieldErrors.godtarTidligTilgang}
      >
        Jeg forstår at støttemedlem.no er i en testfase med tidlig tilgang: tjenesten er gratis
        foreløpig, den kan endre seg, og organisasjonen tar imot ekte betalinger gjennom sin egen
        Vipps-avtale.
      </Checkbox>
      <Button busy="Oppretter organisasjonen …" block>
        Opprett og fortsett
      </Button>
    </Stack>
  </form>
  <CardFooter>
    <TextLink href="/logout">Logg ut</TextLink>
  </CardFooter>
</Stack>
