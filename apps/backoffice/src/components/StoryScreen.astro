---
// STORY-ONLY wrapper: the very same OrgScreen chrome the app ships, with every
// link repointed at the story that shows where it leads. It exists so the
// tabbed back office can be reviewed by clicking through Storybook — tabs, edit
// buttons and back links included — without running the app, its login or its
// database. Nothing in the app imports it.
import type { OrgIdentity } from "../lib/orgImages";
import { type OrgTabId, orgTabs } from "../lib/orgNav";
import type { OrgWarning } from "../lib/orgWarnings";
import OrgScreen from "./OrgScreen.astro";
import {
  ACTIVE_MEMBERS,
  ADMIN_NAME,
  JOIN_URL,
  ORG_IDENTITY,
  ORG_PATH,
  storyHref,
  storyImageSrc,
} from "./storyFixtures";

interface Props {
  active: OrgTabId;
  warnings?: OrgWarning[];
  activeMembers?: number;
  /**
   * The organization as the chrome presents it, with logo and banner by
   * default: an organization that has been set up has both, and the chrome
   * is reviewed as such an organization sees it. Stories about one that has
   * uploaded nothing pass `storyIdentity(ORG)`.
   */
  identity?: OrgIdentity;
}
const {
  active,
  warnings = [],
  activeMembers = ACTIVE_MEMBERS,
  identity = ORG_IDENTITY,
} = Astro.props;

const tabs = orgTabs(ORG_PATH, warnings, activeMembers).map((tab) => ({
  ...tab,
  href: storyHref(tab.href),
}));
// The screen inside is rendered first, then every href it produced is looked up
// the same way — so a story never has to know which links its screen renders.
// The organization's images get the same treatment: their public addresses
// become the drawn fixtures.
const content = (await Astro.slots.render("default"))
  .replace(/href="(\/[^"]*)"/g, (_match: string, href: string) => `href="${storyHref(href)}"`)
  .replace(/src="(\/[^"]*)"/g, (_match: string, src: string) => `src="${storyImageSrc(src)}"`);
---

<OrgScreen
  identity={identity}
  publicUrl={JOIN_URL}
  orgPath={storyHref(ORG_PATH)}
  active={active}
  warnings={warnings}
  displayName={ADMIN_NAME}
  canSwitch
  tabs={tabs}
>
  <Fragment set:html={content} />
</OrgScreen>
