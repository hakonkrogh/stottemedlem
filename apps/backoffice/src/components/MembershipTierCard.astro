---
// THE membership card (specs/concepts/membership-tier.md, one-presentation
// rule): a tier is shown the same way on every surface — the public landing
// page and the back office alike — so the membership has one recognizable
// identity. Name, annual fee, optional description; surface-specific content
// (the public join CTA, the back office's edit hint) comes via the slot. The
// `fee` slot is for the join page, whose card opens around the price
// (JoinTierOffer); every other surface gets the plain price.
import Card from "@stottemedlem/ui/components/Card.astro";
import Heading from "@stottemedlem/ui/components/Heading.astro";
import Stack from "@stottemedlem/ui/components/Stack.astro";
import Text from "@stottemedlem/ui/components/Text.astro";
import MembershipTierPrice from "./MembershipTierPrice.astro";

interface Props {
  name: string;
  annualFeeNok: number;
  description?: string | null;
  /** Heading level of the tier name, so it nests correctly per surface. */
  headingLevel?: 2 | 3;
}
const { name, annualFeeNok, description, headingLevel = 2 } = Astro.props;
---

<div class="tier-card">
<Card>
  <Stack gap="md">
    <Heading level={headingLevel}>{name}</Heading>
    <slot name="fee">
      <MembershipTierPrice annualFeeNok={annualFeeNok} />
    </slot>
    {
      description && (
        <div class="description">
          <Text variant="muted">{description}</Text>
        </div>
      )
    }
    <slot />
  </Stack>
</Card>
</div>

<style>
  /* An ink outline with a hard offset shadow: the offer reads as the thing
     to act on, on the white public pages and the cream back office alike,
     and it never borrows the action green or the heart's red
     (specs/concepts/brand-palette.md). */
  .tier-card :global(.card) {
    border: 1.5px solid var(--sm-ink);
    box-shadow: 6px 6px 0 var(--sm-ink);
  }
  /* The organization writes the description with line breaks; show it as
     written. `white-space` inherits, so this reaches the slotted Text. */
  .description {
    white-space: pre-line;
  }
</style>
