---
// The public-profile fields every organization must fill so its landing page
// (specs/concepts/org-landing-page.md) can show what Vipps requires: org.nr
// and contact info. The membership offer (tiers with prices) is managed on the
// medlemskap page. Shared by the create-org screen and the org settings page.
import TextField from "@stottemedlem/ui/components/TextField.astro";
import type { ProfileFieldErrors, ProfileFormValues } from "../lib/orgProfile";

interface Props {
  values: ProfileFormValues;
  fieldErrors?: ProfileFieldErrors;
}
const { values, fieldErrors = {} } = Astro.props;
---

<TextField
  label="Organisasjonsnummer"
  name="orgnr"
  value={values.orgnr}
  placeholder="123 456 789"
  required
  error={fieldErrors.orgnr}
/>
<TextField
  label="Kontakt-e-post"
  name="contactEmail"
  value={values.contactEmail}
  placeholder="post@organisasjonen.no"
  required
  error={fieldErrors.contactEmail}
/>
