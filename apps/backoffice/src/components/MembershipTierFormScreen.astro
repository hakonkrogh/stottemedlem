---
// Creating and editing a membership tier are ONE mechanism
// (specs/use-cases/set-up-supporting-membership.md), kept apart from the list
// on the membership tab so the stored offer is never confused with a
// half-filled form.
import { MEMBERSHIP_TIER_DESCRIPTION_MAX_LENGTH } from "@stottemedlem/core";
import Alert from "@stottemedlem/ui/components/Alert.astro";
import Button from "@stottemedlem/ui/components/Button.astro";
import Heading from "@stottemedlem/ui/components/Heading.astro";
import Stack from "@stottemedlem/ui/components/Stack.astro";
import Text from "@stottemedlem/ui/components/Text.astro";
import TextArea from "@stottemedlem/ui/components/TextArea.astro";
import TextField from "@stottemedlem/ui/components/TextField.astro";
import TextLink from "@stottemedlem/ui/components/TextLink.astro";
import { TIER_TEMPLATES, type TierFieldErrors, type TierFormValues } from "../lib/membershipTiers";
import Subpage from "./Subpage.astro";

/**
 * A parsed, valid fee change waiting for the administrator's word — mirrors
 * lib/notices' FeeChangeReach (kept structural so this screen stays
 * Storybook-renderable without the worker-only libs).
 */
export interface FeeChangeConfirm {
  newFeeNok: number;
  /** Members the product will email about the change, with no way to opt out. */
  toEmail: number;
  /** Members moved by the change with no address — the organization's to reach. */
  unreachable: number;
}

interface Props {
  orgName: string;
  tiersPath: string;
  title: string;
  isNew: boolean;
  values: TierFormValues;
  fieldErrors?: TierFieldErrors;
  /** The template's suggested amount — a hint, never a value. */
  feePlaceholder: string;
  archiveError?: string | null;
  canArchive?: boolean;
  /** What a price change would move: who pays this tier today, at what fee. */
  activeMembers?: number;
  currentFeeNok?: number;
  /** Of those, how many the organization has no address for. */
  unreachable?: number;
  /**
   * When set, the save is on hold: the screen shows what pressing save sets in
   * motion — the members the product will email, with no opt-out — and offers
   * exactly two ways out: confirm, or cancel the whole update
   * (specs/use-cases/change-the-annual-fee.md).
   */
  confirmFeeChange?: FeeChangeConfirm | null;
}
const {
  orgName,
  tiersPath,
  title,
  isNew,
  values,
  fieldErrors = {},
  feePlaceholder,
  archiveError = null,
  canArchive = false,
  activeMembers = 0,
  currentFeeNok,
  unreachable = 0,
  confirmFeeChange = null,
} = Astro.props;

// Built in the frontmatter so no space is lost at an {expr} boundary.
const confirmLines = confirmFeeChange
  ? [
      `Du endrer årsbeløpet fra ${currentFeeNok} kr til ${confirmFeeChange.newFeeNok} kr.`,
      confirmFeeChange.toEmail > 0 &&
        `Vi sender e-post om endringen til ${confirmFeeChange.toEmail} ${
          confirmFeeChange.toEmail === 1 ? "støttemedlem" : "støttemedlemmer"
        } med én gang. Varselet kan ikke velges bort — hverken av deg eller av dem.`,
      confirmFeeChange.unreachable > 0 &&
        `${confirmFeeChange.unreachable} av de berørte har vi ingen e-postadresse til — dem må dere varsle selv.`,
    ].filter((line): line is string => Boolean(line))
  : [];
---

<Subpage backHref={tiersPath} backLabel="Tilbake til medlemskapene">
  <Stack gap="sm">
    <Heading level={2}>{title}</Heading>
    <Text variant="lead">
      Medlemskapet vises på den offentlige siden til {orgName}, og navnet er det støttemedlemmet ser
      på avtalen i Vipps-appen. Prisendringer gjelder nye innmeldinger og fremtidige fornyelser.
    </Text>
  </Stack>
  {
    /* The one decision point of a price change: nothing is saved yet, and the
       administrator chooses between exactly two doors — confirm knowing the
       members will be emailed, or cancel the whole update. The editable form
       stays hidden so the numbers being confirmed cannot drift meanwhile. */
    confirmFeeChange && (
      <section class="confirm">
        <Heading level={3}>Bekreft prisendringen</Heading>
        {confirmLines.map((line) => (
          <Text>{line}</Text>
        ))}
        <form method="post">
          <input type="hidden" name="name" value={values.name} />
          <input type="hidden" name="description" value={values.description} />
          <input type="hidden" name="annualFee" value={values.annualFee} />
          <input type="hidden" name="bekreft" value="1" />
          <Stack gap="sm">
            <Button name="action" value="save">Bekreft og lagre</Button>
            <Text variant="small">
              <TextLink href={tiersPath}>Avbryt — ingenting endres</TextLink>
            </Text>
          </Stack>
        </form>
      </section>
    )
  }
  {archiveError && <Alert variant="error">{archiveError}</Alert>}
  {
    !confirmFeeChange && activeMembers > 0 && (
      <Alert variant="info">
        {activeMembers} støttemedlem{activeMembers === 1 ? "" : "mer"} betaler i dag {currentFeeNok}{" "}
        kr i året for dette medlemskapet. Endrer du prisen, gjelder den for dem fra neste fornyelse
        ved årsskiftet — det de har betalt for i år, står. Vi sender dem en e-post om endringen med
        én gang, og ingen blir belastet en ny pris de ikke har visst om i minst to uker.
        {
          unreachable > 0 &&
            ` ${unreachable} av dem har vi ingen e-postadresse til — dem må dere si fra til selv.`
        }
      </Alert>
    )
  }
  {
    isNew && (
      <div class="templates">
        <Text variant="small">
          Start fra en mal — fyller ut navn og standardtekst, prisen setter du selv:
        </Text>
        <div class="template-buttons">
          {TIER_TEMPLATES.map((t) => (
            <Button variant="secondary" href={`?mal=${t.key}`}>
              {t.name}
            </Button>
          ))}
        </div>
      </div>
    )
  }
  {
    !confirmFeeChange && (
      <form method="post" class="form-column">
        <Stack gap="lg">
          <TextField
            label="Navn"
            name="name"
            value={values.name}
            required
            error={fieldErrors.name}
          />
          <TextArea
            label="Beskrivelse (valgfritt)"
            name="description"
            value={values.description}
            placeholder="F.eks. hva medlemskapet betyr for organisasjonen"
            maxlength={MEMBERSHIP_TIER_DESCRIPTION_MAX_LENGTH}
            hint={`Maks ${MEMBERSHIP_TIER_DESCRIPTION_MAX_LENGTH} tegn. Linjeskift er lov — teksten vises slik du skriver den på den offentlige siden, og forkortes til én linje på avtalen i Vipps-appen.`}
            error={fieldErrors.description}
          />
          <TextField
            label="Årlig kontingent (kr)"
            name="annualFee"
            value={values.annualFee}
            placeholder={feePlaceholder}
            required
            error={fieldErrors.annualFee}
          />
          <Button name="action" value="save" block>
            {isNew ? "Legg til" : "Lagre"}
          </Button>
        </Stack>
      </form>
    )
  }
  {
    !confirmFeeChange && canArchive && (
      <form method="post" class="form-column">
        <Stack gap="sm">
          <Button variant="secondary" name="action" value="archive" block>
            Arkiver medlemskapet
          </Button>
          <Text variant="small">
            Arkivering fjerner medlemskapet fra den offentlige siden — historikken og eksisterende
            medlemmer beholdes.
          </Text>
        </Stack>
      </form>
    )
  }
</Subpage>

<style>
  /* Wide screens give the panel room; a form still reads best in one column. */
  .form-column {
    max-width: 34rem;
  }
  /* Same shape as the refund confirmation on the member page: a decision box,
     not an error — hence the accent palette rather than the danger one. */
  .confirm {
    display: grid;
    gap: var(--sm-space-sm);
    padding: var(--sm-space-md);
    max-width: 34rem;
    background: var(--sm-accent-soft);
    border: 1px solid var(--sm-border-strong);
    border-radius: var(--sm-radius-md);
  }
  .confirm form {
    justify-self: start;
  }
  .templates {
    display: grid;
    gap: 0.5rem;
    max-width: 34rem;
  }
  .template-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
