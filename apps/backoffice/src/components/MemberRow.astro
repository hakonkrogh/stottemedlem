---
// One line of the member list (specs/use-cases/curate-member-list.md). Status
// is the loudest thing on the row, because "who is current" is the question
// the list exists to answer; the whole row is the link to the member.
import { periodLabel } from "@stottemedlem/core";
import { type MemberOverview, memberStanding } from "@stottemedlem/db";
import { standingDescription, standingLabel } from "../lib/memberStanding";

interface Props {
  entry: MemberOverview;
  href: string;
}
const { entry, href } = Astro.props;
const { member, latest, status } = entry;

// A supporter may consent to a name and nothing else, or to no name at all.
// Whatever we have, show something a person can recognize rather than an id.
const displayName = member.name || member.email || member.phone || "Uten navn";
const contact = member.name ? (member.email ?? member.phone) : member.phone;
// Where they stand, as one word (specs/use-cases/curate-member-list.md).
// Someone recorded but with no completed payment is not lapsed — they have
// never been current. Calling that "Utløpt" would read as a member who left.
// And a member whose arrangement has ended is not lapsed either: they are
// active until their paid period runs out, and the one to talk to now.
const standing = memberStanding(entry);
const label = standingLabel[standing];
const period = latest
  ? status === "active"
    ? `Betalt for ${periodLabel(latest.periodYear)}`
    : `Siste periode ${periodLabel(latest.periodYear)}`
  : "Ingen periode betalt ennå";
// A member with no address is one the product cannot tell about a price
// change, so the organization has to (specs/concepts/member-notice.md). It is
// only worth flagging while they are still paying.
const unreachable = status === "active" && !member.email?.trim();
// One heart per supported year (specs/concepts/scorecard.md) — as a count here,
// so loyalty is visible at a glance without stretching the row. Built in the
// frontmatter: a space next to an {expr} in the template is unreliable.
const heartsLabel = entry.hearts > 0 ? `❤️ ${entry.hearts}` : null;
const heartsTitle =
  entry.hearts === 1 ? "Ett år som støttemedlem" : `${entry.hearts} år som støttemedlem`;
// Word of mouth made visible (specs/concepts/scorecard.md): the organization
// can only thank its best recruiters if it can see them. A zero says nothing,
// so it is left out.
// Bound to the hearts with a middle dot: the two halves of the scorecard read
// as one thing, and the row stays short enough not to wrap.
const recruitsLabel = entry.recruits > 0 ? `· vervet ${entry.recruits}` : null;
const recruitsTitle =
  entry.recruits === 1 ? "Har vervet ett medlem" : `Har vervet ${entry.recruits} medlemmer`;
---

<a class="row" href={href}>
  <span class="name">{displayName}</span>
  {contact && <span class="contact">{contact}</span>}
  <span class="meta">
    <span class:list={["pill", standing]} title={standingDescription[standing]}>{label}</span>
    {heartsLabel && (
      <span class="hearts" title={heartsTitle}>
        {heartsLabel}
      </span>
    )}
    {recruitsLabel && (
      <span class="recruits" title={recruitsTitle}>
        {recruitsLabel}
      </span>
    )}
    <span class="period">{period}</span>
    {unreachable && <span class="pill unreachable">Ingen e-post</span>}
  </span>
</a>

<style>
  .row {
    display: grid;
    gap: 0.3rem;
    padding: 0.75rem 1rem;
    background: var(--sm-surface);
    border: 1px solid var(--sm-border);
    border-radius: var(--sm-radius-md);
    color: inherit;
    text-decoration: none;
  }
  .row:hover,
  .row:focus-visible {
    border-color: var(--sm-accent);
  }
  .row:focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px var(--sm-focus-ring);
  }
  .name {
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  .contact,
  .period {
    font-size: 0.85rem;
    color: var(--sm-muted);
    overflow-wrap: anywhere;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.15rem;
  }
  .hearts {
    font-size: 0.85rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .recruits {
    font-size: 0.8rem;
    color: var(--sm-muted);
    white-space: nowrap;
  }
  .pill {
    padding: 0.15rem 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    border-radius: 999px;
    border: 1px solid transparent;
    white-space: nowrap;
  }
  .pill.renewing {
    color: var(--sm-success);
    background: var(--sm-success-bg);
    border-color: var(--sm-success-border);
  }
  /* Still active, but on its way out — the product's amber, because this is
     something to notice and act on, not something that went wrong. */
  .pill.ending {
    color: var(--sm-accent-deep);
    background: var(--sm-accent-soft);
    border-color: var(--sm-accent);
  }
  .pill.unreachable {
    color: var(--sm-muted);
    background: transparent;
    border-color: var(--sm-border-strong);
    border-style: dashed;
  }
  .pill.lapsed,
  .pill.unpaid {
    color: var(--sm-muted);
    background: var(--sm-bg);
    border-color: var(--sm-border-strong);
  }
</style>
