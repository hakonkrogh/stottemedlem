---
// A member's hearts laid out like a game HUD: one ❤️ per supported annual
// period, filling a row of ten before a new row starts underneath
// (specs/concepts/scorecard.md). The count is derived by the caller — this
// component only draws it, and draws nothing when there is nothing yet.
interface Props {
  /** Supported annual periods — one heart each. */
  count: number;
}
const HEARTS_PER_ROW = 10;
const { count } = Astro.props;
const rows: string[] = [];
for (let left = count; left > 0; left -= HEARTS_PER_ROW) {
  rows.push("❤️".repeat(Math.min(left, HEARTS_PER_ROW)));
}
// The hearts are a picture of a number; the number is what a screen reader gets.
const label =
  count === 1
    ? "Ett hjerte — ett år som støttemedlem"
    : `${count} hjerter — ett per år som støttemedlem`;
---

{
  count > 0 && (
    <p class="hearts" role="img" aria-label={label}>
      {rows.map((row) => (
        <span class="row" aria-hidden="true">
          {row}
        </span>
      ))}
    </p>
  )
}

<style>
  .hearts {
    margin: 0;
    display: grid;
    justify-items: start;
    gap: 0.1rem;
  }
  .row {
    font-size: 1.2rem;
    letter-spacing: 0.3rem;
    line-height: 1.3;
    white-space: nowrap;
  }
</style>
