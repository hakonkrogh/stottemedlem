---
// One supporting member: who they are, every period they have supported, and
// the one thing an administrator may change — how to reach them
// (specs/use-cases/curate-member-list.md). Nothing here can make somebody a
// member or stop them being one; that follows from payment alone.
import { periodLabel } from "@stottemedlem/core";
import type { MemberOverview, Membership } from "@stottemedlem/db";
import Alert from "@stottemedlem/ui/components/Alert.astro";
import Button from "@stottemedlem/ui/components/Button.astro";
import Card from "@stottemedlem/ui/components/Card.astro";
import CardFooter from "@stottemedlem/ui/components/CardFooter.astro";
import Heading from "@stottemedlem/ui/components/Heading.astro";
import Stack from "@stottemedlem/ui/components/Stack.astro";
import Text from "@stottemedlem/ui/components/Text.astro";
import TextField from "@stottemedlem/ui/components/TextField.astro";
import TextLink from "@stottemedlem/ui/components/TextLink.astro";
import type { MemberContactFieldErrors, MemberContactFormValues } from "../lib/memberContact";

interface Props {
  entry: MemberOverview & { history: Membership[] };
  values: MemberContactFormValues;
  fieldErrors?: MemberContactFieldErrors;
  saved?: boolean;
  membersPath: string;
}
const { entry, values, fieldErrors = {}, saved = false, membersPath } = Astro.props;
const { member, latest, status, renewing, history } = entry;

const displayName = member.name || member.email || member.phone || "Uten navn";
const standing =
  status === "active"
    ? `Aktivt støttemedlem, betalt for ${latest ? periodLabel(latest.periodYear) : ""}.`
    : latest
      ? `Utløpt medlemskap — siste betalte periode var ${periodLabel(latest.periodYear)}.`
      : "Ingen betalt periode ennå.";
// Whether support continues is a different question from whether it is current:
// someone who has ended the arrangement stays a member until the year runs out.
const continuation = renewing
  ? "Den årlige avtalen løper, så neste periode kommer av seg selv."
  : latest
    ? "Den årlige avtalen er avsluttet, så medlemskapet fornyes ikke."
    : "";
// Joined in the frontmatter: an Astro template collapses the space between
// text and an expression that a formatter has put on separate lines.
const lead = [standing, continuation].filter(Boolean).join(" ");
const totalPaid = history.reduce((sum, period) => sum + period.paidNok, 0);
---

<Stack gap="lg">
  <Stack gap="sm">
    <Heading>{displayName}</Heading>
    <Text variant="lead">{lead}</Text>
  </Stack>

  {saved && <Alert variant="success">Kontaktopplysningene er oppdatert.</Alert>}

  <Stack gap="sm">
    <Heading level={2}>Kontaktopplysninger</Heading>
    <Text variant="small">
      Hentet fra Vipps-profilen da medlemmet meldte seg inn. Rett dem gjerne — det endrer ingenting
      ved hva som er betalt.
    </Text>
    <form method="post">
      <Stack gap="md">
        <TextField label="Navn" name="name" value={values.name} error={fieldErrors.name} />
        <TextField
          label="E-post"
          name="email"
          type="email"
          value={values.email}
          error={fieldErrors.email}
        />
        <TextField
          label="Telefon"
          name="phone"
          type="tel"
          value={values.phone}
          error={fieldErrors.phone}
        />
        <Button block>Lagre</Button>
      </Stack>
    </form>
  </Stack>

  <Stack gap="sm">
    <Heading level={2}>Støttehistorikk</Heading>
    {
      history.length === 0 ? (
        <Text variant="muted">Ingen perioder er betalt ennå.</Text>
      ) : (
        <>
          <Text variant="small">
            {history.length === 1 ? "Én periode" : `${history.length} perioder`}, til sammen{" "}
            {totalPaid} kr.
          </Text>
          <Card>
            <ul class="history">
              {history.map((period) => (
                <li>
                  <span class="year">{periodLabel(period.periodYear)}</span>
                  <span class="tier">{period.tierName}</span>
                  <span class="paid">{period.paidNok} kr</span>
                </li>
              ))}
            </ul>
          </Card>
        </>
      )
    }
  </Stack>

  <CardFooter>
    <TextLink href={membersPath}>← Tilbake til medlemslisten</TextLink>
  </CardFooter>
</Stack>

<style>
  .history {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .history li {
    display: flex;
    align-items: baseline;
    gap: var(--sm-space-sm);
  }
  .year {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .tier {
    color: var(--sm-muted);
    overflow-wrap: anywhere;
  }
  .paid {
    margin-left: auto;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
</style>
