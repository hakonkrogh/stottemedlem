---
// One supporting member: who they are, every period they have supported, what
// was actually paid, and what an administrator may do about it — correct how
// to reach them (specs/use-cases/curate-member-list.md), and give a payment
// back (specs/use-cases/refund-a-payment.md). Nothing here sets a status by
// hand: a refund moves money, and the status follows it.
//
// The recorded details are PRESENTED; correcting them and refunding are
// deliberate actions behind a button, so looking someone up never means facing
// a form — and never means being one slip away from moving money.
import { periodLabel } from "@stottemedlem/core";
import type { MemberOverview, Membership } from "@stottemedlem/db";
import Alert from "@stottemedlem/ui/components/Alert.astro";
import Button from "@stottemedlem/ui/components/Button.astro";
import Heading from "@stottemedlem/ui/components/Heading.astro";
import InfoList from "@stottemedlem/ui/components/InfoList.astro";
import Stack from "@stottemedlem/ui/components/Stack.astro";
import Text from "@stottemedlem/ui/components/Text.astro";
import TextField from "@stottemedlem/ui/components/TextField.astro";
import TextLink from "@stottemedlem/ui/components/TextLink.astro";
import type { MemberContactFieldErrors, MemberContactFormValues } from "../lib/memberContact";
import type { RefundResult } from "../lib/membership";
import type { PaymentView, RefundRefusal } from "../lib/refunds";
import HeartRows from "./HeartRows.astro";
import Subpage from "./Subpage.astro";

interface Props {
  entry: MemberOverview & { history: Membership[] };
  values: MemberContactFormValues;
  fieldErrors?: MemberContactFieldErrors;
  saved?: boolean;
  /** Open the contact form instead of presenting what is recorded. */
  editing?: boolean;
  /** Every payment ever attempted for this member, newest first. */
  payments?: PaymentView[];
  /** The payment whose refund is waiting to be confirmed, if any. */
  confirming?: PaymentView | null;
  /** What a refund just did, once it has actually happened. */
  refunded?: RefundResult | null;
  /** Why a refund did not happen, in words the administrator can act on. */
  refundError?: string | null;
  membersPath: string;
  /** This member's own address, which the edit action opens. */
  memberPath: string;
}
const {
  entry,
  values,
  fieldErrors = {},
  saved = false,
  editing = false,
  payments = [],
  confirming = null,
  refunded = null,
  refundError = null,
  membersPath,
  memberPath,
} = Astro.props;
const { member, latest, status, renewing, history } = entry;

const displayName = member.name || member.email || member.phone || "Uten navn";
const standing =
  status === "active"
    ? `Aktivt støttemedlem, betalt for ${latest ? periodLabel(latest.periodYear) : ""}.`
    : latest
      ? `Utløpt medlemskap — siste betalte periode var ${periodLabel(latest.periodYear)}.`
      : "Ingen betalt periode ennå.";
// Whether support continues is a different question from whether it is current:
// someone who has ended the arrangement stays a member until the year runs out.
const continuation = renewing
  ? "Den årlige avtalen løper, så neste periode kommer av seg selv."
  : latest
    ? "Den årlige avtalen er avsluttet, så medlemskapet fornyes ikke."
    : "";
// Joined in the frontmatter: an Astro template collapses the space between
// text and an expression that a formatter has put on separate lines.
const lead = [standing, continuation].filter(Boolean).join(" ");
const totalPaid = history.reduce((sum, period) => sum + period.paidNok, 0);

// What became of each payment, and — where it cannot be given back — why not.
// Both are stated, because a missing button with no explanation reads as a
// product that forgot rather than one that knows.
const paymentWord: Record<PaymentView["state"], string> = {
  paid: "Betalt",
  refunded: "Refundert",
  "partly-refunded": "Delvis refundert",
  pending: "Underveis",
  failed: "Mislyktes",
};
const refusalWord: Record<RefundRefusal, string> = {
  "already-refunded": "Allerede refundert",
  "not-captured": "Ingen penger å refundere",
  "too-old": "Eldre enn ett år — Vipps refunderer ikke",
};
// Two payments can share a period and an amount — the same person joining
// twice, or a renewal priced like the join. What tells them apart is what kind
// of payment each one was and the day it was taken, so both are always shown
// beside a button that moves money.
const typeWord: Record<PaymentView["type"], string> = {
  INITIAL: "Innmelding",
  RECURRING: "Fornyelse",
};
// The day is usually enough to tell payments apart — but two joins on the same
// day are exactly the case this is here for (staging, 27.8.2026: two agreements
// 72 minutes apart). When a day is shared, the clock is what separates them, so
// it is shown only then and the common case stays quiet.
const paymentsPerDay = new Map<string, number>();
for (const payment of payments) {
  const day = payment.on.slice(0, 10);
  paymentsPerDay.set(day, (paymentsPerDay.get(day) ?? 0) + 1);
}
const whenLabel = (iso: string) =>
  (paymentsPerDay.get(iso.slice(0, 10)) ?? 0) > 1
    ? new Date(iso).toLocaleString("nb-NO", { dateStyle: "short", timeStyle: "short" })
    : new Date(iso).toLocaleDateString("nb-NO");
// A period paid for twice keeps standing on the payment that was not given
// back, so the confirmation must not promise that the year disappears when
// another payment still covers it.
const periodSurvives =
  confirming !== null &&
  payments.some(
    (payment) =>
      payment.chargeId !== confirming.chargeId &&
      payment.periodYear === confirming.periodYear &&
      (payment.state === "paid" || payment.state === "partly-refunded"),
  );
---

<Subpage backHref={membersPath} backLabel="Tilbake til medlemslisten">
  <Stack gap="sm">
    <Heading level={2}>{displayName}</Heading>
    <Text variant="lead">{lead}</Text>
  </Stack>

  {saved && <Alert variant="success">Kontaktopplysningene er oppdatert.</Alert>}

  {
    refunded && (
      <Alert variant="success">
        {refunded.refundedNok} kr er refundert.{" "}
        {refunded.arrangementEnded
          ? "Den årlige avtalen er avsluttet, så det trekkes ingen flere betalinger."
          : "Den årlige avtalen var allerede avsluttet, så det trekkes ingen flere betalinger."}
      </Alert>
    )
  }
  {refundError && <Alert variant="error">{refundError}</Alert>}

  {
    /* Money leaving is irreversible, so it is never one click away: the button
       in the list opens this, and only this can send the refund. */
    confirming && (
      <section class="confirm">
        <Heading level={3}>
          Refundere {confirming.amountNok} kr — {typeWord[confirming.type].toLowerCase()}{" "}
          {whenLabel(confirming.on)}?
        </Heading>
        <Text>
          Hele beløpet går tilbake til {displayName}.{" "}
          {periodSurvives
            ? `${periodLabel(confirming.periodYear)} er betalt en gang til, så perioden teller fortsatt. `
            : `${periodLabel(confirming.periodYear)} teller da ikke lenger som en støttet periode. `}
          {renewing
            ? "Den årlige avtalen avsluttes, så det trekkes ingen flere betalinger."
            : "Den årlige avtalen er allerede avsluttet."}
        </Text>
        <Text variant="small">
          Pengene er hos medlemmet i løpet av noen dager. Vi refunderer aldri deler av et beløp —
          skal dere avtale noe annet, ta det direkte med medlemmet.
        </Text>
        <form method="post">
          <input type="hidden" name="refunder" value={confirming.chargeId} />
          <Stack gap="sm">
            <Button variant="danger">Refunder {confirming.amountNok} kr</Button>
            <Text variant="small">
              <TextLink href={memberPath}>Avbryt</TextLink>
            </Text>
          </Stack>
        </form>
      </section>
    )
  }

  <div class="columns">
    <section class="section">
      <div class="section-head">
        <Heading level={3}>Kontaktopplysninger</Heading>
        {
          !editing && (
            <Button variant="secondary" href={`${memberPath}?rediger=1`}>
              Endre
            </Button>
          )
        }
      </div>
      <Text variant="small">
        Hentet fra Vipps-profilen da medlemmet meldte seg inn. Rett dem gjerne — det endrer
        ingenting ved hva som er betalt.
      </Text>
      {
        editing ? (
          <form method="post">
            <Stack gap="md">
              <TextField label="Navn" name="name" value={values.name} error={fieldErrors.name} />
              <TextField
                label="E-post"
                name="email"
                type="email"
                value={values.email}
                error={fieldErrors.email}
              />
              <TextField
                label="Telefon"
                name="phone"
                type="tel"
                value={values.phone}
                error={fieldErrors.phone}
              />
              <Button block>Lagre</Button>
              <Text variant="small">
                <TextLink href={memberPath}>Avbryt</TextLink>
              </Text>
            </Stack>
          </form>
        ) : (
          <InfoList
            items={[
              { label: "Navn", value: member.name },
              { label: "E-post", value: member.email },
              { label: "Telefon", value: member.phone },
            ]}
          />
        )
      }
    </section>

    <section class="section">
      <Heading level={3}>Støttehistorikk</Heading>
      {
        history.length === 0 ? (
          <Text variant="muted">Ingen perioder er betalt ennå.</Text>
        ) : (
          <>
            <HeartRows count={history.length} />
            <Text variant="small">
              {[
                history.length === 1 ? "Én periode" : `${history.length} perioder`,
                `til sammen ${totalPaid} kr`,
                // Recruiting is the other half of the scorecard
                // (specs/concepts/scorecard.md), and the half an organization
                // can only thank someone for if it can see it.
                entry.recruits > 0
                  ? `har vervet ${entry.recruits} ${entry.recruits === 1 ? "medlem" : "medlemmer"}`
                  : null,
              ]
                .filter(Boolean)
                .join(" · ")}
            </Text>
            <ul class="history">
              {history.map((period) => (
                <li>
                  <span class="year">{periodLabel(period.periodYear)}</span>
                  <span class="tier">{period.tierName}</span>
                  <span class="paid">{period.paidNok} kr</span>
                </li>
              ))}
            </ul>
          </>
        )
      }
    </section>

    <section class="section payments-section">
      <Heading level={3}>Betalinger</Heading>
      {
        payments.length === 0 ? (
          <Text variant="muted">Ingen betalinger er forsøkt ennå.</Text>
        ) : (
          <>
            <Text variant="small">
              Pengene bak historikken. Refunderer dere en betaling, går hele beløpet tilbake,
              perioden slutter å telle, og den årlige avtalen avsluttes.
            </Text>
            <ul class="payments">
              {payments.map((payment) => (
                <li>
                  <span class="year">{periodLabel(payment.periodYear)}</span>
                  <span class="tier">
                    {typeWord[payment.type]} {whenLabel(payment.on)}
                  </span>
                  <span class="state">{paymentWord[payment.state]}</span>
                  <span class="paid">{payment.amountNok} kr</span>
                  <span class="act">
                    {payment.refusal ? (
                      <Text variant="muted">{refusalWord[payment.refusal]}</Text>
                    ) : (
                      <Button variant="secondary" href={`${memberPath}?refunder=${payment.chargeId}`}>
                        Refunder
                      </Button>
                    )}
                  </span>
                </li>
              ))}
            </ul>
          </>
        )
      }
    </section>
  </div>

</Subpage>

<style>
  /* Details and history stand side by side once the display has room. */
  .columns {
    display: grid;
    gap: var(--sm-space-lg);
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    align-items: start;
  }
  .section {
    display: grid;
    gap: var(--sm-space-sm);
    align-content: start;
  }
  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sm-space-sm);
  }
  .history,
  .payments {
    list-style: none;
    margin: 0;
    padding: 0.9rem 1rem;
    display: grid;
    gap: 0.6rem;
    background: var(--sm-bg);
    border: 1px solid var(--sm-border);
    border-radius: var(--sm-radius-md);
  }
  .history li,
  .payments li {
    display: flex;
    align-items: baseline;
    gap: var(--sm-space-sm);
  }
  /* The payments run the full width beneath both columns: their rows carry an
     action, and an action needs room to sit at the end of what it acts on. */
  .payments-section {
    grid-column: 1 / -1;
  }
  /* The refund sits at the end of its own row, and wraps under it rather than
     squeezing the amount when there is no room. */
  .payments li {
    flex-wrap: wrap;
    align-items: center;
    row-gap: 0.4rem;
  }
  .act {
    display: flex;
    justify-content: flex-end;
  }
  /* Confirming a refund is a step of its own, not a line in a list. */
  .confirm {
    display: grid;
    gap: var(--sm-space-sm);
    padding: var(--sm-space-md);
    background: var(--sm-danger-bg);
    border: 1px solid var(--sm-danger-border);
    border-radius: var(--sm-radius-md);
  }
  /* The button is as wide as its words, not as wide as the warning it sits in. */
  .confirm form {
    justify-self: start;
  }
  .year {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .tier {
    color: var(--sm-muted);
    overflow-wrap: anywhere;
  }
  .paid {
    margin-left: auto;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  /* What became of the payment sits with its amount, not with what it was for. */
  .state {
    margin-left: auto;
    color: var(--sm-muted);
    white-space: nowrap;
  }
  .state + .paid {
    margin-left: 0;
  }
</style>
