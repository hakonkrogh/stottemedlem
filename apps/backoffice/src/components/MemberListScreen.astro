---
// The member list (specs/use-cases/curate-member-list.md) — the one thing the
// product exists to give an organization. Everything shown is derived: a member
// is current because this year's fee was paid, never because somebody said so,
// and this screen offers no way to change that.
//
// The list PRESENTS members; correcting one is an action on that member's own
// page, never a field in the list.
import { periodLabel } from "@stottemedlem/core";
import { countMembersByStatus, type MemberOverview, matchesMemberSearch } from "@stottemedlem/db";
import Button from "@stottemedlem/ui/components/Button.astro";
import Heading from "@stottemedlem/ui/components/Heading.astro";
import Stack from "@stottemedlem/ui/components/Stack.astro";
import Text from "@stottemedlem/ui/components/Text.astro";
import TextField from "@stottemedlem/ui/components/TextField.astro";
import TextLink from "@stottemedlem/ui/components/TextLink.astro";
import MemberRow from "./MemberRow.astro";

interface Props {
  members: MemberOverview[];
  /** What the administrator typed; filtering happens here so counts don't move. */
  search?: string;
  membersPath: string;
  /**
   * The CSV download (specs/use-cases/export-member-list.md) — the register is
   * the organization's own data, and a spreadsheet is how they take it with
   * them into whatever tool they manage members in.
   */
  exportHref?: string;
  currentYear: number;
}
const { members, search = "", membersPath, exportHref, currentYear } = Astro.props;

const { active, lapsed } = countMembersByStatus(members);
const shown = members.filter((entry) => matchesMemberSearch(entry, search));
const summary =
  members.length === 0
    ? "Ingen støttemedlemmer ennå. Den første dukker opp her av seg selv når noen melder seg inn."
    : `${active} ${active === 1 ? "aktivt medlem" : "aktive medlemmer"} i ${periodLabel(currentYear)}` +
      (lapsed > 0 ? `, ${lapsed} utløpt.` : ".");
---

<Stack gap="lg">
  <div class="head">
    <Stack gap="sm">
      <Heading level={2}>Medlemmer</Heading>
      <Text variant="lead">{summary}</Text>
    </Stack>
    {
      exportHref && members.length > 0 && (
        <Button variant="secondary" href={exportHref}>
          Last ned som regneark (CSV)
        </Button>
      )
    }
  </div>

  {
    members.length > 0 && (
      <form method="get" class="search">
        <TextField
          label="Finn et medlem"
          name="sok"
          type="search"
          value={search}
          placeholder="Navn, e-post eller telefon"
        >
          <Button slot="action" variant="secondary">
            Søk
          </Button>
        </TextField>
      </form>
    )
  }

  {
    search && shown.length === 0 && (
      <Text variant="muted">
        Ingen medlemmer passer «{search}». <TextLink href={membersPath}>Vis alle</TextLink>
      </Text>
    )
  }

  {
    shown.length > 0 && (
      <div class="rows">
        {shown.map((entry) => (
          <MemberRow entry={entry} href={`${membersPath}/${entry.member.id}`} />
        ))}
      </div>
    )
  }
</Stack>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--sm-space-sm) var(--sm-space-md);
  }
  /* The search field carries its own button (TextField's action slot). */
  .search {
    max-width: 34rem;
  }
  /* One member per row on a phone; several columns when the display allows. */
  .rows {
    display: grid;
    gap: var(--sm-space-sm);
    grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr));
  }
</style>
