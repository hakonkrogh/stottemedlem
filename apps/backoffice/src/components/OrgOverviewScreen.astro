---
// The front tab of an organization's back office: how it is doing and the
// public addresses it shares, plus anything that is not yet in order, each
// with the one place it is put right
// (specs/use-cases/set-up-supporting-membership.md).
//
// The numbers come first (specs/concepts/organization-figures.md): what a year
// of support is worth, who stands behind it, and what this period did to both.
// An administrator comes back a few times a year, and that is the first thing
// they came to see.
//
// The membership offer is deliberately NOT shown here: it has a tab of its
// own, reachable from every screen, and repeating it cost the front page the
// room its figures need. Nothing is edited here either.
import type { OrganizationStats } from "@stottemedlem/db";
import Alert from "@stottemedlem/ui/components/Alert.astro";
import Heading from "@stottemedlem/ui/components/Heading.astro";
import Stack from "@stottemedlem/ui/components/Stack.astro";
import Text from "@stottemedlem/ui/components/Text.astro";
import TextLink from "@stottemedlem/ui/components/TextLink.astro";
import type { OrgWarning } from "../lib/orgWarnings";
import OrgStats from "./OrgStats.astro";
import OrgWarnings from "./OrgWarnings.astro";

interface Props {
  orgPath: string;
  joinUrl: string;
  termsUrl: string;
  qrCardUrl: string;
  warnings?: OrgWarning[];
  /** The organization in numbers. */
  stats: OrganizationStats;
  /** The period running now, as the organization would say it ("2026"). */
  periodLabel: string;
  /** Set after a price change: who was told, and who the org must tell itself. */
  feeNotice?: { told: number; unreached: number };
}
const {
  orgPath,
  joinUrl,
  termsUrl,
  qrCardUrl,
  warnings = [],
  stats,
  periodLabel,
  feeNotice,
} = Astro.props;

const links = [
  {
    label: "Innmeldingslenke",
    url: joinUrl,
    hint: "Del denne. Den er «nettsted» i Vipps-bestillingen.",
  },
  {
    label: "Salgsvilkår",
    url: termsUrl,
    hint: "Denne limer du inn som «salgsvilkår» i Vipps-bestillingen.",
  },
  {
    label: "QR-kode",
    url: qrCardUrl,
    hint: "Kortet du kan henge opp eller legge på nettsidene deres.",
  },
];
---

<Stack gap="lg">
  {
    feeNotice && (
      <Alert variant={feeNotice.unreached > 0 ? "info" : "success"}>
        {feeNotice.told === 0
          ? "Ingen medlemmer trengte varsel om den nye prisen."
          : `${feeNotice.told} støttemedlem${feeNotice.told === 1 ? "" : "mer"} har fått e-post om den nye prisen.`}
        {feeNotice.unreached > 0 && (
          <>
            {" "}
            {feeNotice.unreached} nådde vi ikke fram til — de blir stående på prisen de kjenner til
            dere får sagt fra. <TextLink href={`${orgPath}/medlemmer`}>Se medlemslisten</TextLink>
          </>
        )}
      </Alert>
    )
  }

  <OrgWarnings warnings={warnings} />

  <OrgStats stats={stats} periodLabel={periodLabel} />

  <Stack gap="sm">
    <Heading level={2}>Offentlige lenker</Heading>
    <Text variant="small">
      Innmeldingslenken er organisasjonens ene offentlige adresse — den du deler, og den QR-koden
      peker på.
    </Text>
    <div class="links">
      {
        links.map((link) => (
          <div class="link">
            <span class="label">{link.label}</span>
            <TextLink href={link.url}>{link.url}</TextLink>
            <span class="hint">{link.hint}</span>
          </div>
        ))
      }
    </div>
  </Stack>
</Stack>

<style>
  /* One column on a phone; side by side as soon as there is room for it. */
  .links {
    display: grid;
    gap: var(--sm-space-md);
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
  }
  .link {
    display: grid;
    gap: 0.15rem;
    align-content: start;
    min-width: 0;
  }
  .link :global(a) {
    overflow-wrap: anywhere;
    font-size: 0.9rem;
  }
  .label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--sm-muted);
  }
  .hint {
    font-size: 0.85rem;
    color: var(--sm-muted);
  }
</style>
