---
// The front tab of an organization's back office: how it is doing, the QR
// code card it shares (shown as the picture it is rather than as an address),
// plus anything that is not yet in order, each with the one place it is put
// right (specs/use-cases/set-up-supporting-membership.md).
//
// The public addresses themselves (the join page and the sales terms) are NOT
// listed here any more: the way to the public page sits in the chrome above
// every screen, and the addresses to paste into a form live under
// Innstillinger with the rest of what the organization has been given.
//
// The numbers come first (specs/concepts/organization-figures.md): what a year
// of support is worth, who stands behind it, and what this period did to both.
// An administrator comes back a few times a year, and that is the first thing
// they came to see.
//
// The membership offer is deliberately NOT shown here: it has a tab of its
// own, reachable from every screen, and repeating it cost the front page the
// room its figures need. Nothing is edited here either.
import type { OrganizationStats } from "@stottemedlem/db";
import Alert from "@stottemedlem/ui/components/Alert.astro";
import Stack from "@stottemedlem/ui/components/Stack.astro";
import TextLink from "@stottemedlem/ui/components/TextLink.astro";
import { type OrgWarning, readyForMembers, setupSteps } from "../lib/orgWarnings";
import OrgQrCard from "./OrgQrCard.astro";
import OrgStats from "./OrgStats.astro";
import OrgWarnings from "./OrgWarnings.astro";
import SetupGuide from "./SetupGuide.astro";

interface Props {
  orgPath: string;
  /** The organization's own name, for the QR card's alt text. */
  orgName: string;
  qrCardUrl: string;
  /** The organization's public join page, which a ready organization shares. */
  joinUrl: string;
  /** What the QR card picture loads; see OrgQrCard. Stories pass it inline. */
  qrCardPreviewSrc?: string;
  warnings?: OrgWarning[];
  /** The organization in numbers. */
  stats: OrganizationStats;
  /** The period running now, as the organization would say it ("2026"). */
  periodLabel: string;
  /** Set after a price change: who was told, and who the org must tell itself. */
  feeNotice?: { told: number; unreached: number };
}
const {
  orgPath,
  orgName,
  qrCardUrl,
  joinUrl,
  qrCardPreviewSrc,
  warnings = [],
  stats,
  periodLabel,
  feeNotice,
} = Astro.props;

// A new organization is guided step by step until supporters can join and pay
// (specs/use-cases/set-up-supporting-membership.md). Then the guide gives way
// to the plain warnings, and to one line saying it is ready, which stays until
// the first supporter arrives.
const ready = readyForMembers(warnings);
const nobodyYet = stats.activeMembers === 0 && stats.lapsedMembers === 0;
---

<Stack gap="lg">
  {
    feeNotice && (
      <Alert variant={feeNotice.unreached > 0 ? "info" : "success"}>
        {feeNotice.told === 0
          ? "Ingen medlemmer trengte varsel om den nye prisen."
          : `${feeNotice.told} støttemedlem${feeNotice.told === 1 ? "" : "mer"} har fått e-post om den nye prisen.`}
        {feeNotice.unreached > 0 && (
          <>
            {" "}
            {feeNotice.unreached} nådde vi ikke fram til — de blir stående på prisen de kjenner til
            dere får sagt fra. <TextLink href={`${orgPath}/medlemmer`}>Se medlemslisten</TextLink>
          </>
        )}
      </Alert>
    )
  }

  {
    ready ? (
      <>
        {nobodyYet && (
          <Alert variant="success">
            Alt er klart: støttemedlemmer kan melde seg inn og betale med Vipps. Del{" "}
            <TextLink href={joinUrl}>innmeldingssiden</TextLink> og QR-kortet under, så er dere i
            gang.
          </Alert>
        )}
        <OrgWarnings warnings={warnings} />
      </>
    ) : (
      <SetupGuide steps={setupSteps(warnings)} orgPath={orgPath} />
    )
  }

  <OrgStats stats={stats} periodLabel={periodLabel} />

  <OrgQrCard cardUrl={qrCardUrl} previewSrc={qrCardPreviewSrc} orgName={orgName} />
</Stack>
