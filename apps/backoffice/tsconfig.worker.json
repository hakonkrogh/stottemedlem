{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": [],
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  // Run `wrangler types` first (the typecheck script does) — it generates
  // worker-configuration.d.ts with the Env interface + Workers runtime types.
  "include": ["src/worker.ts", "worker-configuration.d.ts"]
}
